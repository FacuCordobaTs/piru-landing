---
import Escena from './Escena.astro'
import Icon from '../ui/Icon.astro'
import type { NombreIcono } from '../ui/lucide'
import { CLIENTA, LOCAL } from '../../data/demo'
import { pesos } from '../../data/oferta'

/**
 * Un pedido cobrado suma puntos en el club y Martina se acerca al próximo premio. Ejemplo con la
 * regla por defecto del club: 1 punto cada $100 del pedido. Es la escena ClubPuntos de la guía de
 * Marketing del panel.
 */
const PEDIDO = 13500
const PESOS_POR_PUNTO = 100
const SUMA = Math.floor(PEDIDO / PESOS_POR_PUNTO)
const SALDO = CLIENTA.puntos
const ANTES = SALDO - SUMA
const TOPE = 1000
const PREMIOS: { icono: NombreIcono; nombre: string; puntos: number }[] = [
  { icono: 'truck', nombre: 'Envío gratis', puntos: 300 },
  { icono: 'badge-percent', nombre: '10% OFF', puntos: 500 },
  { icono: 'gift', nombre: 'Smash gratis', puntos: 1000 },
]
const RUTA = 'M 112 238 C 170 262, 250 168, 318 112'
const enteros = (n: number) => n.toLocaleString('es-AR')
---

<Escena
  ancho={460}
  alto={300}
  etiqueta={`Un pedido cobrado de ${pesos(PEDIDO)} le suma ${SUMA} puntos a ${CLIENTA.nombre}, que llega a ${enteros(SALDO)} puntos: ya puede canjear el envío gratis o el descuento, y le faltan ${TOPE - SALDO} para la Smash gratis.`}
>
  <div class="e-izquierda e-tarjeta absolute left-[18px] top-[28px] w-[178px] p-4">
    <p class="text-[13px] font-semibold text-ink">Pedido #1302</p>
    <p class="text-[11px] text-ink-3">{CLIENTA.nombre}</p>
    <div class="my-3 border-t border-dashed border-line" />
    <div class="flex justify-between gap-2 text-[11.5px] text-ink-2"><span>1 × Smash doble</span><span class="tabular-nums">{pesos(PEDIDO)}</span></div>
    <div class="my-3 border-t border-dashed border-line" />
    <div class="flex items-baseline justify-between">
      <span class="text-[12px] font-semibold text-ink">Total</span>
      <span class="text-[15px] font-bold tabular-nums text-ink">{pesos(PEDIDO)}</span>
    </div>
    <span class="e-pop mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10.5px] font-semibold text-emerald-700" style="--d:500ms"><Icon name="check" class="size-[11px]" stroke={3} />Cobrado</span>
    <p class="e-sube mt-3 rounded-xl bg-brand-soft px-2.5 py-2 text-[11.5px] font-semibold text-brand-deep" style="--d:800ms">Suma +{SUMA} puntos</p>
  </div>

  <span class="e-vuela absolute left-0 top-0 rounded-full bg-brand px-2.5 py-1 text-[11.5px] font-bold text-white shadow-[0_8px_18px_-6px_rgb(255_122_0/.8)]" style={`--d:1050ms;--ruta:path("${RUTA}")`}>+{SUMA}</span>

  <div class="e-derecha e-tarjeta absolute left-[216px] top-[28px] w-[226px] p-4" style="--d:300ms">
    <p class="text-[10px] font-semibold uppercase tracking-[.08em] text-ink-3">Club {LOCAL.nombre}</p>
    <p class="text-[12.5px] font-semibold text-ink">{CLIENTA.nombre}</p>
    <p class="mt-2 flex items-baseline gap-1.5">
      <span class="text-[34px] font-bold leading-none tracking-tight tabular-nums text-ink" data-contar={SALDO} data-desde={ANTES} data-ms="1300" data-retraso="1700">{enteros(SALDO)}</span>
      <span class="text-[12px] font-medium text-ink-3">puntos</span>
    </p>
    <div class="relative mt-3 h-2 rounded-full bg-line/80">
      <div class="e-crece h-full rounded-full bg-brand" style={`width:${(SALDO / TOPE) * 100}%;--desde:${ANTES / SALDO};--d:1700ms`} />
      {PREMIOS.slice(0, 2).map((p) => (
        <span class="absolute top-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white ring-2 ring-brand-deep" style={`left:${(p.puntos / TOPE) * 100}%`} />
      ))}
    </div>
    <div class="mt-3.5 grid gap-2">
      {PREMIOS.map((p, i) => {
        const alcanzado = SALDO >= p.puntos
        return (
          <div class="e-sube flex items-center gap-2 text-[11.5px]" style={`--d:${600 + i * 120}ms`}>
            <span class:list={['grid size-6 place-items-center rounded-lg', alcanzado ? 'bg-brand-soft text-brand-deep' : 'bg-sand text-ink-3']}><Icon name={p.icono} class="size-[13px]" /></span>
            <span class="flex-1 font-medium text-ink">{p.nombre}</span>
            {alcanzado ? (
              <span class="flex items-center gap-1 font-semibold text-emerald-700"><Icon name="check" class="size-3" stroke={3} />{enteros(p.puntos)}</span>
            ) : (
              <span class="tabular-nums text-ink-3">faltan <span data-contar={p.puntos - SALDO} data-desde={p.puntos - ANTES} data-ms="1300" data-retraso="1700">{enteros(p.puntos - SALDO)}</span></span>
            )}
          </div>
        )
      })}
    </div>
  </div>

  <p class="e-aparece absolute left-[18px] top-[272px] text-[10.5px] text-ink-3" style="--d:1400ms">Ejemplo: 1 punto cada {pesos(PESOS_POR_PUNTO)} · se acreditan cuando el pedido se cobra</p>
</Escena>
