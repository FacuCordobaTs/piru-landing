---
// Piru — La experiencia en el celular. Pantalla dedicada al storefront móvil.
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>La experiencia en el celular — Piru</title>
<meta name="description" content="Mirá cómo tus comensales eligen, personalizan y pagan en menos de 90 segundos desde su propio navegador, sin descargar aplicaciones.">
<link rel="icon" type="image/jpeg" href="/piru/logo.jpg">
<link rel="apple-touch-icon" href="/piru/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --ink: #17130f;
  --ink-soft: #3d2f23;
  --ink-subtle: #675848;
  --paper: #fbf4ea;
  --paper-2: #f4e9d9;
  --paper-card: #ffffff;
  --orange: #ff8a00;
  --orange-deep: #e67500;
  --orange-light: #fff2e0;
  --green: #10b981;
  --line: #e7dac7;
  --line-strong: #d2c0a8;
  --muted: #8a7866;
  --maxw-wide: 1060px;
  --ease: cubic-bezier(.22, .61, .36, 1);
  --shadow-sm: 0 4px 14px -3px rgba(40, 20, 0, 0.08);
  --shadow-md: 0 16px 36px -12px rgba(40, 20, 0, 0.12);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.7;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: 'Fraunces', Georgia, serif;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 0;
}

p { margin: 0 0 1.4em; }
p:last-child { margin-bottom: 0; }
a { color: inherit; text-decoration: none; }

.wrap { max-width: var(--maxw-wide); margin: 0 auto; padding: 0 24px; }

/* Botones con micro-animaciones */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6em;
  font-weight: 600;
  font-size: 15.5px;
  border-radius: 999px;
  padding: 13px 26px;
  cursor: pointer;
  border: 0;
  font-family: inherit;
  position: relative;
  overflow: hidden;
  transition: transform .2s var(--ease), box-shadow .25s var(--ease), background .25s, color .25s, border-color .25s;
  user-select: none;
}
.btn:active {
  transform: scale(0.97) translateY(1px);
}
.btn-primary {
  background: var(--orange);
  color: #fff;
  box-shadow: 0 10px 28px -10px rgba(255, 138, 0, 0.7);
}
.btn-primary:hover {
  background: var(--orange-deep);
  transform: translateY(-2px);
  box-shadow: 0 16px 36px -10px rgba(255, 138, 0, 0.85);
}
.btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 1.5px solid var(--line-strong);
}
.btn-ghost:hover {
  border-color: var(--ink);
  background: rgba(0, 0, 0, 0.03);
  transform: translateY(-2px);
}
.btn-sm {
  padding: 8px 18px;
  font-size: 14px;
}

.btn .sh {
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.4) 50%, transparent 70%);
  transform: translateX(-120%);
  pointer-events: none;
}
.btn:hover .sh {
  transform: translateX(120%);
  transition: transform 0.75s var(--ease);
}

/* Nav */
nav {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 60;
  backdrop-filter: blur(14px);
  background: rgba(251, 244, 234, 0.88);
  border-bottom: 1px solid var(--line);
}
.nav-in {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Fraunces', serif;
  font-weight: 700;
  font-size: 23px;
  letter-spacing: -0.02em;
}
.brand img {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  display: block;
}
.nav-links {
  display: flex;
  gap: 24px;
  align-items: center;
}
.nav-links a {
  font-size: 14.5px;
  font-weight: 500;
  color: var(--ink-soft);
  transition: color .2s;
}
.nav-links a:hover {
  color: var(--orange-deep);
}
.nav-cta {
  display: flex;
  align-items: center;
  gap: 12px;
}

@media(max-width: 768px) {
  .nav-links { display: none; }
}

/* Header */
.exp-header {
  padding: 130px 0 36px;
  text-align: center;
}
.exp-header .tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--paper-2);
  border: 1px solid var(--line);
  padding: 5px 15px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 18px;
}
.exp-header .tag span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--orange);
}
.exp-header h1 {
  font-size: clamp(36px, 5vw, 56px);
  max-width: 22ch;
  margin: 0 auto 16px;
}
.exp-header .lead {
  font-size: clamp(17px, 1.9vw, 20px);
  color: var(--ink-soft);
  max-width: 44ch;
  margin: 0 auto 28px;
  line-height: 1.55;
}

/* Selector de modo claro / oscuro */
.toggle-wrapper {
  display: flex;
  justify-content: center;
  margin: 10px 0 48px;
}
.toggle {
  display: inline-flex;
  background: var(--paper-2);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px;
  gap: 2px;
}
.toggle button {
  border: 0;
  background: transparent;
  font-family: inherit;
  font-weight: 600;
  font-size: 14px;
  color: var(--muted);
  padding: 8px 22px;
  border-radius: 999px;
  cursor: pointer;
  transition: .2s var(--ease);
}
.toggle button.active {
  background: var(--ink);
  color: #fff;
}
.toggle button.active.lightmode {
  background: var(--orange);
  color: #fff;
}

/* Showcase vertical de los 4 pasos */
.flow-container {
  display: flex;
  flex-direction: column;
  gap: 72px;
  margin-bottom: 80px;
}
.flow-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}
.flow-row.rev .phone-side { order: 2; }
.phone-side {
  display: flex;
  justify-content: center;
}
.phone-mockup {
  width: 270px;
  border-radius: 40px;
  background: #0e0c17;
  padding: 10px;
  box-shadow: 0 30px 64px -20px rgba(40, 20, 0, 0.4), 0 0 0 1px rgba(0,0,0,0.08);
  transition: transform .4s var(--ease);
}
.phone-mockup:hover {
  transform: translateY(-4px) rotate(-1deg);
}
.phone-mockup img {
  display: block;
  width: 100%;
  border-radius: 31px;
}
.text-side {
  max-width: 38ch;
}
.step-num {
  font-family: 'Fraunces', serif;
  font-size: 42px;
  font-weight: 600;
  color: var(--orange);
  line-height: 1;
}
.text-side h2 {
  font-size: clamp(24px, 3.2vw, 32px);
  margin: 8px 0 12px;
}
.text-side p {
  font-size: 16.5px;
  color: var(--ink-soft);
  line-height: 1.6;
}

@media(max-width: 820px) {
  .flow-row {
    grid-template-columns: 1fr;
    gap: 30px;
    text-align: center;
  }
  .flow-row.rev .phone-side { order: 0; }
  .text-side { margin: 0 auto; }
}

/* Callout para probar la demo */
.demo-callout {
  background: #fff;
  border: 1.5px solid var(--orange);
  border-radius: 26px;
  padding: 44px 34px;
  text-align: center;
  box-shadow: 0 20px 50px -20px rgba(255, 138, 0, 0.35);
  margin-bottom: 70px;
}
.demo-callout h3 {
  font-size: clamp(24px, 3.2vw, 32px);
  margin-bottom: 12px;
}
.demo-callout p {
  font-size: 16px;
  color: var(--ink-soft);
  max-width: 48ch;
  margin: 0 auto 24px;
}
.demo-callout .btn-group {
  display: flex;
  gap: 14px;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

/* Footer */
footer {
  background: #ff7200;
  color: #fff;
  padding: 48px 24px 40px;
}
.foot-in {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  align-items: center;
}
.foot-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-family: 'Fraunces', serif;
  font-weight: 700;
  font-size: 21px;
}
.foot-brand img { width: 32px; height: 32px; }
.foot-links {
  display: flex;
  gap: 22px;
  font-size: 14px;
  flex-wrap: wrap;
}
.foot-links a { color: rgba(255, 255, 255, 0.92); }
.foot-links a:hover { color: #0a0a0a; }
.foot-fine {
  margin-top: 22px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
  border-top: 1px solid rgba(255, 255, 255, 0.28);
  padding-top: 16px;
}
</style>
</head>

<body>
<!-- NAVIGATION -->
<nav>
  <div class="wrap nav-in">
    <a class="brand" href="/">
      <img id="navlogo" alt="Piru">
      Piru
    </a>
    <div class="nav-links">
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#pedido-en-grupo">Pedido en grupo</a>
      <a href="/#precio">Precios</a>
      <a href="/#transicion">Transición</a>
    </div>
    <div class="nav-cta">
      <a class="btn btn-ghost btn-sm" href="/">
        ← Volver al inicio
      </a>
      <a class="btn btn-primary btn-sm" href="https://my.piru.app/prueba" target="_blank" rel="noopener">
        <span class="sh"></span>Probar demo en vivo
      </a>
    </div>
  </div>
</nav>

<header class="exp-header wrap">
  <div class="tag"><span></span> Navegación móvil nativa</div>
  <h1>La experiencia de tus clientes en el celular</h1>
  <p class="lead">
    Simple, veloz y sin trabas. Tus clientes eligen, personalizan su plato y pagan en segundos desde el navegador de su teléfono, sin instalar aplicaciones ni recordar contraseñas.
  </p>

  <div class="toggle-wrapper">
    <div class="toggle" id="toggle" role="group" aria-label="Modo de visualización">
      <button data-mode="dark" class="active">🌙 Modo Oscuro</button>
      <button data-mode="light">☀️ Modo Claro</button>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="flow-container">
    <!-- Paso 1 -->
    <div class="flow-row">
      <div class="phone-side">
        <div class="phone-mockup">
          <img data-shot="menu" alt="Menú y categorías en celular">
        </div>
      </div>
      <div class="text-side">
        <div class="step-num">01</div>
        <h2>Elegir del menú sin trabas</h2>
        <p>
          Fotos grandes, categorías claras, buscador veloz y diseño limpio con tu logo y tus propios colores. El comensal navega con fluidez natural sin publicidad molesta ni elementos que confundan.
        </p>
      </div>
    </div>

    <!-- Paso 2 -->
    <div class="flow-row rev">
      <div class="phone-side">
        <div class="phone-mockup">
          <img data-shot="options" alt="Armar el plato a gusto">
        </div>
      </div>
      <div class="text-side">
        <div class="step-num">02</div>
        <h2>Armar el plato a gusto</h2>
        <p>
          Variantes de tamaño, puntos de cocción, agregados o notas especiales para la cocina. Igual que si estuviera pidiendo en tu mostrador o mesa.
        </p>
      </div>
    </div>

    <!-- Paso 3 -->
    <div class="flow-row">
      <div class="phone-side">
        <div class="phone-mockup">
          <img data-shot="datos" alt="Checkout rápido en tres pasos">
        </div>
      </div>
      <div class="text-side">
        <div class="step-num">03</div>
        <h2>Datos mínimos en segundos</h2>
        <p>
          Nombre, teléfono de WhatsApp y dirección con validación automática de radio de entrega sobre el mapa. Sin exigir crear contraseñas ni verificar emails antes de comprar.
        </p>
      </div>
    </div>

    <!-- Paso 4 -->
    <div class="flow-row rev">
      <div class="phone-side">
        <div class="phone-mockup">
          <img data-shot="transfer" alt="Cobro directo y alias único">
        </div>
      </div>
      <div class="text-side">
        <div class="step-num">04</div>
        <h2>Cobro acreditado al instante</h2>
        <p>
          Tus comensales eligen cómo pagar: Mercado Pago (tarjetas o dinero en cuenta) o transferencias bancarias directas con un alias único que se concilia solo en tu panel, sin pedir comprobantes por WhatsApp.
        </p>
      </div>
    </div>
  </div>

  <!-- Callout interactivo para probar la demo -->
  <div class="demo-callout">
    <h3>¿Querés probar la experiencia vos mismo?</h3>
    <p>
      Entrá a la tienda de ejemplo de Piru desde tu celular o computadora. Podés armar un pedido de prueba y ver cómo funciona el flujo completo.
    </p>
    <div class="btn-group">
      <a class="btn btn-primary" href="https://my.piru.app/prueba" target="_blank" rel="noopener">
        <span class="sh"></span>Abrir tienda de demo interactiva ↗
      </a>
      <a class="btn btn-ghost" href="/#precio">
        Ver precios y suscripción
      </a>
    </div>
  </div>
</main>

<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div class="foot-in">
      <div class="foot-brand">
        <img id="footlogo" alt="Piru">
        Piru
      </div>
      <div class="foot-links">
        <a href="/">Inicio</a>
        <a href="/#como-funciona">Cómo funciona</a>
        <a href="/#pedido-en-grupo">Pedido en grupo</a>
        <a href="/#precio">Precios</a>
        <a href="/#transicion">Transición</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </div>
    </div>
    <div class="foot-fine">
      Piru — La tienda web que te consigue nuevos clientes, los fideliza y los recupera. Hecho en Argentina. © 2026
    </div>
  </div>
</footer>

<script is:inline>
window.PIRU = {
  "logo": "/piru/logo.jpg",
  "foxWhite": "/piru/fox-white.png",
  "menu_light": "/piru/menu-light.jpg",
  "menu_dark": "/piru/menu-dark.jpg",
  "options_light": "/piru/options-light.jpg",
  "options_dark": "/piru/options-dark.jpg",
  "datos_light": "/piru/datos-light.jpg",
  "datos_dark": "/piru/datos-dark.jpg",
  "transfer_light": "/piru/transfer-light.jpg",
  "transfer_dark": "/piru/transfer-dark.jpg"
};

(function(){
  var P = window.PIRU;
  var nl = document.getElementById('navlogo'); if(nl) nl.src = P.logo;
  var fl = document.getElementById('footlogo'); if(fl) fl.src = P.foxWhite;

  var mode = 'dark';
  function paintShots(){
    document.querySelectorAll('img[data-shot]').forEach(function(img){
      var k = img.getAttribute('data-shot') + '_' + mode;
      if(P[k]) img.src = P[k];
    });
  }
  paintShots();

  var tg = document.getElementById('toggle');
  if(tg){
    tg.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){
        mode = b.getAttribute('data-mode');
        tg.querySelectorAll('button').forEach(function(x){
          x.classList.remove('active', 'lightmode');
        });
        b.classList.add('active');
        if(mode === 'light') b.classList.add('lightmode');
        paintShots();
      });
    });
  }
})();
</script>
</body>
</html>
