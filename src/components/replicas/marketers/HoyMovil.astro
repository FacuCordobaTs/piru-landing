---
import Icon from '../../ui/Icon.astro'
import Monograma from './Monograma.astro'
import NavMovil from './NavMovil.astro'
import { CARTERA, HOY } from '../../../data/marketers'

/**
 * App de marketers → Hoy (docs/MVP_MARKETERS.md §4.5): los mensajes del día en modo manual. La guardia
 * del dispositivo va arriba: "Abrir WhatsApp" abre el WhatsApp de ESTE celular, así que la app sólo
 * lo ofrece si el dispositivo tiene el WhatsApp del local; si no, los manda el local desde su panel.
 */
const brasa = CARTERA[0]
const pendientes = HOY.total - HOY.enviados
---

<div class="relative h-full w-full overflow-hidden bg-paper pt-[54px] text-ink">
  <div class="flex h-11 items-center gap-2 px-4 text-[13px] font-medium text-ink-3">
    <Icon name="chevron-left" class="size-4" />
    <Monograma inicial={brasa.inicial} color={brasa.color} size={20} />
    {brasa.nombre}
  </div>

  <div class="px-5">
    <p class="text-[26px] font-bold leading-none tracking-[-0.035em]">Hoy</p>
    <p class="mt-1.5 text-[13px] text-ink-3">{HOY.fecha}</p>
    <div class="mt-3 flex items-center gap-3">
      <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-line"><span class="block h-full rounded-full bg-emerald-500" style={`width:${(HOY.enviados / HOY.total) * 100}%`} /></span>
      <span class="text-[12px] font-semibold tabular-nums text-ink-2">{HOY.enviados} de {HOY.total} enviados</span>
    </div>
  </div>

  <div class="mx-5 mt-3.5 flex items-center gap-2.5 rounded-2xl bg-emerald-500/[.08] px-3.5 py-2.5 ring-1 ring-emerald-600/15">
    <Icon name="smartphone" class="size-[18px] text-emerald-700" />
    <p class="flex-1 text-[12.5px] leading-snug text-emerald-900">Este celular tiene el <b class="font-semibold">WhatsApp de {brasa.nombre}</b></p>
    <span class="text-[12px] font-semibold text-emerald-700">Cambiar</span>
  </div>

  <div class="mt-3 space-y-2 px-5">
    {HOY.mensajes.map((m) => (
      <div class:list={['rounded-[18px] bg-white ring-1', m.abierto ? 'p-3.5 ring-ink/15 shadow-[0_10px_24px_-14px_rgb(40_24_8/.35)]' : 'px-3.5 py-3 ring-line']}>
        <div class="flex items-center gap-2.5">
          <span class:list={['grid size-9 shrink-0 place-items-center rounded-full text-[12px] font-bold', m.enviado ? 'bg-emerald-500/10 text-emerald-700' : 'bg-sand text-ink-2']}>{m.iniciales}</span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-[14px] font-semibold leading-tight">{m.nombre}</p>
            <p class="truncate text-[11.5px] text-ink-3">{m.motivo}</p>
          </div>
          {m.enviado && <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-700"><Icon name="check-check" class="size-3.5" />Enviado</span>}
        </div>

        {m.abierto && 'texto' in m && (
          <>
            <div class="mt-3 rounded-xl bg-[#EFEAE2] p-2.5">
              <div class="burbuja-sale max-w-[268px]">
                <div class="px-1.5 pb-0.5 pt-1 text-[12.5px] leading-[1.38] text-[#111b21]">
                  {m.texto.map((l, i) => <p class:list={[i > 0 && 'mt-1.5']}>{l}</p>)}
                  <p class="mt-1 truncate text-[#027EB5] underline decoration-[#027EB5]/40">{m.link}</p>
                </div>
              </div>
            </div>
            <div class="mt-3 grid grid-cols-[1fr_auto] gap-2">
              <span class="flex h-10 items-center justify-center gap-2 rounded-full bg-wa-deep text-[13px] font-semibold text-white"><Icon name="message-circle" class="size-4" />Abrir WhatsApp</span>
              <span class="flex h-10 items-center gap-1.5 rounded-full px-3.5 text-[13px] font-semibold ring-1 ring-line"><Icon name="check" class="size-4" />Enviado</span>
            </div>
          </>
        )}
      </div>
    ))}
  </div>

  <NavMovil modo="local" activo="hoy" hoy={pendientes} />
</div>
