---
// Piru — landing. Imagenes en public/piru/ (ver carpeta piru-public).
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Piru — Los pedidos se toman solos</title>
<link rel="icon" type="image/jpeg" href="/piru/logo.jpg">
<link rel="apple-touch-icon" href="/piru/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#17130f;
  --ink-soft:#3d2f23;
  --paper:#fbf4ea;
  --paper-2:#f4e9d9;
  --card:#ffffff;
  --orange:#ff8a00;
  --orange-deep:#e67500;
  --indigo:#2c2a63;
  --muted:#8a7866;
  --line:#e7dac7;
  --black:#0a0a0a;
  --black-2:#161616;
  --maxw:1180px;
  --ease:cubic-bezier(.22,.61,.36,1);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;font-weight:600;line-height:1.02;letter-spacing:-.015em;margin:0}
p{margin:0}
a{color:inherit;text-decoration:none}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-deep)}
.muted{color:var(--muted)}

/* scroll progress */
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--orange),#ff6a00);z-index:99;transition:width .08s linear}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.5em;font-weight:600;font-size:15px;border-radius:999px;padding:14px 24px;cursor:pointer;border:0;transition:transform .18s var(--ease),box-shadow .25s,background .25s,color .25s;font-family:inherit;position:relative;overflow:hidden}
.btn-primary{background:var(--orange);color:#fff;box-shadow:0 12px 34px -12px rgba(255,138,0,.75)}
.btn-primary:hover{background:var(--orange-deep);transform:translateY(-3px)}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--ink);transform:translateY(-3px)}
.btn .sh{position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-120%)}
.btn:hover .sh{transform:translateX(120%);transition:transform .7s var(--ease)}
.wa svg{width:18px;height:18px}
.wa-ghost svg{width:17px;height:17px;color:#25d366}

/* nav */
nav{position:fixed;inset:0 0 auto 0;z-index:50;backdrop-filter:blur(10px);background:rgba(251,244,234,.7);border-bottom:1px solid transparent;transition:border-color .3s,background .3s;animation:dropIn .6s var(--ease) both}
nav.scrolled{border-color:var(--line);background:rgba(251,244,234,.86)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-weight:700;font-size:22px;letter-spacing:-.02em}
.brand img{width:34px;height:34px;border-radius:9px;display:block;transition:transform .4s var(--ease)}
.brand:hover img{transform:rotate(-8deg) scale(1.06)}
.nav-links{display:flex;gap:30px;align-items:center}
.nav-links a{font-size:15px;font-weight:500;color:var(--ink-soft);position:relative}
.nav-links a:after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--orange);transition:width .3s var(--ease)}
.nav-links a:hover{color:var(--orange-deep)}
.nav-links a:hover:after{width:100%}
.nav-cta{display:flex;align-items:center;gap:10px}
@media(max-width:820px){.nav-links{display:none}}

/* mobile bottom nav (floating pill) */
.mnav{display:none}
@keyframes barUp{from{transform:translateY(140%);opacity:0}to{transform:none;opacity:1}}
@media(max-width:820px){
  nav{display:none}
  .mnav{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    position:fixed;left:14px;right:14px;bottom:14px;z-index:60;
    padding:7px 7px 7px 16px;
    background:rgba(251,244,234,.62);
    backdrop-filter:blur(20px) saturate(1.6);
    -webkit-backdrop-filter:blur(20px) saturate(1.6);
    border:1px solid rgba(255,255,255,.55);
    border-radius:999px;
    box-shadow:0 16px 44px -14px rgba(40,20,0,.4),inset 0 1px 0 rgba(255,255,255,.65);
    animation:barUp .6s .2s var(--ease) both;
  }
  .mnav-brand{display:flex;align-items:center;gap:9px;font-family:'Fraunces',serif;font-weight:700;font-size:19px;letter-spacing:-.02em;color:var(--ink)}
  .mnav-brand img{width:30px;height:30px;border-radius:8px;display:block}
  .mnav-actions{display:flex;align-items:center;gap:8px}
  .mnav-wa{width:42px;height:42px;flex:0 0 auto;border-radius:999px;display:grid;place-items:center;background:#fff;border:1px solid var(--line);color:#25d366}
  .mnav-wa svg{width:20px;height:20px}
  .mnav-wa:active{transform:scale(.94)}
  .mnav-btn{padding:11px 20px;font-size:14px}
}

/* hero */
.hero{position:relative;padding:132px 0 84px;overflow:hidden}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
.hero-text{position:relative}
.hero-text:before{content:"";position:absolute;top:-160px;left:-220px;width:720px;height:720px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.30),rgba(255,138,0,0) 62%);z-index:-1;pointer-events:none;animation:breathe 9s ease-in-out infinite}
.hero h1{font-size:clamp(46px,7.4vw,92px);font-weight:600}
.hero h1 em{font-style:italic;color:var(--orange-deep);font-weight:500}
.hero h1 .l2{display:block;color:var(--ink-soft)}
.hero-sub{font-size:clamp(17px,2vw,20px);color:var(--ink-soft);max-width:28em;margin:26px 0 32px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-note{font-size:14.5px;color:var(--muted);margin-top:16px}
.hero-note b{color:var(--orange-deep);font-weight:600}
.hero-text>*{opacity:0;animation:upIn .8s var(--ease) forwards}
.hero-text h1{animation-delay:.08s}
.hero-text .hero-sub{animation-delay:.24s}
.hero-text .hero-cta{animation-delay:.4s}
.hero-text .hero-note{animation-delay:.52s}
.hero-stage{opacity:0;animation:popIn 1s .2s var(--ease) forwards}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:26px}.hero{padding:110px 0 44px}}
@media(max-width:820px){.hero{padding:70px 0 44px}footer{padding-bottom:104px}}

/* phone */
.phone{position:relative;width:300px;border-radius:40px;background:#0d0a16;padding:10px;box-shadow:0 50px 90px -40px rgba(40,20,0,.55),0 0 0 1px rgba(0,0,0,.04)}
.phone img{display:block;width:100%;border-radius:31px}
.floaty{animation:floaty 6s ease-in-out infinite}
.phone-stage{position:relative;display:flex;justify-content:center}
.parallax{will-change:transform}
.chip{position:absolute;background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;box-shadow:0 18px 40px -18px rgba(40,20,0,.4);font-size:13px;font-weight:600;display:flex;align-items:center;gap:9px;z-index:3;white-space:nowrap;opacity:0;animation:chipIn .6s var(--ease) forwards}
.chip .dot{width:9px;height:9px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 0 rgba(255,138,0,.5);animation:ping 2.4s ease-out infinite}
.chip .ok{width:20px;height:20px;border-radius:50%;background:#19a974;color:#fff;display:grid;place-items:center;font-size:12px}
.chip small{display:block;font-weight:500;color:var(--muted);font-size:11px}
.chip.c1{top:38px;left:-46px;animation-delay:.8s}
.chip.c2{bottom:120px;right:-58px;animation-delay:1.1s}
.chip.c3{bottom:30px;left:-30px;animation-delay:1.4s}
@media(max-width:560px){.chip.c1{left:-12px}.chip.c2{right:-12px}.chip.c3{display:none}.phone{width:262px}}

/* trust band */
.band{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper-2)}
.band-in{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;padding:22px 24px}
.band-label{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600}
.store{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:16px;padding:9px 16px;border-radius:999px;border:1px solid var(--line);background:#fff;transition:transform .18s var(--ease),border-color .25s,box-shadow .25s}
.store:hover{transform:translateY(-3px);border-color:var(--orange);box-shadow:0 12px 26px -16px rgba(255,138,0,.6)}
.store .ig{width:16px;height:16px;opacity:.6}

/* sections */
.sec{padding:100px 0}
.sec-head{max-width:34ch}
.sec-head.center{margin:0 auto;text-align:center}
.sec-head h2{font-size:clamp(32px,4.6vw,54px);margin:14px 0 0}
.sec-head .lead{font-size:18px;color:var(--ink-soft);margin-top:16px}

/* dark relief */
.dark{background:var(--black);color:#ece7e1;position:relative;overflow:hidden}
.dark:before{content:"";position:absolute;width:760px;height:760px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.13),transparent 64%);top:-260px;right:-160px;z-index:0}
.fox-wm{position:absolute;pointer-events:none;opacity:.05;width:460px;z-index:0;bottom:-90px;left:-70px;transform:rotate(-8deg)}
.dark .wrap,.price .wrap{position:relative;z-index:1}
.dark .eyebrow{color:var(--orange)}
.dark .sec-head h2{color:#fff}
.relief{margin-top:46px;display:grid;gap:2px;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,.09)}
.relief div{display:flex;align-items:center;gap:18px;padding:26px 28px;background:var(--black-2);font-size:clamp(19px,2.4vw,26px);font-family:'Fraunces',serif;font-weight:500}
.relief div .x{flex:0 0 auto;width:30px;height:30px;border-radius:50%;border:1.5px solid var(--orange);color:var(--orange);display:grid;place-items:center;font-size:15px;font-family:'Inter'}
.relief-close{margin-top:32px;font-size:clamp(20px,2.6vw,30px);font-family:'Fraunces',serif;color:#fff;font-weight:500}
.relief-close b{color:var(--orange);font-weight:600}

/* toggle */
.toggle{display:inline-flex;background:var(--paper-2);border:1px solid var(--line);border-radius:999px;padding:4px;gap:2px;margin-top:24px}
.toggle button{border:0;background:transparent;font-family:inherit;font-weight:600;font-size:14px;color:var(--muted);padding:9px 20px;border-radius:999px;cursor:pointer;transition:.25s var(--ease);display:flex;align-items:center;gap:7px}
.toggle button.active{background:var(--ink);color:#fff}
.toggle button.active.lightmode{background:var(--orange);color:#fff}

/* flow (vertical showcase) */
.flow{display:flex;flex-direction:column;gap:96px;margin-top:70px}
.flow-row{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:center}
.flow-row.rev .flow-phone{order:2}
.flow-phone{display:flex;justify-content:center}
.flow-phone .phone{width:268px;transition:transform .5s var(--ease)}
.flow-phone .phone:hover{transform:translateY(-8px) rotate(-1.5deg)}
.flow-text{max-width:30ch}
.step-no{font-family:'Fraunces',serif;font-size:46px;font-weight:600;color:var(--orange);line-height:1}
.flow-text h3{font-size:clamp(26px,3.2vw,36px);margin:6px 0 12px}
.flow-text p{font-size:17px;color:var(--ink-soft)}
@media(max-width:880px){.flow-row{grid-template-columns:1fr;gap:24px}.flow-row.rev .flow-phone{order:0}.flow-text{margin:0 auto;text-align:center}}

/* split (amigos / alias) */
.split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.split.rev .split-text{order:2}
.split-text h2{font-size:clamp(30px,4vw,48px);margin-top:14px}
.split-text .lead{font-size:18px;color:var(--ink-soft);margin-top:16px;max-width:33ch}
.split-stage{display:flex;justify-content:center}
.split.amigos{background:linear-gradient(155deg,#34316f,#1d1b45);color:#fff;border-radius:34px;padding:60px;overflow:hidden;position:relative}
.split.amigos:before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.14),transparent 65%);top:-180px;left:-120px}
.split.amigos .eyebrow{color:#ffb454}
.split.amigos .split-text,.split.amigos .split-stage{position:relative;z-index:1}
.split.amigos .lead{color:#cfcde9}
.split.amigos .phone{box-shadow:0 50px 90px -36px rgba(0,0,0,.6)}
@media(max-width:880px){.split{grid-template-columns:1fr;gap:32px}.split.rev .split-text{order:0}.split.amigos{padding:40px 26px}}

/* features grid */
.feat-grid{margin-top:44px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.feat-grid div{background:var(--paper);padding:26px 22px;display:flex;flex-direction:column;gap:9px;min-height:118px;transition:background .25s}
.feat-grid div:hover{background:#fff}
.feat-grid .ic{width:26px;height:26px;color:var(--orange-deep)}
.feat-grid b{font-size:15.5px;font-weight:600}
.feat-grid span{font-size:13px;color:var(--muted)}
@media(max-width:860px){.feat-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.feat-grid{grid-template-columns:1fr}}

/* pricing */
.plans{margin-top:52px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.plan{position:relative;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:34px 28px;transition:transform .3s var(--ease),box-shadow .3s}
.plan:hover{transform:translateY(-6px);box-shadow:0 30px 60px -36px rgba(40,20,0,.4)}
.plan-name{font-size:14px;font-weight:600;letter-spacing:.02em;color:var(--ink-soft)}
.plan-price{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(42px,5vw,56px);line-height:1;margin:12px 0 2px;letter-spacing:-.025em}
.plan-price small{font-family:'Inter',sans-serif;font-size:15px;font-weight:500;color:var(--muted);letter-spacing:0}
.plan-desc{font-size:14px;color:var(--muted);margin-top:6px}
.plan ul{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:11px;flex:1}
.plan li{display:flex;gap:11px;font-size:14.5px;color:var(--ink-soft);line-height:1.42}
.plan li .ck{flex:0 0 auto;width:20px;height:20px;border-radius:50%;background:rgba(255,138,0,.12);color:var(--orange-deep);display:grid;place-items:center;font-size:11px;margin-top:1px}
.plan li.lead-in{font-weight:600;color:var(--ink)}
.plan .btn{margin-top:26px;width:100%;justify-content:center}

/* featured plan (Intermedio) */
.plan.feat{border-color:var(--orange);box-shadow:0 34px 74px -40px rgba(255,138,0,.65);transform:translateY(-12px);z-index:2}
.plan.feat:hover{transform:translateY(-18px)}
.plan-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--orange);color:#fff;font-size:12px;font-weight:700;letter-spacing:.02em;padding:6px 16px;border-radius:999px;white-space:nowrap;box-shadow:0 12px 26px -10px rgba(255,138,0,.8)}

/* message meter (crédito prepago) */
.meter{margin-top:18px;background:var(--paper-2);border:1px solid var(--line);border-radius:16px;padding:14px 16px}
.meter-top{display:flex;justify-content:space-between;align-items:baseline}
.meter-top b{font-size:14px;font-weight:600;color:var(--ink)}
.meter-top span{color:var(--muted);font-weight:500;font-size:12px}
.meter-bar{height:9px;border-radius:999px;background:#eaddc7;margin:10px 0 11px;overflow:hidden}
.meter-fill{height:100%;width:62.4%;border-radius:999px;background:linear-gradient(90deg,var(--orange),#ff6a00)}
.meter-note{font-size:12.5px;color:var(--muted);line-height:1.42}
.meter-note b{color:var(--orange-deep);font-weight:600}

/* whatsapp bubble (mensaje con la marca del local) */
.wabubble{margin-top:14px;display:flex;gap:11px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 14px;box-shadow:0 16px 34px -22px rgba(40,20,0,.5)}
.wabubble .av{flex:0 0 auto;width:40px;height:40px;border-radius:50%;object-fit:cover;border:1px solid var(--line)}
.wabubble .wa-body{min-width:0}
.wabubble .wa-name{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--ink)}
.wabubble .wa-name .v{flex:0 0 auto;width:15px;height:15px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:9px;font-weight:700}
.wabubble .wa-msg{margin-top:4px;display:inline-block;font-size:13.5px;color:var(--ink);background:#eaf6e6;border:1px solid #d6efcf;border-radius:4px 12px 12px 12px;padding:6px 11px}

/* premium plan (Avanzado — dark, Motor de Recompra) */
.plan.pro{background:var(--black);color:#ece7e1;border-color:rgba(255,255,255,.1);overflow:hidden}
.plan.pro:before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.16),transparent 64%);top:-160px;right:-140px;z-index:0}
.plan.pro>*{position:relative;z-index:1}
.plan.pro .fox-wm{opacity:.06;width:250px;bottom:-46px;right:-50px;left:auto;z-index:0}
.plan.pro .plan-name{color:#ffb454}
.plan.pro .plan-price{color:#fff}
.plan.pro .plan-desc{color:#a99e8f}
.plan.pro li{color:#c9beac}
.plan.pro li .ck{background:rgba(255,138,0,.2);color:var(--orange)}
.plan.pro .btn-ghost{color:#fff;border-color:rgba(255,255,255,.28)}
.plan.pro .btn-ghost:hover{border-color:var(--orange)}
.engine{margin-top:22px;border-top:1px solid rgba(255,255,255,.12);padding-top:20px}
.engine-title{font-family:'Fraunces',serif;font-size:21px;font-weight:600;color:#fff;display:flex;align-items:center;gap:9px}
.engine-title .spark{flex:0 0 auto;width:26px;height:26px;border-radius:8px;background:var(--orange);color:#fff;display:grid;place-items:center;font-size:14px}
.engine-tag{font-size:12px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--orange);margin-bottom:4px}
.engine ul{margin:16px 0 0}
.engine-close{margin-top:16px;font-family:'Fraunces',serif;font-size:16px;line-height:1.35;color:#fff;font-weight:500}
.engine-close b{color:var(--orange);font-weight:600}

.plans-note{margin-top:34px;text-align:center}
.plans-note .strong{font-family:'Fraunces',serif;font-size:clamp(19px,2.4vw,24px);font-weight:500;color:var(--ink)}
.plans-note .strong b{color:var(--orange-deep);font-weight:600}
.plans-note .fine{font-size:13.5px;color:var(--muted);margin-top:8px}
@media(max-width:980px){.plans{grid-template-columns:1fr;max-width:480px;margin-left:auto;margin-right:auto}.plan.feat,.plan.feat:hover{transform:none}}

/* feature tag (plan pago) */
.feat-grid .tag{align-self:flex-start;margin-top:auto;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--orange-deep);background:rgba(255,138,0,.1);border-radius:999px;padding:3px 9px}

/* agency */
.agency{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;background:var(--paper-2);border:1px solid var(--line);border-radius:34px;padding:58px}
.agency h2{font-size:clamp(30px,4vw,46px);margin-top:14px}
.agency .lead{font-size:18px;color:var(--ink-soft);margin-top:14px}
.agency-steps{display:flex;flex-direction:column;gap:13px;margin-top:24px}
.agency-steps div{display:flex;gap:14px;align-items:center;font-weight:500;color:var(--ink-soft)}
.agency-steps .n{flex:0 0 auto;width:28px;height:28px;border-radius:50%;background:var(--orange);color:#fff;display:grid;place-items:center;font-size:13px;font-weight:700}
.agency-card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px;box-shadow:0 30px 60px -36px rgba(40,20,0,.4)}
.agency-card .wa-num{font-family:'Fraunces',serif;font-size:26px;font-weight:600;margin:6px 0 18px}
@media(max-width:880px){.agency{grid-template-columns:1fr;padding:36px 26px}}

/* final */
.final{position:relative;overflow:hidden;background:#ff7200;color:#fff;text-align:center;padding:104px 24px}
.final h2{font-size:clamp(40px,6.5vw,78px);color:#fff}
.final p{font-size:19px;margin:16px auto 30px;max-width:32ch;color:rgba(255,255,255,.94)}
.final .btn{background:#fff;color:var(--orange-deep)}
.final .btn:hover{background:#0a0a0a;color:#fff}

/* footer */
footer{background:#ff7200;color:#fff;padding:60px 24px 46px}
.foot-in{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center}
.foot-brand{display:flex;align-items:center;gap:11px;color:#fff;font-family:'Fraunces',serif;font-weight:700;font-size:21px}
.foot-brand img{width:34px;height:34px}
.foot-links{display:flex;gap:24px;font-size:14px;flex-wrap:wrap}
.foot-links a{color:rgba(255,255,255,.92)}
.foot-links a:hover{color:#0a0a0a}
.foot-fine{margin-top:26px;font-size:13px;color:rgba(255,255,255,.82);border-top:1px solid rgba(255,255,255,.28);padding-top:20px}

/* reveal + keyframes */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:var(--d,0s)}
.reveal[data-anim="left"]{transform:translateX(-46px)}
.reveal[data-anim="right"]{transform:translateX(46px)}
.reveal[data-anim="scale"]{transform:scale(.93)}
.reveal.in{opacity:1;transform:none}
@keyframes upIn{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
@keyframes popIn{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1;transform:none}}
@keyframes dropIn{from{transform:translateY(-100%)}to{transform:none}}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
@keyframes chipIn{from{opacity:0;transform:translateY(12px) scale(.9)}to{opacity:1;transform:none}}
@keyframes breathe{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(255,138,0,.5)}70%{box-shadow:0 0 0 7px rgba(255,138,0,0)}100%{box-shadow:0 0 0 0 rgba(255,138,0,0)}}
@keyframes grad{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@media(prefers-reduced-motion:reduce){*{animation:none!important}.reveal{opacity:1;transform:none;transition:none}.btn:hover,.store:hover,.flow-phone .phone:hover{transform:none}}
</style>
</head>
