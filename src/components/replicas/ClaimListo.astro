---
import Icon from '../ui/Icon.astro'

/**
 * Una de las tarjetas "Ya está listo" del alta asistida (admin/src/pages/ClaimTienda.tsx): lo que ve
 * el dueño cuando abre el link para reclamar la tienda que le armamos.
 */
---

<div class="flex h-full w-full flex-col items-center bg-[#FFFBF0] px-7 pt-[150px] text-center text-foreground">
  <span class="flex size-14 items-center justify-center rounded-2xl bg-emerald-500/10 ring-1 ring-emerald-500/15">
    <Icon name="utensils-crossed" class="size-6 text-emerald-600" />
  </span>
  <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><Icon name="check" class="size-3.5" />Ya está listo</span>
  <p class="mt-2 text-[1.9rem] font-semibold leading-[1.12] tracking-tight">Tu menú ya está cargado</p>
  <div class="mt-6 w-full rounded-2xl bg-zinc-100 px-4 py-4 text-base font-medium">24 productos listos para vender</div>
  <p class="mt-3 text-xs text-muted-foreground">Lo afinás en detalle cuando entres a tu panel.</p>
  <span class="mt-7 flex h-14 w-full items-center justify-center rounded-2xl bg-[#FF7A00] text-[15px] font-semibold text-white">Continuar</span>
</div>
