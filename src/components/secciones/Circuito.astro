---
import Icon from '../ui/Icon.astro'
import type { NombreIcono } from '../ui/lucide'

/**
 * El sistema en una vuelta, justo debajo de la portada: para que el dueño entienda de entrada las
 * dos mitades de Piru —la tienda donde le piden sin comisión y el marketing para conseguir clientes
 * y que vuelvan— y cómo se encadenan. Las tarjetas se encienden de a una (la secuencia la maneja el
 * script de escenas/Escena.astro con `data-anima`); sin JS o con movimiento reducido, quietas.
 */
// `corto` es el rótulo entre 1024 y 1280 px, donde las cuatro tarjetas van en fila y no entra el largo.
const pasos: { icono: NombreIcono; tipo: string; corto: string; tienda?: boolean; titulo: string; texto: string; herramientas: { texto: string; href: string }[] }[] = [
  {
    icono: 'megaphone',
    tipo: 'Marketing · adquisición',
    corto: 'Adquisición',
    titulo: 'Conseguís clientes',
    texto: 'Cada historia, reel o QR lleva su link, y ves cuál te trae pedidos.',
    herramientas: [{ texto: 'Links medidos', href: '#marketing' }, { texto: 'Cupones', href: '#marketing' }],
  },
  {
    icono: 'store',
    tipo: 'Tu tienda',
    corto: 'Tu tienda',
    tienda: true,
    titulo: 'Te piden directo',
    texto: 'En tu tienda, en un minuto. El pedido te llega a tu WhatsApp.',
    herramientas: [{ texto: '0% comisión', href: '#precios' }, { texto: 'Con tu marca', href: '#tienda' }],
  },
  {
    icono: 'users',
    tipo: 'Marketing · retención',
    corto: 'Retención',
    titulo: 'Quedan en tu base',
    texto: 'Con su celular, qué piden y cada cuánto. Se arma sola.',
    herramientas: [{ texto: 'Clientes', href: '#marketing' }, { texto: 'Quién se va', href: '#marketing' }],
  },
  {
    icono: 'repeat-2',
    tipo: 'Marketing · retención',
    corto: 'Retención',
    titulo: 'Vuelven a pedir',
    texto: 'Piru te dice a quién escribirle y te arma el mensaje.',
    herramientas: [{ texto: 'Mensajes', href: '#marketing' }, { texto: 'Puntos', href: '#marketing' }, { texto: 'Días flojos', href: '#marketing' }],
  },
]
---

<section id="como-funciona" class="bg-sand py-24 sm:py-32">
  <div class="contenedor">
    <div class="revelar mx-auto max-w-3xl text-center">
      <p class="antetitulo">Cómo funciona</p>
      <h2 class="titulo-lg mt-4">Tu propio canal de venta, en una vuelta</h2>
      <p class="bajada mx-auto mt-5 max-w-2xl">Conseguís clientes, te piden directo, quedan en tu base y vuelven a pedir. Cada vuelta, sin pagarle comisión a nadie.</p>
    </div>

    <div class="circuito revelar mt-14 sm:mt-16" data-anima data-secuencia="1900" data-fases="5" data-fase="-1">
      <ol class="grid gap-3.5 lg:grid-cols-4 lg:gap-5">
        {pasos.map((p, i) => (
          <li class="circuito-paso relative rounded-[26px] bg-white p-6 ring-1 ring-line" data-paso={i}>
            <div class="flex items-center justify-between gap-3">
              <span class:list={['circuito-icono grid size-12 shrink-0 place-items-center rounded-2xl', p.tienda ? 'bg-brand text-white' : 'bg-brand-soft text-brand-deep']}>
                <Icon name={p.icono} class="size-[22px]" />
              </span>
              <span class:list={['whitespace-nowrap rounded-full px-2.5 py-1 text-[11.5px] font-semibold', p.tienda ? 'bg-brand-soft text-brand-deep ring-1 ring-brand/20' : 'bg-sand text-ink-2 ring-1 ring-line']}>
                <span class="lg:max-xl:hidden">{p.tipo}</span><span class="hidden lg:max-xl:inline">{p.corto}</span>
              </span>
            </div>
            <p class="mt-5 flex items-baseline gap-2">
              <span class="text-[13px] font-bold tabular-nums text-brand-deep">{i + 1}</span>
              <span class="text-[21px] font-semibold leading-tight tracking-[-0.02em] text-ink">{p.titulo}</span>
            </p>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{p.texto}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.herramientas.map((h) => (
                <li><a href={h.href} class="inline-flex rounded-full bg-paper px-2.5 py-1 text-[12.5px] font-medium text-ink-2 ring-1 ring-line transition-colors hover:text-ink hover:ring-ink/25">{h.texto}</a></li>
              ))}
            </ul>
            {i < pasos.length - 1 && (
              <span class="circuito-flecha" aria-hidden="true"><Icon name="arrow-right" class="size-4" stroke={2.4} /></span>
            )}
          </li>
        ))}
      </ol>

      <!-- La vuelta: de "Vuelven a pedir" otra vez a la tienda. -->
      <div class="circuito-vuelta mt-3.5 lg:mt-0" aria-hidden="true">
        <div class="circuito-u">
          <span class="circuito-punta"><Icon name="arrow-up-right" class="size-4 -rotate-45" stroke={2.6} /></span>
          <span class="circuito-rotulo"><Icon name="repeat-2" class="size-4" />Y vuelven a tu tienda: otra venta, sin comisión</span>
        </div>
      </div>
      <p class="sr-only">Y los clientes que vuelven piden otra vez por tu tienda, sin comisión.</p>
    </div>
  </div>
</section>

<style>
  .circuito-paso {
    transition: box-shadow .5s var(--ease-suave), transform .5s var(--ease-suave);
    box-shadow: 0 1px 2px rgb(40 24 8 / .04), 0 12px 32px -18px rgb(40 24 8 / .18);
  }
  .circuito-icono { transition: background-color .5s, color .5s; }
  .circuito[data-fase='0'] [data-paso='0'],
  .circuito[data-fase='1'] [data-paso='1'],
  .circuito[data-fase='2'] [data-paso='2'],
  .circuito[data-fase='3'] [data-paso='3'] {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px var(--color-brand), 0 22px 40px -18px rgb(255 122 0 / .55);
  }
  .circuito[data-fase='0'] [data-paso='0'] .circuito-icono,
  .circuito[data-fase='2'] [data-paso='2'] .circuito-icono,
  .circuito[data-fase='3'] [data-paso='3'] .circuito-icono {
    background: var(--color-brand);
    color: #fff;
  }

  /* Flechas entre pasos: abajo en celular, a la derecha en escritorio. */
  .circuito-flecha {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: -21px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    transform: translateX(-50%) rotate(90deg);
    box-shadow: 0 0 0 4px var(--color-sand);
  }

  /* La vuelta, en celular: un rótulo debajo del último paso. */
  .circuito-u { position: relative; }
  .circuito-punta { display: none; }
  .circuito-rotulo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    text-align: center;
    transition: background-color .5s, box-shadow .5s;
  }
  .circuito[data-fase='4'] .circuito-rotulo { background: var(--color-brand); box-shadow: 0 14px 30px -12px rgb(255 122 0 / .8); }

  @media (min-width: 1024px) {
    .circuito-flecha {
      left: auto;
      right: -24px;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
    /* La vuelta, en escritorio: una U punteada que sale del 4º paso y entra al 2º. Va de centro a
       centro de las columnas 2 y 4 (grid de 4 columnas con 1,25 rem de separación). */
    .circuito-vuelta {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 1.25rem;
    }
    .circuito-u {
      grid-column: 2 / 5;
      height: 62px;
      margin-inline: calc((100% - 2.5rem) / 6);
      border: 2px dashed rgb(25 21 18 / .28);
      border-top: 0;
      border-radius: 0 0 30px 30px;
      transition: border-color .5s;
    }
    .circuito[data-fase='4'] .circuito-u { border-color: var(--color-brand); }
    .circuito-punta {
      position: absolute;
      left: -1px;
      top: -6px;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: var(--color-ink);
      color: #fff;
      transform: translateX(-50%);
      transition: background-color .5s;
    }
    .circuito[data-fase='4'] .circuito-punta { background: var(--color-brand); }
    .circuito-rotulo {
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translate(-50%, 50%);
      white-space: nowrap;
      padding: 10px 18px;
    }
  }
</style>
