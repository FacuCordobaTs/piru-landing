---
import Icon from '../../ui/Icon.astro'
import { FOTOS } from '../../../data/fotos'
import { SMASH } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

/**
 * Réplica del detalle de producto (web/src/components/ProductDetailDrawer.tsx), en el paso de
 * ingredientes y extras. Cambio deliberado: debajo del título queda a la vista la opción ya
 * elegida en el paso anterior ("Doble"), que hoy no se ve al avanzar de paso.
 */
interface Props {
  oscura?: boolean
}

const { oscura = false } = Astro.props
const variante = SMASH.variantes[1]
const ingredientes = ['Medallón', 'Cheddar', SMASH.sinIngrediente]
const extras = SMASH.extras.slice(0, 2)
const total = variante.precio + SMASH.extras.filter((e) => e.elegido).reduce((s, e) => s + e.precio, 0)
const fila = 'flex w-full items-center justify-between rounded-2xl px-4 py-3.5 text-left'
---

<div class:list={['tienda relative h-full w-full overflow-hidden bg-secondary text-foreground', oscura && 'tienda--oscura']}>
  <img src={FOTOS.smash.grande} alt="" loading="lazy" decoding="async" class="absolute inset-x-0 top-0 h-[300px] w-full object-cover" />
  <div class="absolute inset-x-0 top-0 h-[300px] bg-black/20" />

  <span class="absolute left-4 top-[62px] z-20 flex size-11 items-center justify-center rounded-full bg-black/45 text-white shadow-lg backdrop-blur-md">
    <Icon name="chevron-left" class="size-6" />
  </span>
  <span class="absolute right-4 top-[68px] z-20 rounded-full bg-black/45 px-3 py-1.5 text-xs font-semibold tabular-nums text-white shadow-lg backdrop-blur-md">1 / 4</span>

  <section class="absolute inset-x-0 bottom-0 top-[190px] flex flex-col rounded-t-[32px] bg-background px-6 pt-9 shadow-[0_-12px_45px_rgba(0,0,0,0.24)]">
    <span class="absolute left-1/2 top-3 h-1.5 w-10 -translate-x-1/2 rounded-full bg-foreground/15" />

    <div class="flex items-end justify-between gap-3">
      <p class="min-w-0 flex-1 text-[28px] font-bold leading-tight tracking-tight text-foreground">Smash burger</p>
      <p class="shrink-0 text-2xl font-bold text-primary">{pesos(total)}</p>
    </div>
    <p class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
      <Icon name="check" class="size-3.5" stroke={2.6} />{variante.nombre} · {pesos(variante.precio)}
    </p>

    <div class="mt-6 space-y-6">
      <div class="space-y-1">
        <p class="px-1 pb-1 text-lg font-bold text-foreground">Ingredientes</p>
        <div class="flex flex-col gap-0.5">
          {ingredientes.map((nombre) => {
            const incluido = nombre !== SMASH.sinIngrediente
            return (
              <div class:list={[fila, incluido ? 'bg-secondary/60' : 'bg-secondary/30']}>
                <span class:list={['text-[15px]', incluido ? 'text-foreground' : 'text-muted-foreground line-through']}>{nombre}</span>
                {incluido && <Icon name="check" class="size-[18px] text-foreground/70" />}
              </div>
            )
          })}
        </div>
      </div>

      <div class="space-y-1">
        <p class="px-1 pb-1 text-lg font-bold text-foreground">Extras</p>
        <div class="flex flex-col gap-0.5">
          {extras.map((extra) => (
            <div class:list={[fila, extra.elegido ? 'bg-primary/10' : 'bg-secondary/50']}>
              <span class:list={['text-[15px]', extra.elegido ? 'font-semibold text-primary' : 'text-foreground']}>{extra.nombre}</span>
              <span class="flex items-center gap-2">
                <span class:list={['text-[15px]', extra.elegido ? 'font-semibold text-primary' : 'text-muted-foreground']}>+{pesos(extra.precio)}</span>
                {extra.elegido && <Icon name="check" class="size-[18px] text-primary" />}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-6">
      <div class="flex h-14 w-full items-center justify-center rounded-2xl bg-primary px-2 text-[17px] font-semibold text-primary-foreground">
        Agregar · {pesos(total)}
      </div>
    </div>
  </section>
</div>
