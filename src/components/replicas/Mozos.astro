---
import { COMANDA_MESA, MENU } from '../../data/demo'
import { pesos } from '../../data/oferta'

/** Réplica de la app de mozos (mozos/src/App.tsx + styles.css): la comanda de una mesa. */
const confirmados = COMANDA_MESA.confirmados
const porConfirmar = COMANDA_MESA.porConfirmar
const total = [...confirmados, ...porConfirmar].reduce((s, i) => s + i.precio, 0)
const productos = [...MENU[1].productos.slice(0, 2), ...MENU[3].productos]
---

<div class="relative h-full w-full bg-[#f6f7f3] text-[#19261e]">
  <div class="px-[18px] pt-[62px]">
    <div class="grid min-h-[92px] grid-cols-[1fr_auto_1fr] items-start">
      <span class="justify-self-start py-2 font-bold text-[#315b43]">‹ Mesas</span>
      <p class="self-end whitespace-nowrap text-center text-[46px] font-extrabold leading-none tracking-[-0.055em]">{COMANDA_MESA.mesa}</p>
    </div>

    <div class="my-4 overflow-hidden rounded-[18px] border border-[#dae1da] bg-white">
      <div class="flex items-center justify-between bg-[#fbfcfa] px-4 py-3.5">
        <span class="font-medium">Comanda</span>
        <strong>{pesos(total)}</strong>
      </div>
      <ul>
        {confirmados.map((it) => (
          <li class="flex items-center justify-between gap-3 border-t border-[#eef0ed] px-4 py-3.5">
            <span><strong class="font-semibold">{it.cantidad} × {it.nombre}</strong></span>
            <span class="text-sm text-[#556259]">{pesos(it.precio)}</span>
          </li>
        ))}
      </ul>
      <p class="border-t border-[#eef0ed] bg-[#fff8ec] px-4 py-2.5 text-[11.5px] font-bold uppercase tracking-[.11em] text-[#765116]">Por confirmar</p>
      <ul>
        {porConfirmar.map((it) => (
          <li class="flex items-center justify-between gap-3 border-t border-[#eef0ed] px-4 py-3.5">
            <span><strong class="font-semibold">{it.cantidad} × {it.nombre}</strong><small class="mt-0.5 block text-[12px] text-[#67726a]">Tocá para editar</small></span>
            <span class="grid size-[38px] place-items-center rounded-[11px] bg-[#f6e9e7] text-[25px] leading-none text-[#a53a35]">×</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex min-h-12 items-center rounded-xl border border-[#d6ded6] bg-white px-3 text-[#6b766e]">Buscar producto…</div>
    <div class="mt-3 grid gap-[9px]">
      {productos.slice(0, 3).map((p) => (
        <div class="flex items-center justify-between rounded-[15px] border border-[#dce2dc] bg-white p-4">
          <span><strong class="font-semibold">{p.nombre}</strong><small class="mt-0.5 block text-[12px] text-[#67726a]">{pesos(p.precio)}</small></span>
          <b class="grid size-8 place-items-center rounded-[10px] bg-[#163b2b] text-[22px] font-medium leading-none text-white">+</b>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3.5 border-t border-[#dbe2db] bg-white/95 px-[18px] pb-9 pt-3 backdrop-blur">
    <span class="grid text-[12px] text-[#5e695f]">Total<strong class="text-[16px] text-[#19261e]">{pesos(total)}</strong></span>
    <span class="flex min-h-12 items-center rounded-[13px] bg-[#163b2b] px-5 font-bold text-white">Confirmar pedido</span>
  </div>
</div>
