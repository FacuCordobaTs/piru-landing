---
import Icon from '../../ui/Icon.astro'
import Barra from './Barra.astro'
import TicketPedido from './TicketPedido.astro'
import { PEDIDO, PEDIDOS, LOCAL } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

/**
 * Réplica de Inicio (admin/src/pages/Dashboard.tsx): lista de pedidos del día y, a la derecha, el
 * ticket del pedido elegido con su comanda.
 * Cambio deliberado: el medio de pago se nombra por lo que es para el dueño ("Transferencia") y no
 * por el proveedor que la procesa ("Talo", "Cucuru").
 */
interface Props {
  compacta?: boolean
  anchoLista?: number
  /** El #1284 entra con una animación, como recién llegado. */
  animarNuevo?: boolean
}

const { compacta = false, anchoLista = 392, animarNuevo = false } = Astro.props

const badgePago: Record<string, { texto: string; clase: string; emoji: string }> = {
  'Mercado Pago': { texto: 'MP', clase: 'bg-[#009EE3]/10 text-[#009EE3]', emoji: '💳' },
  Transferencia: { texto: 'Transferencia', clase: 'bg-amber-500/10 text-amber-600', emoji: '🏦' },
  Efectivo: { texto: 'Efectivo', clase: 'bg-emerald-500/10 text-emerald-600', emoji: '💵' },
}
const iconoTipo = { delivery: 'truck', takeaway: 'shopping-bag', mesa: 'armchair' } as const
const insignia = 'inline-flex h-4 items-center rounded-md px-1 text-[9px] font-medium'
---

<div class="flex h-full w-full bg-[#FFFBF0] text-foreground">
  <Barra activo="inicio" compacta={compacta} />

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
      <div class="flex flex-1 items-center">
        <span class="inline-flex h-[22px] items-center gap-1 rounded-md border border-[#FF7A00]/25 px-2 text-xs font-medium">
          <Icon name="store" class="size-3 text-[#FF7A00]" />{LOCAL.sucursal}
        </span>
      </div>
      <div class="flex items-center gap-1.5 rounded-xl px-2 py-1">
        <p class="text-2xl font-bold tracking-tight">Hoy</p>
        <Icon name="chevrons-up-down" class="size-5 text-muted-foreground" />
      </div>
      <div class="flex flex-1 items-center justify-end gap-2">
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium shadow-xs"><Icon name="calendar-days" class="size-4" />Caja</span>
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium shadow-xs"><Icon name="map" class="size-4" />Mapa</span>
      </div>
    </header>

    <div class="relative flex min-h-0 flex-1 gap-4 p-4 pt-1">
      <div class="absolute inset-x-4 top-1 z-10 flex h-11 items-center justify-center rounded-xl bg-[#FF7A00] text-base font-bold text-white">+ Nuevo pedido</div>

      <div class="mt-14 flex shrink-0 flex-col" style={`width:${anchoLista}px`}>
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-2">
            <p class="text-base font-bold">Pedidos</p>
            <span class="rounded-full bg-[#FF7A00] px-2 text-xs font-semibold leading-5 text-white">{PEDIDOS.length}</span>
          </div>
          <span class="flex size-8 items-center justify-center rounded-md border border-border bg-background"><Icon name="ellipsis-vertical" class="size-4" /></span>
        </div>
        <div class="space-y-2 p-3 pt-0">
          <p class="pb-1 text-[10px] font-bold uppercase text-muted-foreground">Hoy</p>
          {PEDIDOS.map((p) => {
            const pago = p.pago ? badgePago[p.pago] : null
            const elegido = p.id === PEDIDO.id
            return (
              <div class:list={[
                'flex flex-col gap-1.5 rounded-xl px-3.5 py-2.5',
                elegido ? 'border-l-[3px] border-l-[#FF7A00] bg-muted/40' : 'bg-white',
                elegido && animarNuevo && 'pedido-nuevo',
              ]}>
                <div class="flex items-start justify-between gap-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-bold">#{p.id}</span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-medium text-muted-foreground">
                      <Icon name={iconoTipo[p.tipo]} class="size-3" />{p.etiqueta}
                    </span>
                    {p.pendiente && <span class:list={[insignia, 'border border-border bg-muted text-muted-foreground']}>Pendiente</span>}
                    {pago && <span class:list={[insignia, pago.clase]}><span class="mr-1">{pago.emoji}</span>{pago.texto}</span>}
                    {'programado' in p && p.programado && (
                      <span class:list={[insignia, 'gap-0.5 border border-border bg-muted px-1.5 font-bold text-muted-foreground']}><Icon name="clock" class="size-2.5" />{p.programado}</span>
                    )}
                  </div>
                  <span class="text-sm font-black">{pesos(p.total)}</span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold">{p.cliente}</p>
                    {p.detalle && <p class="mt-0.5 flex items-center gap-1 truncate text-[11px] text-muted-foreground"><Icon name="map-pin" class="size-2.5" />{p.detalle}</p>}
                  </div>
                  <div class="flex shrink-0 items-center gap-2">
                    <span class="whitespace-nowrap text-[10px] text-muted-foreground">{p.hace}</span>
                    {!p.pendiente && <span class="flex size-8 items-center justify-center rounded-lg bg-muted text-muted-foreground"><Icon name="message-circle" class="size-4" /></span>}
                    <span class="flex size-8 items-center justify-center rounded-lg bg-[#FF7A00] text-white"><Icon name="truck" class="size-4" /></span>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      </div>

      <div class="relative mt-14 flex min-w-0 flex-1 flex-col overflow-hidden rounded-2xl">
        <TicketPedido />
      </div>
    </div>
  </div>
</div>
