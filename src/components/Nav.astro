---
import Logo from './ui/Logo.astro'
import Icon from './ui/Icon.astro'
import { CREAR_TIENDA, ENTRAR } from '../data/oferta'

const cta = { href: CREAR_TIENDA, largo: 'Crear tienda gratis', corto: 'Crear tienda' }
const SECCIONES = [
  { href: '/#disenos', texto: 'Diseños' },
  { href: '/#plantillas', texto: 'Plantillas' },
  { href: '/#todo', texto: 'Qué incluye' },
  { href: '/#precios', texto: 'Precios' },
]
const enlace = 'nav-enlace h-10 items-center rounded-full px-2 text-[14.5px] font-medium transition-colors sm:px-3.5'
---

<header id="nav" class="nav fixed inset-x-0 top-0 z-50">
  <nav class="contenedor flex h-[68px] items-center justify-between gap-3" aria-label="Principal">
    <a href="/" class="flex items-center gap-2.5 rounded-xl" aria-label="Piru, inicio">
      <Logo size={32} />
      <span class="nav-marca text-[21px] font-bold tracking-[-0.04em] transition-colors">Piru</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {SECCIONES.map((s) => <a href={s.href} class:list={[enlace, 'hidden lg:inline-flex']}>{s.texto}</a>)}
      <a href={ENTRAR} class:list={[enlace, 'hidden sm:inline-flex']}>Entrar</a>
      <a href={cta.href} class="boton boton-primario boton-chico">
        <Icon name="sparkles" class="size-[17px]" stroke={2.2} />
        <span class="hidden min-[440px]:inline">{cta.largo}</span>
        <span class="min-[440px]:hidden">{cta.corto}</span>
      </a>
    </div>
  </nav>
</header>

<style>
  /* El menú toma los colores del tema de la sección que se ve (data-tema en <html>). */
  .nav {
    color: var(--t);
    transition: background-color .9s var(--ease-suave), color .9s var(--ease-suave), box-shadow .3s;
  }
  .nav :global(.nav-enlace) { color: var(--t2); }
  .nav :global(.nav-enlace:hover) { color: var(--t); background: color-mix(in srgb, var(--t) 7%, transparent); }
  .nav.nav--scrolleado {
    background: color-mix(in srgb, var(--fondo) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 1px 0 var(--linea);
  }
  /* Sobre el cierre naranja, el botón pasa a oscuro para no perderse. */
  :global(html[data-tema='marca']) .nav :global(.boton-primario) { background: #191512; box-shadow: none; }
  /* Sobre el pie, que es de noche. */
  .nav.nav--oscuro { --t: #fff; --t2: rgb(255 255 255 / .72); --fondo: #120F0D; --linea: rgb(255 255 255 / .08); }
</style>

<script>
  const nav = document.getElementById('nav')
  const oscuras = [...document.querySelectorAll<HTMLElement>('[data-nav-oscuro]')]
  const alScrollear = () => {
    nav?.classList.toggle('nav--scrolleado', window.scrollY > 12)
    const alto = nav?.offsetHeight ?? 68
    const sobreOscura = oscuras.some((el) => {
      const r = el.getBoundingClientRect()
      return r.top <= alto / 2 && r.bottom >= alto / 2
    })
    nav?.classList.toggle('nav--oscuro', sobreOscura)
  }
  window.addEventListener('scroll', alScrollear, { passive: true })
  alScrollear()
</script>
