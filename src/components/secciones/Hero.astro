---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import Telefono from '../marcos/Telefono.astro'
import Ventana from '../marcos/Ventana.astro'
import Escena from '../escenas/Escena.astro'
import EditorPaginas from '../replicas/paginas/EditorPaginas.astro'
import PaginaAlfajor from '../replicas/paginas/PaginaAlfajor.astro'
import PaginaChe from '../replicas/paginas/PaginaChe.astro'
import Plantilla from '../replicas/paginas/Plantilla.astro'
import { enlaceWhatsapp, pesos, PRECIO_BASE } from '../../data/oferta'
import { PEDIDO } from '../../data/demo'

/**
 * La portada dice lo principal: la página propia del local, con su diseño. La escena muestra el
 * editor de Páginas con la página de Alfajor y, al lado, el celular que va pasando por páginas
 * distintas (dos diseños a medida y dos plantillas) mientras el pedido sigue llegando igual:
 * el diseño cambia, lo de abajo es siempre Piru. La secuencia la maneja escenas/Escena.astro.
 */
const checks = ['Plantillas o diseño a medida', 'Con tu dominio', `Sin comisión · ${pesos(PRECIO_BASE)} por mes`]
const disenos = [
  { rotulo: 'Diseño a medida', nombre: 'Alfajor con Papas', url: 'alfajorconpapas.com' },
  { rotulo: 'Plantilla', nombre: 'Moderna', url: 'brasa.piru.app' },
  { rotulo: 'Diseño a medida', nombre: 'Che Milanesa', url: 'che-milanesa.com' },
  { rotulo: 'Plantilla', nombre: 'Artesanal', url: 'brasa.piru.app' },
]
const etiqueta = 'El editor de Páginas con la página de Alfajor con Papas y, al lado, un celular que muestra páginas de locales con diseños distintos: Alfajor con Papas, la plantilla Moderna, Che Milanesa y la plantilla Artesanal. Los pedidos llegan igual al WhatsApp del local, sin comisión.'
const RUTA = 'M 752 114 C 790 114, 790 166, 828 176'
---

<section class="relative overflow-hidden pt-[128px] sm:pt-[150px]">
  <div class="fondo-hero pointer-events-none absolute inset-0" aria-hidden="true" />

  <div class="contenedor relative text-center">
    <p class="revelar mx-auto inline-flex items-center gap-2.5 rounded-full bg-white/80 px-3.5 py-1.5 text-[13.5px] font-medium text-ink-2 ring-1 ring-line backdrop-blur">
      <span class="punto-vivo" />La plataforma para vender online en gastronomía
    </p>
    <h1 class="revelar titulo-xl mx-auto mt-6 max-w-[15ch] sm:max-w-none" style="--retraso:80ms">
      Tu local, con su propia página.<br /><span class="text-brand">Con tu diseño, no el de todos.</span>
    </h1>
    <p class="revelar bajada mx-auto mt-6 max-w-[44rem]" style="--retraso:160ms">
      Diseñá la página de tu local con una plantilla, a tu gusto o con nuestra ayuda. Debajo, Piru pone
      todo lo demás: la carta, los pedidos a tu WhatsApp, los cobros, el salón y tus clientes.
    </p>
    <div class="revelar mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--retraso:240ms">
      <a href={enlaceWhatsapp()} target="_blank" rel="noopener" class="boton boton-primario w-full max-w-xs sm:w-auto">
        <Icon name="sparkles" class="size-[18px]" stroke={2.2} />Crear mi página
      </a>
      <a href="#paginas" class="boton boton-secundario w-full max-w-xs sm:w-auto">
        Ver páginas hechas con Piru<Icon name="arrow-down" class="size-4" />
      </a>
    </div>
    <ul class="revelar mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[14px] text-ink-2" style="--retraso:320ms">
      {checks.map((c) => (
        <li class="flex items-center gap-1.5"><Icon name="circle-check" class="size-4 text-brand" stroke={2.2} />{c}</li>
      ))}
    </ul>
  </div>

  <div class="revelar contenedor relative mt-12 pb-16 sm:mt-16 sm:pb-24" style="--retraso:200ms">
    <!-- Escritorio -->
    <div class="mx-auto hidden max-w-[1100px] md:block">
      <Escena ancho={1100} alto={680} etiqueta={etiqueta} secuencia={3200} fases={4} class="hero-escena">
        <div class="absolute left-0 top-[56px] w-[760px] overflow-hidden rounded-[16px] shadow-[0_2px_4px_rgb(40_24_8/.06),0_40px_80px_-30px_rgb(40_24_8/.4)]">
          <Escala ancho={1280} alto={800} etiqueta="El editor de Páginas">
            <Ventana ancho={1280} alto={800} url="pages.piru.app"><EditorPaginas><PaginaAlfajor carrito={false} /></EditorPaginas></Ventana>
          </Escala>
        </div>

        <!-- El celular cambia de página; el rótulo de arriba dice cuál es. -->
        <div class="absolute left-[808px] top-[52px] h-[44px] w-[292px]">
          {disenos.map((d, i) => (
            <p class="hero-diseno absolute inset-0 flex items-center justify-center gap-2 text-[13px]" data-d={i}>
              <span class:list={['rounded-full px-2.5 py-1 font-semibold', d.rotulo === 'Plantilla' ? 'bg-sand text-ink-2 ring-1 ring-line' : 'bg-brand-soft text-brand-deep ring-1 ring-brand/20']}>{d.rotulo}</span>
              <span class="font-semibold text-ink">{d.nombre}</span>
            </p>
          ))}
        </div>
        <div class="absolute left-[808px] top-[100px] w-[292px] rotate-2 drop-shadow-[0_30px_50px_rgba(40,20,5,0.32)]">
          <div class="relative">
            {disenos.map((d, i) => (
              <div class:list={['hero-diseno', i > 0 && 'absolute inset-0']} data-d={i}>
                <Escala ancho={412} alto={866} etiqueta={`${d.rotulo}: ${d.nombre}`}>
                  <Telefono url={d.url} tono={i === 2 ? 'oscuro' : 'claro'} tonoNavegador={i === 2 ? 'oscuro' : 'claro'}>
                    {i === 0 && <PaginaAlfajor />}
                    {i === 1 && <Plantilla plantilla="moderna" />}
                    {i === 2 && <PaginaChe />}
                    {i === 3 && <Plantilla plantilla="artesanal" />}
                  </Telefono>
                </Escala>
              </div>
            ))}
          </div>
        </div>

        <!-- De "Publicar" al celular. -->
        <svg class="absolute inset-0" width="1100" height="680" viewBox="0 0 1100 680" fill="none" aria-hidden="true">
          <path d={RUTA} stroke="#FF7A00" stroke-width="2.5" stroke-linecap="round" class="e-hormigas" />
        </svg>
        <span class="e-viaja absolute left-0 top-0 size-3.5 rounded-full bg-brand shadow-[0_0_0_6px_rgb(255_122_0/.22)]" style={`--ruta:path("${RUTA}");--t:2.4s;--d:900ms`} />
        <span class="e-pop absolute left-[716px] top-[96px] grid size-9 place-items-center rounded-full bg-ink text-white shadow-lg" style="--d:600ms"><Icon name="mouse-pointer-click" class="size-4" /></span>

        <div class="e-sube absolute left-[24px] top-[560px] flex w-[250px] items-center gap-2.5 rounded-2xl bg-white/95 px-3.5 py-3 text-left shadow-lg ring-1 ring-line backdrop-blur" style="--d:1100ms">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand text-white"><Icon name="globe" class="size-4" /></span>
          <span class="text-[13px] font-semibold leading-snug text-ink">Publicada en tu dominio<span class="block text-[12px] font-normal text-ink-3">Y si no te gusta, volvés atrás</span></span>
        </div>
        <div class="e-sube absolute left-[330px] top-[600px] flex w-[268px] items-center gap-2.5 rounded-2xl bg-white/95 px-3.5 py-3 text-left shadow-lg ring-1 ring-line backdrop-blur" style="--d:1500ms">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-wa text-white"><Icon name="message-circle" class="size-4" /></span>
          <span class="text-[13px] font-semibold leading-snug text-ink">Pedido #{PEDIDO.id} · {pesos(PEDIDO.total)}<span class="block text-[12px] font-normal text-ink-3">Llega a tu WhatsApp, con cualquier diseño</span></span>
        </div>
        <div class="e-sube absolute left-[660px] top-[470px] flex w-[200px] items-center gap-2.5 rounded-2xl bg-white/95 px-3.5 py-3 text-left shadow-lg ring-1 ring-line backdrop-blur" style="--d:1900ms">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-emerald-500 text-white"><Icon name="check" class="size-4" stroke={3} /></span>
          <span class="text-[13px] font-semibold leading-snug text-ink">Comisión: $0<span class="block text-[12px] font-normal text-ink-3">El 100% es tuyo</span></span>
        </div>
      </Escena>
    </div>

    <!-- Celular: la página que cambia y los dos avisos más importantes. -->
    <div class="mx-auto max-w-[420px] md:hidden">
      <Escena ancho={390} alto={600} etiqueta={etiqueta} secuencia={3200} fases={4} class="hero-escena">
        <div class="absolute left-0 right-0 top-0 h-[36px]">
          {disenos.map((d, i) => (
            <p class="hero-diseno absolute inset-0 flex items-center justify-center gap-2 text-[13px]" data-d={i}>
              <span class:list={['rounded-full px-2.5 py-1 font-semibold', d.rotulo === 'Plantilla' ? 'bg-sand text-ink-2 ring-1 ring-line' : 'bg-brand-soft text-brand-deep ring-1 ring-brand/20']}>{d.rotulo}</span>
              <span class="font-semibold text-ink">{d.nombre}</span>
            </p>
          ))}
        </div>
        <div class="absolute left-[78px] top-[46px] w-[234px] drop-shadow-[0_24px_40px_rgba(40,20,5,0.3)]">
          <div class="relative">
            {disenos.map((d, i) => (
              <div class:list={['hero-diseno', i > 0 && 'absolute inset-0']} data-d={i}>
                <Escala ancho={412} alto={866} etiqueta={`${d.rotulo}: ${d.nombre}`}>
                  <Telefono url={d.url} tono={i === 2 ? 'oscuro' : 'claro'} tonoNavegador={i === 2 ? 'oscuro' : 'claro'}>
                    {i === 0 && <PaginaAlfajor video={false} />}
                    {i === 1 && <Plantilla plantilla="moderna" />}
                    {i === 2 && <PaginaChe />}
                    {i === 3 && <Plantilla plantilla="artesanal" />}
                  </Telefono>
                </Escala>
              </div>
            ))}
          </div>
        </div>
        <div class="e-sube absolute left-[6px] top-[440px] flex items-center gap-2 rounded-2xl bg-white/95 px-3 py-2.5 text-left shadow-lg ring-1 ring-line" style="--d:1100ms">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-wa text-white"><Icon name="message-circle" class="size-3.5" /></span>
          <span class="text-[12.5px] font-semibold leading-tight text-ink">Pedido a tu WhatsApp</span>
        </div>
        <div class="e-sube absolute right-[6px] top-[520px] flex items-center gap-2 rounded-2xl bg-white/95 px-3 py-2.5 text-left shadow-lg ring-1 ring-line" style="--d:1500ms">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-emerald-500 text-white"><Icon name="check" class="size-3.5" stroke={3} /></span>
          <span class="text-[12.5px] font-semibold leading-tight text-ink">Comisión: $0</span>
        </div>
      </Escena>
    </div>
  </div>
</section>

<style>
  .fondo-hero {
    background:
      radial-gradient(60rem 30rem at 50% 62%, rgb(255 122 0 / .13), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(40 24 8 / .09) 1px, transparent 0) 0 0 / 26px 26px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 96%);
  }
  /* Una página por fase; sin JS (o con movimiento reducido) queda la de Alfajor. */
  .hero-diseno {
    opacity: 0;
    transform: translateY(10px) scale(.985);
    transition: opacity .7s var(--ease-suave), transform .7s var(--ease-suave);
  }
  :global(.hero-escena[data-fase='0']) .hero-diseno[data-d='0'],
  :global(.hero-escena[data-fase='1']) .hero-diseno[data-d='1'],
  :global(.hero-escena[data-fase='2']) .hero-diseno[data-d='2'],
  :global(.hero-escena[data-fase='3']) .hero-diseno[data-d='3'],
  :global(.hero-escena:not([data-fase])) .hero-diseno[data-d='0'] {
    opacity: 1;
    transform: none;
  }
</style>
