---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import PaginaAlfajor from '../replicas/paginas/PaginaAlfajor.astro'
import PaginaChe from '../replicas/paginas/PaginaChe.astro'
import Plantilla from '../replicas/paginas/Plantilla.astro'
import { CREAR_TIENDA } from '../../data/oferta'

/**
 * La portada, de noche: la oferta en una frase y, detrás, un muro inclinado de tiendas que suben
 * y bajan, todas distintas: las cuatro plantillas y las dos páginas a medida. Cada columna es una
 * cinta duplicada que corre con CSS (`h-cinta`). El título espera a que termine la intro
 * (`html.intro-fin`, ver Intro.astro). Al bajar, el muro se aplana y el texto se va (`--p`, del
 * script de Base.astro).
 */
type Diseno = { clave: string; nombre: string; tipo: string }
const DISENOS: Diseno[] = [
  { clave: 'alfajor', nombre: 'Alfajor con Papas', tipo: 'A medida' },
  { clave: 'elegante', nombre: 'Elegante', tipo: 'Plantilla' },
  { clave: 'che', nombre: 'Che Milanesa', tipo: 'A medida' },
  { clave: 'moderna', nombre: 'Moderna', tipo: 'Plantilla' },
  { clave: 'artesanal', nombre: 'Artesanal', tipo: 'Plantilla' },
  { clave: 'sencilla', nombre: 'Sencilla', tipo: 'Plantilla' },
]
// Cinco columnas de tres tiendas, corridas para que ninguna fila repita. En celular se ven las tres del medio.
const COLUMNAS = [[0, 3, 5], [4, 2, 1], [2, 0, 3], [3, 5, 4], [1, 4, 0]].map((indices, c) => ({
  disenos: indices.map((i) => DISENOS[i]),
  duracion: 46 + c * 7,
  sube: c % 2 === 0,
}))
const titulo = ['La', 'tienda', 'online', 'de', 'tu', 'local.']
const titulo2 = ['Con', 'tu', 'diseño.']
---

<section data-tema="noche" data-progreso class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden">
  <div class="h-muro pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="h-plano flex justify-center gap-5 sm:gap-7">
      {COLUMNAS.map((col, c) => (
        <div class:list={['h-columna w-[150px] shrink-0 sm:w-[210px]', (c === 0 || c === 4) && 'max-sm:hidden']} style={`--c:${c}`}>
          <div class:list={['h-cinta flex flex-col gap-5 sm:gap-7', col.sube ? 'h-cinta--sube' : 'h-cinta--baja']} style={`--dur:${col.duracion}s`}>
            {[0, 1].map(() => col.disenos.map((d) => (
              <figure class="m-0">
                <figcaption class="mb-2 flex items-center gap-1.5 text-[11px] font-semibold text-white/55 sm:text-[12px]">
                  <span class:list={['size-1.5 rounded-full', d.tipo === 'A medida' ? 'bg-[#FF8A1A]' : 'bg-white/40']} />{d.nombre}
                </figcaption>
                <div class="overflow-hidden rounded-[18px] ring-1 ring-white/10 sm:rounded-[24px]">
                  <Escala ancho={390} alto={780} etiqueta="">
                    {d.clave === 'alfajor' && <PaginaAlfajor video={false} carrito={false} />}
                    {d.clave === 'che' && <PaginaChe />}
                    {d.clave === 'elegante' && <Plantilla plantilla="elegante" />}
                    {d.clave === 'moderna' && <Plantilla plantilla="moderna" />}
                    {d.clave === 'artesanal' && <Plantilla plantilla="artesanal" />}
                    {d.clave === 'sencilla' && <Plantilla plantilla="sencilla" />}
                  </Escala>
                </div>
              </figure>
            )))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="h-velo pointer-events-none absolute inset-0 -z-10" aria-hidden="true" />

  <div class="h-texto contenedor relative py-32 text-center">
    <p class="h-entra mx-auto inline-flex items-center gap-2 rounded-full bg-white/[.07] px-3.5 py-1.5 text-[13px] font-semibold text-white/80 ring-1 ring-white/10 backdrop-blur" style="--d:.05s">
      <span class="punto-vivo" />Tiendas online para gastronomía
    </p>
    <h1 class="mx-auto mt-6 max-w-[16ch] text-[clamp(2.9rem,8vw,6.6rem)] font-bold leading-[.95] tracking-[-.045em] [perspective:800px]">
      {titulo.map((p, i) => <><span class="h-palabra" style={`--d:${0.12 + i * 0.06}s`}>{p}</span>{' '}</>)}
      <br />
      {titulo2.map((p, i) => <><span class="h-palabra text-[#FF8A1A]" style={`--d:${0.55 + i * 0.08}s`}>{p}</span>{' '}</>)}
    </h1>
    <p class="h-entra t2 mx-auto mt-7 max-w-[34rem] text-[clamp(1.05rem,1.6vw,1.3rem)] leading-relaxed" style="--d:.85s">
      Elegí una plantilla, ponele tu marca y empezá a vender hoy. Sin programadores y sin comisión por venta.
    </p>
    <div class="h-entra mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--d:1s">
      <a href={CREAR_TIENDA} class="boton boton-primario w-full max-w-xs sm:w-auto">
        <Icon name="sparkles" class="size-[18px]" stroke={2.2} />Crear tienda gratis
      </a>
      <a href="#disenos" class="boton w-full max-w-xs bg-white/10 text-white ring-1 ring-white/15 backdrop-blur hover:bg-white/15 sm:w-auto">
        Ver tiendas reales<Icon name="arrow-down" class="size-4" />
      </a>
    </div>
  </div>

  <span class="h-entra absolute bottom-6 left-1/2 hidden -translate-x-1/2 items-center gap-2 text-[12px] font-medium text-white/40 sm:flex" style="--d:1.4s">
    <span class="h-raton" aria-hidden="true" />Bajá
  </span>
</section>

<style>
  /* El muro: inclinado hacia atrás, y se endereza un poco al bajar. */
  .hero { --q: clamp(0, (var(--p, .5) - .5) * 2, 1); }
  .h-muro { perspective: 1400px; }
  .h-plano {
    position: absolute;
    inset: -20% -30%;
    transform: rotateX(calc(24deg - var(--q) * 14deg)) rotateZ(-9deg) translateY(calc(var(--q) * -6%)) scale(calc(1.06 + var(--q) * .08));
    transform-origin: 50% 30%;
  }
  .h-columna {
    opacity: 0;
    animation: h-columna 1.4s var(--ease-suave) calc(.2s + var(--c) * .12s) both;
  }
  .h-cinta { will-change: transform; animation: h-baja var(--dur) linear infinite; }
  .h-cinta--sube { animation-name: h-sube; }
  @keyframes h-sube { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes h-baja { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  @keyframes h-columna { from { opacity: 0; transform: translateY(80px); } to { opacity: .62; transform: none; } }

  /* El velo deja el centro oscuro para que el título se lea y funde el borde con la sección siguiente. */
  .h-velo {
    background:
      radial-gradient(ellipse 52% 46% at 50% 52%, rgb(14 11 9 / .96), rgb(14 11 9 / .82) 55%, rgb(14 11 9 / .25) 100%),
      linear-gradient(to bottom, rgb(14 11 9 / .7), transparent 22%, transparent 70%, #0E0B09);
  }

  .h-texto {
    opacity: calc(1 - var(--q) * 1.6);
    transform: translateY(calc(var(--q) * -60px)) scale(calc(1 - var(--q) * .06));
  }

  .h-palabra { display: inline-block; animation: h-palabra .9s cubic-bezier(.16, 1, .3, 1) var(--d) both; }
  .h-entra { animation: h-entra .9s var(--ease-suave) var(--d) both; }
  @keyframes h-palabra { from { opacity: 0; transform: translateY(60px) rotateX(-50deg); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes h-entra { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  /* El título espera a que termine la intro. */
  :global(html.js:not(.intro-fin)) .h-palabra,
  :global(html.js:not(.intro-fin)) .h-entra,
  :global(html.js:not(.intro-fin)) .h-columna { animation-play-state: paused; }

  .h-raton {
    width: 18px;
    height: 28px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .4);
    position: relative;
  }
  .h-raton::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 6px;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: rgb(255 255 255 / .6);
    animation: h-rueda 1.8s ease-in-out infinite;
  }
  @keyframes h-rueda { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(8px); } }

  @media (prefers-reduced-motion: reduce) {
    .h-cinta { animation: none; }
  }
</style>
