---
import Escala from '../marcos/Escala.astro'
import { Image } from 'astro:assets'
import { capturaTema } from '../../data/capturas'
import type { IdTema } from '../../data/oferta'
import TiendaGenerica from '../replicas/paginas/TiendaGenerica.astro'

/**
 * Intro a pantalla completa, en la misma noche que la portada: una frase, otra, caen tres tiendas
 * iguales (la de las apps de pedidos), se dan vuelta y quedan tres temas de Piru, la última frase
 * y la capa se desvanece sobre la portada, que arranca su animación (`html.intro-fin`).
 * Todo es CSS con retrasos; el script sólo la saltea (clic, Enter, Espacio o Esc) y la saca al
 * terminar. Sale en cada carga y arranca recién cuando está la Open Runde en negrita (si no, la
 * primera frase se ve en la fuente de respaldo y cambia). Sin JS o con movimiento reducido no aparece.
 */
const primera = 'Cuidaste cada detalle de tu marca'
const lineas = [
  { texto: 'Pero online, tu tienda es igual a la de todos', acento: 'igual', inicio: 2.3, fin: 4.3 },
  { texto: 'Ahora puede tener tu diseño', subrayado: 'diseño', inicio: 7.2, fin: 9.1 },
]
const cartas = [
  { tema: 'tarascon' as IdTema, generica: { nombre: 'Lo de Tito', rubro: 'Hamburguesas', categoria: 0 }, x: -170, y: -6, r: -7, xm: -60, ym: -26 },
  { tema: 'elegante' as IdTema, generica: { nombre: 'Napoli', rubro: 'Pizzería', categoria: 1 }, x: 170, y: 10, r: 6, xm: 60, ym: 4 },
  { tema: 'calcomania' as IdTema, generica: { nombre: 'Doña Rosa', rubro: 'Empanadas', categoria: 2 }, x: 0, y: 30, r: -1, xm: 0, ym: 34 },
]
const limpia = (p: string) => p.replace(/[^\p{L}']/gu, '')
---

<div class="intro fixed inset-0 z-[70] cursor-pointer select-none overflow-hidden bg-[#0E0B09] text-[#FFF8EF]">
  <div aria-hidden="true" class="i-contenido absolute inset-0 grid place-items-center px-6 text-center [perspective:900px]">
    <div class="i-brillo pointer-events-none absolute inset-0" />
    <p class="i-frase i-hola col-start-1 row-start-1 max-w-[14ch] text-[2.6rem] font-bold leading-[.98] tracking-[-.04em] sm:text-6xl lg:text-7xl">
      {primera.split(' ').map((p, i) => <><span class="i-palabra" style={`--d:${0.15 + i * 0.07}s`}>{p}</span>{' '}</>)}
    </p>

    {lineas.map((l) => (
      <p class="i-frase col-start-1 row-start-1 max-w-[15ch] text-[2.3rem] font-bold leading-[1] tracking-[-.04em] sm:text-6xl lg:text-7xl" style={`--fin:${l.fin}s`}>
        {l.texto.split(' ').map((p, i) => (
          <><span class:list={['i-palabra relative', limpia(p) === l.acento && 'text-[#FF8A1A]']} style={`--d:${l.inicio + i * 0.05}s`}>{p}{limpia(p) === l.subrayado && <span class="i-subrayado absolute inset-x-0 -bottom-[.04em] h-[.1em] rounded-full bg-[#FF8A1A]" />}</span>{' '}</>
        ))}
      </p>
    ))}

    <div class="i-pila relative col-start-1 row-start-1 h-[72vh] w-full max-w-xl">
      {cartas.map((c, i) => (
        <figure class="i-carta absolute left-1/2 top-1/2 m-0 w-[min(56vw,250px,40vh)] overflow-hidden rounded-[22px] bg-black shadow-[0_30px_80px_rgb(0_0_0/.6)] ring-1 ring-white/10" style={`--x:${c.x}px;--y:${c.y}px;--xm:${c.xm}px;--ym:${c.ym}px;--r:${c.r}deg;--d:${4.5 + i * 0.28}s;--v:${5.9 + i * 0.22}s`}>
          <Image src={capturaTema(c.tema)} alt="" width={300} loading="eager" class="block aspect-[390/700] w-full object-cover object-top" />
          <div class="i-generica absolute inset-0">
            <Escala ancho={390} alto={700} etiqueta="" class="i-pagina">
              <TiendaGenerica {...c.generica} />
            </Escala>
          </div>
        </figure>
      ))}
    </div>
  </div>
  <button type="button" class="i-saltar absolute bottom-5 right-5 rounded-full px-3 py-1.5 text-[13px] font-medium text-white/50 hover:text-white">Saltar</button>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('.intro')
  const raiz = document.documentElement
  const fin = () => raiz.classList.add('intro-fin')
  if (intro && getComputedStyle(intro).display !== 'none') {
    raiz.style.overflow = 'hidden'
    // Las animaciones esperan a la fuente (con tope, por si tarda).
    const fuente = document.fonts?.load('700 1em "Open Runde"') ?? Promise.resolve()
    Promise.race([fuente, new Promise((r) => setTimeout(r, 1500))]).then(() => {
      intro.classList.add('lista')
      setTimeout(terminar, 11500)
    })

    let terminada = false
    const terminar = () => {
      if (terminada) return
      terminada = true
      raiz.style.overflow = ''
      intro.remove()
      removeEventListener('keydown', tecla)
    }
    const saltar = () => intro.classList.add('saltar', 'lista')
    const tecla = (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Escape') { e.preventDefault(); saltar() }
    }
    intro.addEventListener('pointerdown', saltar)
    addEventListener('keydown', tecla)
    intro.addEventListener('animationstart', (e) => {
      if (e.animationName === 'i-se-va' && e.target === intro) fin()
    })
    intro.addEventListener('animationend', (e) => {
      if (e.animationName === 'i-se-va' && e.target === intro) terminar()
    })
  } else {
    fin()
  }
</script>

<style>
  .intro { display: none; }
  :global(html.js) .intro { display: block; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .intro { display: none; }
  }
  /* Quieta (y con las palabras ocultas) hasta que carga la fuente. */
  .intro:not(.lista) *, .intro:not(.lista) { animation-play-state: paused !important; }

  .i-pagina { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; font-feature-settings: "cv11", "ss01"; }

  .i-brillo {
    background: radial-gradient(50rem 30rem at 50% 60%, rgb(255 122 0 / .16), transparent 70%);
    opacity: 0;
    animation: i-aparece 1.2s ease 5.8s forwards;
  }

  .i-palabra {
    display: inline-block;
    animation: i-palabra .6s cubic-bezier(.16, 1, .3, 1) var(--d) both;
  }
  .i-hola { animation: i-fuera .3s cubic-bezier(.32, 0, .67, 0) 1.8s forwards; }
  .i-frase:not(.i-hola) { animation: i-fuera .28s cubic-bezier(.32, 0, .67, 0) var(--fin) forwards; }
  .i-subrayado {
    transform: scaleX(0);
    transform-origin: left;
    animation: i-subraya .3s cubic-bezier(.65, 0, .35, 1) 7.8s forwards;
  }

  .i-pila {
    animation:
      i-pila .6s cubic-bezier(.65, 0, .35, 1) 7s forwards,
      i-pila-sale .45s cubic-bezier(.32, 0, .67, 0) 8.9s forwards;
  }
  .i-carta {
    --tx: var(--x);
    --ty: var(--y);
    animation: i-carta .45s cubic-bezier(.34, 1.8, .64, 1) var(--d) both;
  }
  /* La tienda igual a todas se corre hacia arriba y deja ver el diseño propio. */
  .i-generica { animation: i-revela .55s cubic-bezier(.76, 0, .24, 1) var(--v) forwards; }
  @media (max-width: 639px) {
    .i-carta { --tx: var(--xm); --ty: var(--ym); }
  }

  .intro.lista { animation: i-se-va .8s cubic-bezier(.65, 0, .35, 1) 9.1s forwards; }

  /* Saltear: se va todo ya. */
  .saltar .i-contenido, .saltar .i-saltar { opacity: 0; transition: opacity .2s; }
  .intro.saltar { animation: i-se-va .5s cubic-bezier(.65, 0, .35, 1) .05s forwards; }

  @keyframes i-palabra {
    from { opacity: 0; transform: translateY(46px) rotateX(-45deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes i-fuera {
    to { opacity: 0; transform: translateY(-30px) scale(.94); visibility: hidden; }
  }
  @keyframes i-aparece { to { opacity: 1; } }
  @keyframes i-subraya { to { transform: scaleX(1); } }
  @keyframes i-revela { to { clip-path: inset(0 0 100% 0); } }
  @keyframes i-carta {
    from { opacity: 0; transform: translate(-50%, -50%) translate(var(--tx), calc(var(--ty) + 50px)) rotate(calc(var(--r) + 16deg)) scale(1.55); }
    to { opacity: 1; transform: translate(-50%, -50%) translate(var(--tx), var(--ty)) rotate(var(--r)); }
  }
  @keyframes i-pila {
    to { transform: translateY(40vh) scale(.42) rotate(-6deg); }
  }
  @keyframes i-pila-sale {
    from { transform: translateY(40vh) scale(.42) rotate(-6deg); }
    to { transform: translateY(90vh) scale(.42) rotate(-6deg); opacity: 0; }
  }
  @keyframes i-se-va { to { opacity: 0; visibility: hidden; } }
</style>
