<script is:inline>
window.PIRU = {"logo": "/piru/logo.jpg", "foxWhite": "/piru/fox-white.png", "menu_light": "/piru/menu-light.jpg", "menu_dark": "/piru/menu-dark.jpg", "options_light": "/piru/options-light.jpg", "options_dark": "/piru/options-dark.jpg", "datos_light": "/piru/datos-light.jpg", "datos_dark": "/piru/datos-dark.jpg", "amigos_light": "/piru/amigos-light.jpg", "amigos_dark": "/piru/amigos-dark.jpg", "transfer_light": "/piru/transfer-light.jpg", "transfer_dark": "/piru/transfer-dark.jpg"};
(function(){
  var P=window.PIRU;
  var nl=document.getElementById('navlogo');if(nl)nl.src=P.logo;
  var mnl=document.getElementById('mnavlogo');if(mnl)mnl.src=P.logo;
  var fl=document.getElementById('footlogo');if(fl)fl.src=P.foxWhite;
  var f2=document.getElementById('fox2');if(f2)f2.src=P.foxWhite;
  var wav=document.getElementById('wa-av');if(wav)wav.src=P.logo;
  var fll=document.getElementById('flyerlogo');if(fll)fll.src=P.logo;
  var mode='dark';
  function paint(){document.querySelectorAll('img[data-shot]').forEach(function(img){var k=img.getAttribute('data-shot')+'_'+mode;if(P[k])img.src=P[k]})}
  paint();
  var tg=document.getElementById('toggle');
  if(tg){
    tg.querySelectorAll('button').forEach(function(b){b.addEventListener('click',function(){mode=b.getAttribute('data-mode');tg.querySelectorAll('button').forEach(function(x){x.classList.remove('active','lightmode')});b.classList.add('active');if(mode==='light')b.classList.add('lightmode');paint()})});
  }
  var nav=document.getElementById('nav'),prog=document.getElementById('progress'),px=document.getElementById('parallax');
  function onScroll(){
    var y=window.scrollY;
    if(nav)nav.classList.toggle('scrolled',y>20);
    var h=document.body.scrollHeight-innerHeight;
    if(prog)prog.style.width=(h>0?(y/h*100):0)+'%';
    if(px&&y<900)px.style.transform='translateY('+(y*-0.05)+'px)';
  }
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.14});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});

  // --- Flyer descargable de la suscripción y los módulos ---
  var H2C_SRC='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  function ensureH2C(){
    return new Promise(function(res,rej){
      if(window.html2canvas)return res(window.html2canvas);
      var s=document.createElement('script');s.src=H2C_SRC;s.async=true;
      s.onload=function(){res(window.html2canvas)};
      s.onerror=function(){rej(new Error('no se pudo cargar html2canvas'))};
      document.head.appendChild(s);
    });
  }
  var shareBtn=document.getElementById('shareFlyer');
  if(shareBtn){
    shareBtn.addEventListener('click',function(){
      var original=shareBtn.innerHTML;
      shareBtn.disabled=true;shareBtn.textContent='Generando resumen…';
      ensureH2C().then(function(h2c){
        var flyer=document.getElementById('flyer');
        return h2c(flyer,{scale:2.5,backgroundColor:null,useCORS:true,logging:false});
      }).then(function(canvas){
        return new Promise(function(res){canvas.toBlob(function(b){res(b)},'image/png')});
      }).then(function(blob){
        var file=new File([blob],'piru-suscripcion-y-modulos.png',{type:'image/png'});
        if(navigator.canShare&&navigator.canShare({files:[file]})){
          return navigator.share({files:[file],title:'Suscripción y módulos de Piru',text:'La suscripción y los módulos de Piru'}).catch(function(){});
        }
        var a=document.createElement('a');var url=URL.createObjectURL(blob);a.href=url;a.download='piru-suscripcion-y-modulos.png';
        document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url)},4000);
      }).catch(function(err){
        console.error(err);
        alert('No se pudo generar el resumen. Probá de nuevo en un momento.');
      }).then(function(){
        shareBtn.disabled=false;shareBtn.innerHTML=original;
      });
    });
  }
})();
</script>
