---
import Base from '../layouts/Base.astro'
import Hero from '../components/secciones/Hero.astro'
import Paginas from '../components/secciones/Paginas.astro'
import Caminos from '../components/secciones/Caminos.astro'
import Plantillas from '../components/secciones/Plantillas.astro'
import Editor from '../components/secciones/Editor.astro'
import Motor from '../components/secciones/Motor.astro'
import Modulos from '../components/secciones/Modulos.astro'
import Panel from '../components/secciones/Panel.astro'
import Marketing from '../components/secciones/Marketing.astro'
import Precios from '../components/secciones/Precios.astro'
import Empezar from '../components/secciones/Empezar.astro'
import Preguntas from '../components/secciones/Preguntas.astro'
import CtaFinal from '../components/secciones/CtaFinal.astro'

/**
 * La home le habla al dueño del local y abre con lo principal: la página propia del local, con un
 * diseño que no es el de todos (docs/ENFOQUE_PAGINAS.md). Primero la página (portada, páginas
 * publicadas, cómo hacerla, plantillas y editor); después lo que Piru pone debajo (la compra, los
 * módulos y el panel) y, en segundo plano, los clientes y el marketing. Al final, precios, cómo
 * empezar y preguntas. Los marketers tienen su página en /marketers; los links que comparten,
 * /locales?ref=…, llegan acá con el código (pages/locales.astro y layouts/Base.astro).
 */
---

<Base
  pagina="locales"
  canonical="/"
  titulo="Piru · La página propia de tu local gastronómico, con pedidos, cobros y todo tu local"
  descripcion="Piru es la plataforma para vender online de los locales gastronómicos. Diseñá tu página con una plantilla, a tu gusto o con nuestra ayuda, con tu dominio. Debajo ya funcionan la carta, los pedidos a tu WhatsApp, los cobros, el punto de venta, las mesas y tus clientes. Sin comisión por venta."
>
  <Hero />
  <Paginas />
  <Caminos />
  <Plantillas />
  <Editor />
  <Motor />
  <Modulos />
  <Panel />
  <Marketing />
  <Precios />
  <Empezar />
  <Preguntas />
  <CtaFinal />
</Base>
