---
import Icon from '../../ui/Icon.astro'
import Barra from './Barra.astro'
import type { NombreIcono } from '../../ui/lucide'
import { METRICAS } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

/** Réplica de Estadísticas (admin/src/pages/Metricas.tsx, panel `MetricasPanel`). */
interface Props {
  compacta?: boolean
}

const { compacta = true } = Astro.props
const pildora = 'inline-flex h-9 items-center gap-1.5 rounded-full bg-white px-3.5 text-xs font-medium'
---

<div class="flex h-full w-full bg-[#FFFBF0] text-foreground">
  <Barra activo="estadisticas" compacta={compacta} />

  <div class="min-w-0 flex-1 overflow-hidden">
    <div class="flex items-center justify-center gap-2 px-6 pb-2 pt-6">
      <span class="inline-flex h-9 items-center gap-2 rounded-full bg-brand px-4 text-sm font-medium text-white shadow-sm shadow-brand/25"><Icon name="trending-up" class="size-4" />Estadísticas</span>
      <span class="inline-flex h-9 items-center gap-2 rounded-full bg-white px-4 text-sm font-medium text-muted-foreground"><Icon name="truck" class="size-4" />Repartidores</span>
    </div>

    <div class="mx-auto w-full max-w-3xl space-y-5 px-6 py-6">
      <div class="flex justify-center gap-2">
        <span class={pildora}>Por mes <Icon name="chevron-down" class="size-3.5 opacity-50" /></span>
        <span class={pildora}>Septiembre <Icon name="chevron-down" class="size-3.5 opacity-50" /></span>
        <span class={pildora}>2026 <Icon name="chevron-down" class="size-3.5 opacity-50" /></span>
      </div>

      <div class="pb-4 pt-2 text-center">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">Facturado · {METRICAS.periodo}</p>
        <p class="mt-3 text-6xl font-semibold tabular-nums tracking-tight">{pesos(METRICAS.facturado)}</p>
        <p class="mt-3 text-sm text-muted-foreground">{METRICAS.pedidos} pedidos · ticket promedio <span class="font-medium text-foreground">{pesos(METRICAS.ticket)}</span></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-white p-5">
          <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Cómo te pagaron</p>
          <div class="space-y-3">
            {METRICAS.pagos.map((p) => (
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-medium">{p.nombre}</span>
                <span class="flex items-baseline gap-2.5">
                  <span class="text-sm font-semibold tabular-nums">{pesos(p.monto)}</span>
                  <span class="w-9 text-right text-xs tabular-nums text-muted-foreground">{p.pct}%</span>
                </span>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-2xl bg-white p-5">
          <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Origen de las ventas</p>
          <div class="space-y-4">
            {METRICAS.origen.map((o) => (
              <div class="flex items-center gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#FFFBF0] text-brand"><Icon name={o.icono as NombreIcono} class="size-4" /></span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium">{o.nombre}</p>
                  <p class="text-xs tabular-nums text-muted-foreground">{o.detalle}</p>
                </div>
                <span class="text-base font-semibold tabular-nums">{pesos(o.monto)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-white p-5">
        <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Los más pedidos</p>
        <div class="divide-y divide-border">
          {METRICAS.top.map((t, i) => (
            <div class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
              <span class="w-5 shrink-0 text-sm font-semibold tabular-nums text-muted-foreground">{i + 1}</span>
              <span class="min-w-0 flex-1 truncate text-sm font-medium">{t.nombre}</span>
              <span class="shrink-0 text-xs tabular-nums text-muted-foreground">{t.unidades} u</span>
              <span class="w-24 shrink-0 text-right text-sm font-semibold tabular-nums">{pesos(t.total)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
