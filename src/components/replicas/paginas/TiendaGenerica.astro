---
import Icon from '../../ui/Icon.astro'
import { cargarFotos, type ClaveFoto } from '../../../data/fotos'
import { MENU } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

const FOTOS = await cargarFotos()

/**
 * La tienda que dan las apps de pedidos: la misma para todos los locales. Cambian el nombre, la
 * inicial y los productos; la portada, los colores, la letra y la carta son siempre iguales. No
 * copia ninguna app en particular: es el molde genérico que la intro y "El problema" ponen al lado
 * de las páginas con diseño propio. Va dentro de un celular (390 × 844).
 */
interface Props {
  nombre: string
  rubro: string
  /** Índice de la categoría de MENU que se ve primero. */
  categoria?: number
}

const { nombre, rubro, categoria = 0 } = Astro.props
const productos = MENU[categoria].productos.slice(0, 4)
const inicial = nombre.replace(/^(Lo de|La|El)\s+/i, '').charAt(0)
---

<div class="relative h-full w-full overflow-hidden bg-[#f4f4f5] font-[Inter,sans-serif] text-[#18181b]">
  <div class="h-[150px] bg-[#d4d4d8]" />
  <div class="-mt-10 px-5">
    <span class="grid size-20 place-items-center rounded-full border-4 border-[#f4f4f5] bg-[#a1a1aa] text-[30px] font-bold text-white">{inicial}</span>
    <p class="mt-3 text-[22px] font-bold tracking-[-0.01em]">{nombre}</p>
    <p class="mt-0.5 text-[13px] text-[#71717a]">{rubro} · Abierto</p>
    <div class="mt-4 flex h-11 items-center gap-2 rounded-xl bg-white px-3.5 text-[14px] text-[#a1a1aa] ring-1 ring-[#e4e4e7]"><Icon name="search" class="size-4" />Buscar productos</div>
  </div>
  <div class="mt-4 flex gap-5 border-b border-[#e4e4e7] px-5 text-[13.5px] font-semibold text-[#71717a]">
    {MENU.slice(0, 3).map((c, i) => <span class:list={['pb-2.5', i === categoria && 'border-b-2 border-[#18181b] text-[#18181b]']}>{c.categoria}</span>)}
  </div>
  <div class="divide-y divide-[#e4e4e7] bg-white">
    {productos.map((p) => (
      <div class="flex gap-3 px-5 py-4">
        <div class="min-w-0 flex-1">
          <p class="text-[15px] font-semibold">{p.nombre}</p>
          <p class="mt-1 line-clamp-2 text-[12.5px] leading-snug text-[#71717a]">{p.descripcion}</p>
          <p class="mt-2 text-[14px] font-semibold">{pesos(p.precio)}</p>
        </div>
        {p.foto && <img src={FOTOS[p.foto as ClaveFoto].chica} alt="" class="size-[76px] shrink-0 rounded-lg object-cover" />}
      </div>
    ))}
  </div>
  <div class="absolute inset-x-5 bottom-[104px] flex h-12 items-center justify-center rounded-xl bg-[#18181b] text-[14px] font-semibold text-white">Ver pedido</div>
</div>
