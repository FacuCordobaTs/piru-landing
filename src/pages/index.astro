---
// Piru — Tu canal de ventas propio: conseguí clientes nuevos y hacelos volver.
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Piru — Tu canal de ventas propio para conseguir clientes nuevos y hacerlos volver</title>
<meta name="description" content="Piru es tu tienda online propia, sin comisiones. Medís qué contenido te trae clientes de verdad y el motor de recompra te dice a quién escribirle, cuándo y qué decirle.">
<link rel="icon" type="image/jpeg" href="/piru/logo.jpg">
<link rel="apple-touch-icon" href="/piru/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --ink: #17130f;
  --ink-soft: #3d2f23;
  --ink-subtle: #675848;
  --paper: #fbf4ea;
  --orange: #ff8a00;
  --orange-deep: #e67500;
  --hl: #ffe08a;
  --line: #e7dac7;
  --line-strong: #d2c0a8;
  --muted: #8a7866;
  --maxw-text: 740px;
  --maxw-wide: 1060px;
  --ease: cubic-bezier(.22, .61, .36, 1);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
section[id] { scroll-margin-top: 84px; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.7;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5 {
  font-family: 'Fraunces', Georgia, serif;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 0;
}

p { margin: 0 0 1.5em; }
p:last-child { margin-bottom: 0; }
a { color: inherit; text-decoration: none; }

.wrap { max-width: var(--maxw-wide); margin: 0 auto; padding: 0 24px; }
.wrap-reading { max-width: var(--maxw-text); margin: 0 auto; padding: 0 24px; }

/* Resaltador amarillo: la marca de lectura de la página */
mark {
  background: var(--hl);
  color: var(--ink);
  padding: 0.05em 0.28em;
  border-radius: 0.28em;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* Barra superior de lectura */
#reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3.5px;
  width: 0%;
  background: linear-gradient(90deg, var(--orange), #ff5500);
  z-index: 100;
  transition: width .08s linear;
}

/* Botones */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6em;
  font-weight: 600;
  font-size: 15.5px;
  border-radius: 999px;
  padding: 13px 26px;
  cursor: pointer;
  border: 0;
  font-family: inherit;
  position: relative;
  overflow: hidden;
  transition: transform .2s var(--ease), background .25s, color .25s, border-color .25s;
  user-select: none;
}
.btn:active { transform: scale(0.98) translateY(1px); }
.btn-primary {
  background: var(--orange);
  color: #fff;
}
.btn-primary:hover {
  background: var(--orange-deep);
  transform: translateY(-1px);
}
.btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--line-strong);
}
.btn-ghost:hover {
  border-color: var(--ink);
  transform: translateY(-1px);
}
.btn-sm { padding: 8px 18px; font-size: 14px; }

/* Efecto Shimmer dinámico en hover */
.btn .sh {
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
  transform: translateX(-120%);
  pointer-events: none;
}
.btn:hover .sh {
  transform: translateX(120%);
  transition: transform 0.75s var(--ease);
}

/* Nav */
nav {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 60;
  backdrop-filter: blur(14px);
  background: rgba(251, 244, 234, 0.88);
  border-bottom: 1px solid transparent;
  transition: border-color .3s, background .3s;
}
nav.scrolled {
  border-color: var(--line);
  background: rgba(251, 244, 234, 0.96);
}
.nav-in {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Fraunces', serif;
  font-weight: 700;
  font-size: 23px;
  letter-spacing: -0.02em;
}
.brand img {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  display: block;
  transition: transform .35s var(--ease);
}
.brand:hover img { transform: rotate(-8deg) scale(1.06); }
.nav-links {
  display: flex;
  gap: 24px;
  align-items: center;
}
.nav-links a {
  font-size: 14.5px;
  font-weight: 500;
  color: var(--ink-soft);
  transition: color .2s;
}
.nav-links a:hover { color: var(--orange-deep); }
.nav-cta { display: flex; align-items: center; gap: 12px; }

@media(max-width: 940px) {
  .nav-links { display: none; }
}

/* Mobile floating bottom bar */
.mnav { display: none; }
@media(max-width: 940px) {
  nav { display: none; }
  .mnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    position: fixed;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 70;
    padding: 8px 10px 8px 18px;
    background: rgba(251, 244, 234, 0.92);
    backdrop-filter: blur(20px) saturate(1.7);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .mnav-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 20px;
  }
  .mnav-brand img { width: 30px; height: 30px; border-radius: 8px; }
  .mnav-actions { display: flex; align-items: center; gap: 8px; }
  .mnav-wa {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--line);
    color: #25d366;
  }
  .mnav-wa svg { width: 20px; height: 20px; }
}

/* Hero */
.hero-sec {
  padding: 132px 0 56px;
  text-align: center;
}
.hero-kicker {
  display: block;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--orange-deep);
  margin-bottom: 22px;
}
.hero-sec h1 {
  font-size: clamp(36px, 5.2vw, 60px);
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.12;
  max-width: 23ch;
  margin: 0 auto 22px;
}
.hero-sec h1 em {
  font-style: italic;
  color: var(--orange-deep);
  font-weight: 500;
}
.hero-sec .lead {
  font-size: clamp(17px, 1.9vw, 20px);
  color: var(--ink-soft);
  max-width: 46ch;
  margin: 0 auto 30px;
  line-height: 1.55;
}
.cta-group {
  display: flex;
  gap: 14px;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}
.hero-stats {
  display: flex;
  justify-content: center;
  max-width: 660px;
  margin: 44px auto 0;
  padding-top: 26px;
  border-top: 1px solid var(--line);
}
.hero-stat {
  flex: 1 1 0;
  min-width: 150px;
  padding: 0 16px;
  text-align: center;
}
.hero-stat + .hero-stat { border-left: 1px solid var(--line); }
.hero-stat b {
  display: block;
  font-family: 'Fraunces', serif;
  font-size: 26px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.15;
}
.hero-stat span {
  display: block;
  font-size: 13px;
  color: var(--muted);
  line-height: 1.4;
}

/* Cuerpo editorial */
.article-wrap { padding: 18px 0 70px; }
.prose {
  font-size: 17.5px;
  line-height: 1.78;
  color: var(--ink-soft);
}
.prose p { margin-bottom: 1.45em; }
.prose strong { color: var(--ink); font-weight: 600; }
.prose em { font-style: italic; }

/* Encabezado de sección */
.sec-head {
  margin: 54px 0 24px;
  padding-top: 26px;
  border-top: 1px solid var(--line);
}
.kicker {
  display: block;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--orange-deep);
  margin-bottom: 9px;
}
.sec-head h2 {
  font-size: clamp(27px, 3.6vw, 38px);
  margin-bottom: 12px;
}
.sec-head .sec-sub {
  font-size: 16.5px;
  color: var(--ink-soft);
  margin: 0;
  max-width: 62ch;
}

/* Renglones: el reemplazo de las tarjetas */
.rows {
  margin: 28px 0 30px;
}
.rows .row {
  display: grid;
  grid-template-columns: 186px 1fr;
  gap: 24px;
  align-items: baseline;
  padding: 15px 0;
  border-top: 1px solid var(--line);
}
.rows .row:last-child { border-bottom: 1px solid var(--line); }
.rows dt {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1.6;
}
.rows dd {
  margin: 0;
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--ink-soft);
}
.rows dd b { color: var(--ink); font-weight: 600; }
.rows dd .val {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  color: var(--ink);
}

/* Lista numerada editorial */
.steps {
  list-style: none;
  counter-reset: step;
  margin: 28px 0 30px;
  padding: 0;
}
.steps > li {
  counter-increment: step;
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 18px;
  padding: 18px 0;
  border-top: 1px solid var(--line);
}
.steps > li:last-child { border-bottom: 1px solid var(--line); }
.steps > li::before {
  content: counter(step, decimal-leading-zero);
  font-family: 'Fraunces', serif;
  font-size: 24px;
  line-height: 1.2;
  color: var(--orange);
}
.steps h4 { font-size: 18.5px; margin-bottom: 6px; }
.steps p {
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--ink-soft);
  margin: 0;
}
.steps p b { color: var(--ink); font-weight: 600; }

/* Frase destacada */
.pullquote {
  margin: 44px 0;
  text-align: center;
}
.pullquote::before {
  content: "";
  display: block;
  width: 44px;
  height: 1px;
  background: var(--line-strong);
  margin: 0 auto 24px;
}
.pullquote p {
  font-family: 'Fraunces', serif;
  font-size: clamp(20px, 2.4vw, 25px);
  font-weight: 500;
  line-height: 1.4;
  color: var(--ink);
  max-width: 38ch;
  margin: 0 auto;
}
.pullquote b { font-weight: 700; }

/* El mensaje, como cita editorial */
.msg {
  margin: 34px 0;
  padding: 24px 0;
  border-top: 1px solid var(--line-strong);
  border-bottom: 1px solid var(--line-strong);
}
.msg-label {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: var(--orange-deep);
  margin-bottom: 16px;
}
.msg blockquote {
  margin: 0;
  padding-left: 22px;
  border-left: 1px solid var(--line-strong);
}
.msg blockquote p {
  font-size: 16.5px;
  line-height: 1.6;
  color: var(--ink);
  margin: 0 0 12px;
}
.msg blockquote p:last-child { margin-bottom: 0; }
.msg blockquote b { font-weight: 700; }
.msg-cap {
  margin-top: 16px;
  font-size: 13px;
  line-height: 1.55;
  color: var(--muted);
}
.msg-cap em { font-style: italic; color: var(--ink-soft); }

/* Nota al pie de sección */
.footnote {
  font-size: 15px;
  line-height: 1.65;
  color: var(--ink-soft);
  margin: 22px 0 0;
}
.footnote b { color: var(--ink); font-weight: 600; }

/* CTA en banda, sin caja */
.cta-band {
  margin: 54px 0;
  padding: 32px 0;
  border-top: 1px solid var(--line-strong);
  border-bottom: 1px solid var(--line-strong);
  text-align: center;
}
.cta-band h4 { font-size: 22px; margin-bottom: 8px; }
.cta-band p {
  font-size: 15px;
  color: var(--ink-soft);
  max-width: 54ch;
  margin: 0 auto 20px;
  line-height: 1.55;
}

/* Ya trabajan con Piru */
.clients {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin: 30px 0 34px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.client {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 32px 24px;
  text-align: center;
  transition: transform .2s var(--ease);
}
.client + .client { border-left: 1px solid var(--line); }
.client:hover { transform: translateY(-2px); }
.client img {
  height: 104px;
  width: auto;
  max-width: 100%;
  display: block;
}
.client-name {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}
.client-url {
  font-size: 13px;
  color: var(--muted);
  transition: color .2s;
}
.client:hover .client-url { color: var(--orange-deep); }

/* Precio base */
.price-base {
  margin: 34px 0 26px;
  padding: 34px 0;
  border-top: 1px solid var(--line-strong);
  border-bottom: 1px solid var(--line-strong);
  text-align: center;
}
.price-base .p-tag {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--orange-deep);
}
.price-base .p-price {
  font-family: 'Fraunces', serif;
  font-size: clamp(46px, 6vw, 62px);
  line-height: 1;
  color: var(--ink);
  margin: 14px 0 14px;
}
.price-base .p-price small {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  color: var(--muted);
  font-weight: 500;
}
.price-base .p-desc {
  font-size: 16px;
  color: var(--ink-soft);
  max-width: 54ch;
  margin: 0 auto 24px;
  line-height: 1.55;
}

/* Módulo */
.module-block {
  margin: 36px 0 26px;
  padding-top: 26px;
  border-top: 1px solid var(--line-strong);
}
.module-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 18px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.module-head h3 { font-size: clamp(23px, 3vw, 30px); }
.module-price {
  font-family: 'Fraunces', serif;
  font-size: 26px;
  font-weight: 600;
  color: var(--orange-deep);
  white-space: nowrap;
}
.module-price small {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: var(--muted);
  font-weight: 500;
}
.module-desc {
  font-size: 16.5px;
  line-height: 1.6;
  color: var(--ink-soft);
  max-width: 62ch;
  margin: 0;
}
.feature-list {
  list-style: none;
  margin: 22px 0 0;
  padding: 0;
}
.feature-list li {
  padding: 14px 0;
  border-top: 1px solid var(--line);
  font-size: 16px;
  line-height: 1.6;
  color: var(--ink-soft);
}
.feature-list li:last-child { border-bottom: 1px solid var(--line); }
.feature-list b { color: var(--ink); font-weight: 600; }
.module-note {
  font-size: 13.5px;
  color: var(--muted);
  line-height: 1.6;
  margin: 16px 0 0;
}

/* Addon */
.addon-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}
.addon-row h5 { font-size: 17px; margin-bottom: 4px; }
.addon-row p {
  font-size: 14.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.5;
  max-width: 62ch;
}
.addon-row .price-tag {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  color: var(--orange-deep);
  white-space: nowrap;
  flex: 0 0 auto;
}
.addon-row .price-tag small {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: var(--muted);
}

/* Lista de features en línea */
.tags-inline {
  font-size: 14px;
  line-height: 2.1;
  color: var(--ink-soft);
  margin: 20px 0 24px;
}
.tags-inline span { font-weight: 600; }
.tags-inline span + span::before {
  content: "·";
  color: var(--line-strong);
  margin: 0 10px;
  font-weight: 400;
}

/* Facundo */
.facundo { margin-top: 28px; }
.facundo h5 { font-size: 19px; margin-bottom: 8px; }
.facundo p { font-size: 15.5px; color: var(--ink-soft); line-height: 1.7; margin-bottom: 18px; }
.facundo p strong { color: var(--ink); font-weight: 600; }

/* Footer */
footer {
  background: #ff7200;
  color: #fff;
  padding: 48px 24px 40px;
  margin-top: 40px;
}
.foot-in {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  align-items: center;
}
.foot-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-family: 'Fraunces', serif;
  font-weight: 700;
  font-size: 21px;
}
.foot-brand img { width: 32px; height: 32px; }
.foot-links {
  display: flex;
  gap: 22px;
  font-size: 14px;
  flex-wrap: wrap;
}
.foot-links a { color: rgba(255, 255, 255, 0.92); }
.foot-links a:hover { color: #0a0a0a; }
.foot-fine {
  margin-top: 22px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
  border-top: 1px solid rgba(255, 255, 255, 0.28);
  padding-top: 16px;
}

@media(max-width: 640px) {
  .rows .row { grid-template-columns: 1fr; gap: 5px; }
  .steps > li { grid-template-columns: 36px 1fr; gap: 14px; }
  .hero-stats { flex-direction: column; margin-top: 36px; }
  .hero-stat { padding: 16px 0; min-width: 0; }
  .hero-stat + .hero-stat { border-left: 0; border-top: 1px solid var(--line); }
  .addon-row { flex-direction: column; align-items: flex-start; gap: 8px; }
  .msg blockquote { padding-left: 16px; }
  .clients { grid-template-columns: 1fr; }
  .client + .client { border-left: 0; border-top: 1px solid var(--line); }
}
</style>
</head>

<body>
<div id="reading-progress"></div>

<!-- NAVIGATION -->
<nav id="nav">
  <div class="wrap nav-in">
    <a class="brand" href="#top">
      <img id="navlogo" alt="Piru">
      Piru
    </a>
    <div class="nav-links">
      <a href="#canal">Tu canal</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#datos">Tus clientes</a>
      <a href="#recompra">Recompra</a>
      <a href="#precio">Precios</a>
    </div>
    <div class="nav-cta">
      <a class="btn btn-primary btn-sm" href="https://wa.me/543408681915" target="_blank" rel="noopener">
        <span class="sh"></span>Hablar por WhatsApp
      </a>
    </div>
  </div>
</nav>

<!-- MOBILE BOTTOM NAV -->
<div class="mnav">
  <a class="mnav-brand" href="#top">
    <img id="mnavlogo" alt="Piru">
    Piru
  </a>
  <div class="mnav-actions">
    <a class="mnav-wa" href="https://wa.me/543408681915" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3 0-1.5.7-2.2 1-2.5.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5-.3.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6 0l.9-1c.2-.2.4-.2.6-.1l1.9.9c.3.1.5.2.5.4.1.1.1.6-.1 1.3Z"/></svg>
    </a>
    <a class="btn btn-primary btn-sm" href="https://wa.me/543408681915" target="_blank" rel="noopener">
      <span class="sh"></span>Hablar por WhatsApp
