---
import Escena from './Escena.astro'
import Icon from '../ui/Icon.astro'
import { CAMPANAS, ORGANICO } from '../../data/demo'
import { pesos } from '../../data/oferta'

/**
 * Una historia con el sticker «Pedí acá»: el pedido que entra por ese link suma en el ranking de
 * campañas, ordenado por ventas cobradas, con el orgánico como línea de base. Es la escena
 * LinkMedido de la guía de Marketing del panel, con los datos de la landing.
 */
// Los nombres, cortos para que entren en la tarjeta.
const CORTOS: Record<string, string> = { 'finde-smash': 'Historia del finde', bolsas: 'QR en las bolsas', juli: 'Reseña de Juli' }
const filas = [...CAMPANAS]
  .sort((a, b) => b.ventas - a.ventas)
  .slice(0, 3)
  .map((c) => ({ ...c, nombre: CORTOS[c.slug] ?? c.nombre }))
const max = filas[0].ventas
// Del sticker de la historia a la fila de su campaña en el ranking.
const RUTA = 'M 150 224 C 180 224, 172 96, 200 92'
const viaje = `--ruta:path("${RUTA}");--t:2.8s;--d:1100ms`
---

<Escena
  ancho={460}
  alto={330}
  etiqueta={`Una historia de Instagram con el link «Pedí acá». El pedido que entra por ese link suma en el ranking de campañas, ordenado por ventas cobradas: ${filas.map((f) => `${f.nombre}, ${pesos(f.ventas)}`).join('; ')}. Abajo, lo que se vendió sin campaña.`}
>
  <div class="e-izquierda absolute left-[18px] top-[18px] h-[294px] w-[152px] overflow-hidden rounded-[26px] bg-[linear-gradient(165deg,#8a3448,#4a1a26_58%,#2a0f16)] text-white shadow-[0_24px_40px_-18px_rgb(40_10_15/.7)]">
    <div class="absolute inset-x-3 top-3 flex gap-1">
      <span class="h-[2.5px] flex-1 rounded-full bg-white" />
      <span class="h-[2.5px] flex-1 overflow-hidden rounded-full bg-white/35"><span class="block h-full w-3/5 bg-white" /></span>
      <span class="h-[2.5px] flex-1 rounded-full bg-white/35" />
    </div>
    <div class="absolute inset-x-3 top-[16px] flex items-center gap-1.5">
      <span class="grid size-6 place-items-center rounded-full bg-[#7A2E3F] ring-[1.5px] ring-white/90"><Icon name="flame" class="size-3" stroke={2.4} /></span>
      <span class="text-[10.5px] font-semibold">brasa.burgers</span>
      <span class="text-[10px] text-white/65">2 h</span>
    </div>
    <div class="absolute inset-x-0 top-[86px] flex flex-col items-center gap-1.5 px-3 text-center">
      <span class="rotate-[-3deg] rounded-[8px] bg-white px-2 py-1 text-[17px] font-black leading-none tracking-[-0.04em] text-[#7A2E3F]">FINDE DE SMASH</span>
      <span class="rotate-[-3deg] rounded-[6px] bg-[#F4EDE4] px-2 py-0.5 text-[11px] font-bold text-[#7A2E3F]">Sábado y domingo</span>
    </div>
    <div class="absolute inset-x-0 top-[192px] flex justify-center">
      <span class="relative flex rotate-[2deg] items-center gap-1.5 rounded-[10px] bg-white px-3 py-2 shadow-[0_10px_24px_rgb(0_0_0/.35)]">
        <span class="e-latido absolute inset-0 rounded-[10px]" />
        <Icon name="link" class="size-3.5 text-[#3797F0]" stroke={2.6} />
        <span class="text-[13px] font-extrabold uppercase tracking-tight text-[#3797F0]">Pedí acá</span>
      </span>
    </div>
    <div class="absolute inset-x-3 bottom-3 flex h-8 items-center rounded-full border border-white/55 px-3 text-[11px] text-white/85">Enviar mensaje</div>
  </div>

  <svg class="absolute inset-0" width="460" height="330" viewBox="0 0 460 330" fill="none" aria-hidden="true">
    <path d={RUTA} stroke="#FF7A00" stroke-width="2" stroke-linecap="round" opacity=".6" class="e-hormigas" />
  </svg>
  <span class="e-viaja absolute left-0 top-0 size-3 rounded-full bg-brand shadow-[0_0_0_5px_rgb(255_122_0/.22)]" style={viaje} />

  <div class="e-derecha e-tarjeta absolute left-[196px] top-[22px] w-[248px] p-4" style="--d:250ms">
    <div class="flex items-center justify-between">
      <p class="text-[10.5px] font-semibold uppercase tracking-[.08em] text-ink-3">Campañas · 30 días</p>
      <p class="text-[10.5px] text-ink-3">Ventas cobradas</p>
    </div>
    {filas.map((f, i) => (
      <div class="relative mt-3.5">
        <div class="flex items-baseline justify-between gap-2">
          <p class="truncate text-[12.5px] font-semibold text-ink">{f.nombre}</p>
          {i === 0
            ? <p class="shrink-0 text-[12.5px] font-bold tabular-nums text-ink" data-contar={f.ventas} data-formato="pesos" data-ms="1400" data-retraso="700">{pesos(f.ventas)}</p>
            : <p class="shrink-0 text-[12.5px] font-bold tabular-nums text-ink">{pesos(f.ventas)}</p>}
        </div>
        <div class="mt-1.5 h-[7px] rounded-full bg-sand">
          <div class="e-barra h-full rounded-full bg-brand" style={`width:${(f.ventas / max) * 100}%;--d:${550 + i * 160}ms`} />
        </div>
        <p class="mt-1 text-[10.5px] text-ink-3">{f.canal} · {f.pedidos} pedidos</p>
        {i === 0 && (
          <span class="e-llega absolute bottom-[-2px] right-0 rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm" style={viaje}>+1 pedido</span>
        )}
      </div>
    ))}
    <div class="e-aparece mt-3.5 flex items-baseline justify-between gap-2 border-t border-dashed border-line pt-3" style="--d:1150ms">
      <div>
        <p class="text-[12px] font-semibold text-ink-2">Orgánico · sin campaña</p>
        <p class="text-[10.5px] text-ink-3">Tu línea de base</p>
      </div>
      <p class="text-[12.5px] font-bold tabular-nums text-ink-2">{pesos(ORGANICO.ventas)}</p>
    </div>
  </div>
</Escena>
