---
import Logo from './ui/Logo.astro'
import Icon from './ui/Icon.astro'
import { CREAR_TIENDA, ENTRAR } from '../data/oferta'

const cta = { href: CREAR_TIENDA, largo: 'Crear tienda gratis', corto: 'Crear tienda' }
const SECCIONES = [
  { href: '/#locales', texto: 'Locales' },
  { href: '/#temas', texto: 'Temas' },
  { href: '/#todo', texto: 'Qué incluye' },
  { href: '/#precios', texto: 'Precios' },
]
const enlace = 'nav-enlace h-10 items-center rounded-full px-2 text-[14.5px] font-medium transition-colors sm:px-3.5'
---

<header id="nav" class="nav fixed inset-x-0 top-0 z-50">
  <nav class="contenedor flex h-[68px] items-center justify-between gap-3" aria-label="Principal">
    <a href="/" class="flex items-center gap-2.5 rounded-xl" aria-label="Piru, inicio">
      <Logo size={32} />
      <span class="nav-marca text-[21px] font-bold tracking-[-0.04em] transition-colors">Piru</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {SECCIONES.map((s) => <a href={s.href} class:list={[enlace, 'hidden lg:inline-flex']}>{s.texto}</a>)}
      <a href={ENTRAR} class:list={[enlace, 'hidden sm:inline-flex']}>Entrar</a>
      <a href={cta.href} class="boton boton-primario boton-chico">
        <Icon name="sparkles" class="size-[17px]" stroke={2.2} />
        <span class="hidden min-[440px]:inline">{cta.largo}</span>
        <span class="min-[440px]:hidden">{cta.corto}</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .nav { color: var(--color-ink); transition: background-color .25s, color .25s, box-shadow .25s; }
  .nav :global(.nav-enlace) { color: var(--color-ink-2); }
  .nav :global(.nav-enlace:hover) { color: var(--color-ink); background: rgb(25 21 18 / .05); }
  .nav.nav--scrolleado {
    background: rgb(255 252 247 / .85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(40 24 8 / .07);
  }
  /* Sobre las secciones oscuras (`data-oscuro`) el menú se oscurece. */
  .nav.nav--oscuro { color: #fff; }
  .nav.nav--oscuro :global(.nav-enlace) { color: rgb(255 255 255 / .72); }
  .nav.nav--oscuro :global(.nav-enlace:hover) { color: #fff; background: rgb(255 255 255 / .08); }
  .nav.nav--oscuro.nav--scrolleado { background: rgb(14 11 9 / .8); box-shadow: 0 1px 0 rgb(255 255 255 / .08); }
</style>

<script>
  // El menú se pinta según la sección que tiene debajo: una franja finita arriba, sin medir en cada cuadro.
  const nav = document.getElementById('nav')
  if (nav) {
    const oscuras = new Set<Element>()
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) e.isIntersecting ? oscuras.add(e.target) : oscuras.delete(e.target)
      nav.classList.toggle('nav--oscuro', oscuras.size > 0)
    }, { rootMargin: '0px 0px -96% 0px' })
    document.querySelectorAll('[data-oscuro]').forEach((el) => io.observe(el))
    const arriba = document.createElement('div')
    arriba.style.cssText = 'position:absolute;top:0;height:12px;width:1px;pointer-events:none'
    document.body.prepend(arriba)
    new IntersectionObserver(([e]) => nav.classList.toggle('nav--scrolleado', !e.isIntersecting)).observe(arriba)
  }
</script>
