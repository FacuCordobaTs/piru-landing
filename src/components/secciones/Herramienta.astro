---
import '../escenas/escenas.css'

/**
 * Una tarjeta de "Tu marketing": arriba la ilustración (slot `escena`) sobre el escenario arena de
 * las guías, abajo el nombre, una o dos líneas y, si hace falta, algo más (slot por defecto).
 * `horizontal` pone la ilustración a la izquierda en escritorio. Todas las herramientas vienen con
 * la suscripción, así que no llevan etiqueta de módulo.
 */
interface Props {
  titulo: string
  texto: string
  horizontal?: boolean
  /** Ancho máximo de la ilustración, en px. */
  anchoEscena?: number
  class?: string
}

const { titulo, texto, horizontal = false, anchoEscena = 480, class: className } = Astro.props
---

<article class:list={['revelar tarjeta flex flex-col overflow-hidden', horizontal && 'lg:flex-row', className]}>
  <div class:list={['escenario flex flex-1 items-center justify-center px-2 py-6 sm:px-6 sm:py-8', horizontal && 'lg:w-[56%] lg:flex-none lg:py-10']}>
    <div class="w-full" style={`max-width:${anchoEscena}px`}>
      <slot name="escena" />
    </div>
  </div>
  <div class:list={['flex flex-col p-6 sm:p-7', horizontal && 'lg:flex-1 lg:justify-center lg:p-10']}>
    <h3 class="text-[20px] font-semibold leading-tight tracking-[-0.02em] text-ink sm:text-[21px]">{titulo}</h3>
    <p class="mt-2 text-[15.5px] leading-relaxed text-ink-2">{texto}</p>
    <slot />
  </div>
</article>
