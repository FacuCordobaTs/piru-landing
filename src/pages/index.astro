  function paint(){document.querySelectorAll('img[data-shot]').forEach(function(img){var k=img.getAttribute('data-shot')+'_'+mode;if(P[k])img.src=P[k]})}
  paint();
  var tg=document.getElementById('toggle');
  tg.querySelectorAll('button').forEach(function(b){b.addEventListener('click',function(){mode=b.getAttribute('data-mode');tg.querySelectorAll('button').forEach(function(x){x.classList.remove('active','lightmode')});b.classList.add('active');if(mode==='light')b.classList.add('lightmode');paint()})});
  var nav=document.getElementById('nav'),prog=document.getElementById('progress'),px=document.getElementById('parallax');
  function onScroll(){var y=window.scrollY;nav.classList.toggle('scrolled',y>20);var h=document.body.scrollHeight-innerHeight;prog.style.width=(h>0?(y/h*100):0)+'%';if(px&&y<900)px.style.transform='translateY('+(y*-0.05)+'px)'}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
