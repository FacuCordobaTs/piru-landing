---
import Icon from '../../ui/Icon.astro'
import { cargarFotos, type ClaveFoto } from '../../../data/fotos'
import { SALA } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

const FOTOS = await cargarFotos()

/**
 * Réplica de la sala del pedido en grupo (web/src/pages/Menu.tsx): quién está en el pedido,
 * el botón para invitar y el carrito compartido, con quién agregó cada cosa.
 */
interface Props {
  oscura?: boolean
}

const { oscura = false } = Astro.props
const fotos: Record<string, ClaveFoto | undefined> = {
  'Smash burger · Doble': 'smash',
  Cheeseburger: 'cheese',
  Napolitana: 'napolitana',
}
const filas = SALA.personas.map((p) => ({ persona: p.yo ? 'Tú' : p.nombre, yo: !!p.yo, item: p.items[0], mas: p.items.length - 1 }))
const total = SALA.personas.flatMap((p) => p.items).reduce((s, i) => s + i.precio, 0)
---

<div class:list={['tienda relative h-full w-full overflow-hidden bg-background text-foreground', oscura && 'tienda--oscura']}>
  <div class="space-y-4 px-5 pt-[70px]">
    <div class="px-1">
      <p class="mb-0.5 text-sm font-medium text-muted-foreground">Bienvenido,</p>
      <p class="text-3xl font-extrabold tracking-tight text-primary">{SALA.anfitrion}</p>
    </div>
    <div>
      <p class="mb-2 px-1 text-xs font-medium uppercase tracking-wide text-muted-foreground">En el pedido:</p>
      <div class="flex gap-4 py-1">
        {SALA.personas.map((p) => (
          <div class="flex min-w-[56px] flex-col items-center gap-1.5">
            {p.yo ? (
              <span class="flex size-12 items-center justify-center rounded-xl border-2 border-primary bg-primary text-sm font-bold text-primary-foreground shadow-sm ring-2 ring-background">YO</span>
            ) : (
              <span class="flex size-12 items-center justify-center rounded-xl border border-border bg-secondary text-xs font-medium text-foreground">{p.nombre.slice(0, 2).toUpperCase()}</span>
            )}
            <span class:list={['text-xs', p.yo ? 'font-medium' : 'text-muted-foreground']}>{p.yo ? 'Tú' : p.nombre}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="flex w-full items-center justify-center gap-2.5 rounded-xl border-2 border-dashed border-primary/30 px-4 py-3 text-sm font-semibold text-primary">
      <Icon name="share-2" class="size-4" />Invitá a tus amigos
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 top-[352px] z-10 flex flex-col rounded-t-3xl border-t border-border bg-background shadow-[0_-12px_40px_rgba(0,0,0,0.22)]">
    <div class="flex justify-center pb-1 pt-3"><span class="h-1.5 w-12 rounded-full bg-muted-foreground/30" /></div>
    <p class="pb-2 pt-1 text-center text-xl font-extrabold">Tu Pedido</p>
    <div class="space-y-2.5 px-5 pt-1">
      {filas.map((f) => {
        const clave = fotos[f.item.nombre]
        return (
          <div class:list={['flex gap-3 rounded-2xl border p-2.5', f.yo ? 'border-primary/20 bg-card shadow-sm' : 'border-transparent bg-secondary/30']}>
            <div class="size-12 shrink-0 overflow-hidden rounded-xl bg-secondary">
              {clave ? <img src={FOTOS[clave].chica} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" /> : <span class="flex h-full w-full items-center justify-center text-primary"><Icon name="utensils" class="size-5" /></span>}
            </div>
            <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
              <div class="min-w-0">
                <p class="truncate text-sm font-bold">{f.item.nombre}{f.mas > 0 && <span class="font-medium text-muted-foreground"> +{f.mas}</span>}</p>
                <span class:list={['mt-1 inline-flex h-5 items-center rounded-md px-1.5 text-[10px]', f.yo ? 'bg-indigo-100 text-indigo-700' : 'bg-secondary text-secondary-foreground']}>{f.persona}</span>
              </div>
              <span class="shrink-0 text-sm font-bold tabular-nums">{pesos(f.item.precio)}</span>
            </div>
          </div>
        )
      })}
    </div>
    <div class="mt-auto border-t border-border px-4 pb-[98px] pt-3">
      <div class="mb-3 flex items-center justify-between">
        <span class="text-sm text-muted-foreground">Total a pagar</span>
        <span class="text-2xl font-black tracking-tight">{pesos(total)}</span>
      </div>
      <div class="flex h-12 w-full items-center justify-center rounded-xl bg-primary text-base font-bold text-primary-foreground shadow-md">Continuar</div>
    </div>
  </div>
</div>
