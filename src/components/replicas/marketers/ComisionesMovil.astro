---
import Icon from '../../ui/Icon.astro'
import Monograma from './Monograma.astro'
import NavMovil from './NavMovil.astro'
import { CARTERA, COMISION_MES_ANTERIOR, comisionDe, TOTALES_CARTERA } from '../../../data/marketers'
import { COMISION_MARKETER, PRECIO_BASE, pesos } from '../../../data/oferta'

/**
 * App de marketers → Comisiones (docs/MVP_MARKETERS.md §4.5 y §5.3): una comisión por cada factura que
 * paga un local, sobre base + módulos y sin recargas. Los locales en prueba todavía no generan.
 */
const pagan = CARTERA.filter((l) => l.suscripcionMensual > 0).length
const plan = (mensual: number) => (mensual > PRECIO_BASE ? 'Base + Retención' : 'Base')
---

<div class="relative h-full w-full overflow-hidden bg-paper pt-[54px] text-ink">
  <div class="px-5 pt-3">
    <p class="text-[26px] font-bold leading-none tracking-[-0.035em]">Comisiones</p>
    <p class="mt-1.5 text-[13px] text-ink-3">El {COMISION_MARKETER}% de lo que paga cada local, todos los meses</p>
  </div>

  <div class="relative mx-5 mt-4 overflow-hidden rounded-[22px] bg-ink p-5 text-white">
    <span class="pointer-events-none absolute -right-10 -top-12 size-40 rounded-full bg-brand/30 blur-2xl" />
    <p class="relative text-[11px] font-semibold uppercase tracking-[.09em] text-white/60">Pendiente · octubre</p>
    <p class="relative mt-2 text-[38px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(TOTALES_CARTERA.comisionMes)}</p>
    <p class="relative mt-2.5 text-[12.5px] text-white/70">{pagan} locales que pagan · se transfiere a tu cuenta</p>
  </div>

  <div class="mx-5 mt-3 overflow-hidden rounded-[18px] bg-white ring-1 ring-line">
    {CARTERA.map((l, i) => (
      <div class:list={['flex items-center gap-3 px-3.5 py-3', i > 0 && 'border-t border-line/70']}>
        <Monograma inicial={l.inicial} color={l.color} size={34} />
        <div class="min-w-0 flex-1">
          <p class="truncate text-[14px] font-semibold leading-tight">{l.nombre}</p>
          <p class="truncate text-[11.5px] text-ink-3">{l.suscripcionMensual > 0 ? `${plan(l.suscripcionMensual)} · ${pesos(l.suscripcionMensual)}` : 'En prueba · todavía no paga'}</p>
        </div>
        <span class:list={['text-[14px] font-bold tabular-nums', l.suscripcionMensual === 0 && 'text-ink-3']}>{l.suscripcionMensual > 0 ? pesos(comisionDe(l)) : '—'}</span>
      </div>
    ))}
  </div>

  <p class="mt-5 px-5 text-[11px] font-semibold uppercase tracking-[.09em] text-ink-3">Anteriores</p>
  <div class="mx-5 mt-2 flex items-center gap-3 rounded-[18px] bg-white px-3.5 py-3 ring-1 ring-line">
    <span class="grid size-[34px] place-items-center rounded-xl bg-emerald-500/10 text-emerald-700"><Icon name="circle-check" class="size-[18px]" /></span>
    <div class="flex-1">
      <p class="text-[14px] font-semibold leading-tight">{COMISION_MES_ANTERIOR.mes}</p>
      <p class="text-[11.5px] text-ink-3">2 locales · transferida</p>
    </div>
    <span class="text-[14px] font-bold tabular-nums">{pesos(COMISION_MES_ANTERIOR.monto)}</span>
  </div>

  <NavMovil modo="cartera" activo="comisiones" />
</div>
