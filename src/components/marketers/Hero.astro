---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import Telefono from '../marcos/Telefono.astro'
import Ventana from '../marcos/Ventana.astro'
import Cartera from '../replicas/marketers/Cartera.astro'
import CarteraMovil from '../replicas/marketers/CarteraMovil.astro'
import HistoriaInstagram from '../replicas/HistoriaInstagram.astro'
import { CARTERA, HISTORIA_MARTES, TOTALES_CARTERA } from '../../data/marketers'
import { COMISION_MARKETER, TEXTO_WA_PARTNER, enlaceWhatsapp, pesos } from '../../data/oferta'

const checks = ['Desde el WhatsApp de cada local', 'Ventas cobradas, no likes', `El ${COMISION_MARKETER}% de cada suscripción, todos los meses`]
---

<section class="relative overflow-hidden pt-[128px] sm:pt-[150px]">
  <div class="fondo-hero pointer-events-none absolute inset-0" aria-hidden="true" />

  <div class="contenedor relative text-center">
    <p class="revelar mx-auto inline-flex items-center gap-2.5 rounded-full bg-white/80 px-3.5 py-1.5 text-[13.5px] font-medium text-ink-2 ring-1 ring-line backdrop-blur">
      <span class="punto-vivo" />Para marketers que hacen crecer locales gastronómicos
    </p>
    <h1 class="revelar titulo-xl mx-auto mt-6 max-w-[15ch] sm:max-w-none" style="--retraso:80ms">
      Que tus clientes vendan por redes.<br /><span class="text-brand">Y que se note.</span>
    </h1>
    <p class="revelar bajada mx-auto mt-6 max-w-[42rem]" style="--retraso:160ms">
      Piru es la tienda, la base de clientes y la recompra de los locales que manejás. Cada historia lleva su link,
      cada venta queda medida y los clientes vuelven por el WhatsApp del local. Vos lo manejás todo desde tu app,
      y cobrás todos los meses por cada local que sumás.
    </p>
    <div class="revelar mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--retraso:240ms">
      <a href={enlaceWhatsapp(TEXTO_WA_PARTNER)} target="_blank" rel="noopener" class="boton boton-primario w-full max-w-xs sm:w-auto">
        <Icon name="message-circle" class="size-[18px]" stroke={2.2} />Quiero ser partner
      </a>
      <a href="#sistema" class="boton boton-secundario w-full max-w-xs sm:w-auto">
        Ver cómo funciona<Icon name="arrow-right" class="size-4 rotate-90" />
      </a>
    </div>
    <ul class="revelar mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[14px] text-ink-2" style="--retraso:320ms">
      {checks.map((c) => (
        <li class="flex items-center gap-1.5"><Icon name="circle-check" class="size-4 text-brand" stroke={2.2} />{c}</li>
      ))}
    </ul>
  </div>

  <!-- Composición: la historia vende → la cartera lo muestra → la comisión llega -->
  <div class="revelar contenedor relative mt-14 pb-16 sm:mt-20 sm:pb-24" style="--retraso:200ms">
    <div class="relative mx-auto hidden max-w-[1160px] md:block">
      <div class="relative ml-[9%] w-[76%] rounded-[18px] sombra-profunda">
        <Escala ancho={1280} alto={800} etiqueta={`La app de marketers: la cartera de ${CARTERA.length} locales con sus ventas cobradas de 30 días, la comisión del mes y los mensajes para mandar hoy`}>
          <Ventana ancho={1280} alto={800} url="marketing.piru.app">
            <Cartera />
          </Ventana>
        </Escala>
      </div>

      <div class="absolute -bottom-[8%] left-0 w-[20%] drop-shadow-[0_30px_50px_rgba(40,20,5,0.35)]">
        <div class="aparece absolute -top-[14%] left-[2%] z-10 flex items-center gap-2 whitespace-nowrap rounded-2xl bg-white/95 px-3.5 py-2.5 text-[13px] font-semibold text-ink shadow-lg ring-1 ring-line backdrop-blur" style="--retraso:1.3s">
          <span class="grid size-6 place-items-center rounded-full bg-rose-500 text-white"><Icon name="sticker" class="size-3.5" stroke={2.4} /></span>
          Este link vendió {pesos(HISTORIA_MARTES.ventas)}
          <span class="font-normal text-ink-3">· {HISTORIA_MARTES.pedidos} pedidos</span>
        </div>
        <Escala ancho={412} alto={866} etiqueta="Una historia del local con el sticker de link: martes de smash, 15% OFF sólo hoy">
          <Telefono tono="oscuro"><HistoriaInstagram /></Telefono>
        </Escala>
      </div>

      <div class="aparece absolute right-0 top-[10%] w-[19%] rotate-[3deg]" style="--retraso:2.2s">
        <div class="rounded-[22px] bg-ink p-5 text-white shadow-[0_30px_60px_-20px_rgb(25_21_18/.7)]">
          <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[.09em] text-white/55"><Icon name="hand-coins" class="size-3.5" />Tu comisión</p>
          <p class="mt-2 text-[30px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(TOTALES_CARTERA.comisionMes)}</p>
          <p class="mt-2 text-[12.5px] leading-snug text-white/65">de octubre · el {COMISION_MARKETER}% de lo que pagan tus locales</p>
        </div>
      </div>
    </div>

    <!-- En celular: la cartera -->
    <div class="relative mx-auto max-w-[300px] md:hidden">
      <div class="drop-shadow-[0_24px_40px_rgba(40,20,5,0.3)]">
        <Escala ancho={412} alto={866} etiqueta="La app de marketers en el celular: tus locales con sus ventas cobradas y tu comisión del mes">
          <Telefono><CarteraMovil /></Telefono>
        </Escala>
      </div>
      <div class="aparece absolute -left-3 top-[30%] flex items-center gap-2 whitespace-nowrap rounded-2xl bg-white/95 px-3 py-2 text-[12.5px] font-semibold text-ink shadow-lg ring-1 ring-line" style="--retraso:1.2s">
        <span class="grid size-5 place-items-center rounded-full bg-rose-500 text-white"><Icon name="sticker" class="size-3" stroke={2.4} /></span>
        Este link vendió {pesos(HISTORIA_MARTES.ventas)}
      </div>
    </div>
  </div>
</section>

<style>
  .fondo-hero {
    background:
      radial-gradient(60rem 30rem at 50% 62%, rgb(255 122 0 / .13), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(40 24 8 / .09) 1px, transparent 0) 0 0 / 26px 26px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 96%);
  }
  .sombra-profunda {
    box-shadow:
      0 2px 4px rgb(40 24 8 / .06),
      0 24px 48px -12px rgb(40 24 8 / .22),
      0 60px 120px -40px rgb(255 122 0 / .28);
  }
</style>
