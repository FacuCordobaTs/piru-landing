---
import Icon from '../ui/Icon.astro'
import Logo from '../ui/Logo.astro'
import { DIAS_PRUEBA, TIENDA_DEMO, enlaceWhatsapp } from '../../data/oferta'
---

<section class="px-5 pb-20 sm:px-8 sm:pb-28">
  <div class="revelar cta relative mx-auto max-w-[1200px] overflow-hidden rounded-[36px] px-7 py-16 text-center text-white sm:px-12 sm:py-24">
    <div class="pointer-events-none absolute inset-0 opacity-[.13]" aria-hidden="true">
      <Logo variante="blanco" size={520} class="absolute -bottom-24 -right-16 rotate-[-8deg]" />
    </div>
    <div class="relative">
      <h2 class="titulo-lg mx-auto max-w-[16ch]">Tu tienda puede estar vendiendo esta semana.</h2>
      <p class="mx-auto mt-5 max-w-xl text-[18px] leading-relaxed text-white/85">Mandanos tu carta por WhatsApp y te la armamos. Tenés {DIAS_PRUEBA} días para probarla con tus clientes.</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={enlaceWhatsapp()} target="_blank" rel="noopener" class="boton w-full max-w-xs bg-white text-ink shadow-[0_12px_30px_-10px_rgb(80_30_0/.6)] hover:bg-cream sm:w-auto">
          <Icon name="message-circle" class="size-[18px] text-wa-deep" stroke={2.2} />Quiero mi tienda
        </a>
        <a href={TIENDA_DEMO} target="_blank" rel="noopener" class="boton w-full max-w-xs bg-white/15 text-white ring-1 ring-white/30 hover:bg-white/25 sm:w-auto">
          Ver la tienda de demostración<Icon name="arrow-up-right" class="size-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(40rem 22rem at 20% 0%, rgb(255 255 255 / .22), transparent 70%),
      linear-gradient(160deg, #FF8A1A, #FF7A00 45%, #E85F00);
    box-shadow: 0 40px 90px -40px rgb(232 95 0 / .8);
  }
</style>
