---
import { Image } from 'astro:assets'
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import TiendaGenerica from '../replicas/paginas/TiendaGenerica.astro'
import { capturaTema } from '../../data/capturas'
import { TEMAS, type IdTema } from '../../data/oferta'

/**
 * El hilo en dos bloques que se leen sin hacer nada raro con el scroll:
 *  1. El problema (fondo gris): cuatro locales distintos con la misma tienda de app de pedidos.
 *  2. La solución (de noche): los mismos cuatro locales, cada uno con un tema de Piru.
 * Las dos filas tienen la misma forma a propósito, para que el cambio se vea de un vistazo.
 * Los celulares aparecen al entrar en pantalla con la aparición atada al scroll (`.revelar`).
 */
const LOCALES: { generica: { nombre: string; rubro: string; categoria: number }; tema: IdTema }[] = [
  { generica: { nombre: 'Lo de Tito', rubro: 'Hamburguesas', categoria: 0 }, tema: 'tarascon' },
  { generica: { nombre: 'Napoli', rubro: 'Pizzería', categoria: 1 }, tema: 'porcion' },
  { generica: { nombre: 'Doña Rosa', rubro: 'Empanadas', categoria: 2 }, tema: 'girasol' },
  { generica: { nombre: 'La Esquina', rubro: 'Minutas', categoria: 0 }, tema: 'sumi' },
]
const nombreTema = (id: IdTema) => TEMAS.find((t) => t.id === id)!.nombre
const PASOS = [
  { icono: 'layers', titulo: 'Elegís un tema', texto: `${TEMAS.length} diseños distintos, pensados para gastronomía.` },
  { icono: 'pencil', titulo: 'Lo hacés tuyo', texto: 'Tu logo, tus colores, tus fotos y tus textos, desde el editor.' },
  { icono: 'globe', titulo: 'Lo publicás', texto: 'En tu dominio, con los pedidos y los cobros andando.' },
] as const
---

<!-- 1. El problema -->
<section id="problema" class="bg-[#E9E8E5] py-24 text-[#1d1d1f] sm:py-32">
  <div class="contenedor">
    <div class="mx-auto max-w-3xl text-center">
      <p class="revelar antetitulo">El problema</p>
      <h2 class="revelar titulo-lg mt-4">Todas las apps de pedidos te dan la misma tienda.</h2>
      <p class="revelar mx-auto mt-5 max-w-xl text-[18px] leading-relaxed text-[#55555a]">Cambia el nombre. La portada, los colores, la letra y la carta son iguales para todos.</p>
    </div>

    <div class="relative mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-6">
      {LOCALES.map((l, i) => (
        <figure class:list={['revelar m-0', `escalon-${i}`]}>
          <div class="overflow-hidden rounded-[22px] shadow-[0_20px_40px_-24px_rgb(0_0_0/.35)] ring-1 ring-black/10">
            <Escala ancho={390} alto={700} etiqueta={`La tienda de ${l.generica.nombre} en una app de pedidos: igual a las otras`}>
              <TiendaGenerica {...l.generica} />
            </Escala>
          </div>
          <figcaption class="mt-3 text-center text-[14px] font-semibold text-[#55555a]">{l.generica.nombre}</figcaption>
        </figure>
      ))}
      <span class="revelar pointer-events-none absolute left-1/2 top-[38%] -translate-x-1/2 -rotate-6 whitespace-nowrap rounded-xl bg-[#1d1d1f] px-5 py-3 text-[clamp(1rem,2.4vw,1.5rem)] font-bold text-white shadow-2xl">
        Cuatro locales. Una sola tienda.
      </span>
    </div>

    <div class="revelar mx-auto mt-20 flex max-w-3xl flex-col items-center gap-5 text-center sm:mt-24">
      <span class="grid size-14 place-items-center rounded-2xl bg-[#1d1d1f] text-white"><Icon name="hourglass" class="size-6" /></span>
      <p class="text-[clamp(1.6rem,3.6vw,2.6rem)] font-bold leading-[1.1] tracking-[-.035em]">Y si querías la tuya, con tu diseño, había que pagarle a un programador.</p>
      <p class="max-w-xl text-[17px] leading-relaxed text-[#55555a]">Un presupuesto, semanas de espera y depender de alguien hasta para cambiar un precio.</p>
    </div>
  </div>
</section>

<!-- 2. La solución -->
<section id="solucion" data-oscuro class="bg-[#0E0B09] py-24 text-[#FFF8EF] sm:py-32">
  <div class="contenedor">
    <div class="mx-auto max-w-3xl text-center">
      <p class="revelar antetitulo text-[#FF8A1A]">Con Piru</p>
      <h2 class="revelar titulo-lg mt-4">Tu tienda online, con el diseño de tu local.</h2>
      <p class="revelar mx-auto mt-5 max-w-xl text-[18px] leading-relaxed text-white/70">Los mismos cuatro locales, cada uno con un tema distinto. Sin escribir código.</p>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-6">
      {LOCALES.map((l, i) => (
        <figure class:list={['revelar m-0', `escalon-${i}`]}>
          <Image src={capturaTema(l.tema)} alt={`La tienda de ${l.generica.nombre} con el tema ${nombreTema(l.tema)}`} width={390} class="block aspect-[390/700] w-full rounded-[22px] object-cover object-top shadow-[0_30px_60px_-30px_rgb(255_122_0/.35)] ring-1 ring-white/10" />
          <figcaption class="mt-3 text-center text-[14px] font-semibold">{l.generica.nombre} <span class="font-medium text-white/50">· tema {nombreTema(l.tema)}</span></figcaption>
        </figure>
      ))}
    </div>

    <ol class="mx-auto mt-20 grid max-w-5xl gap-4 sm:grid-cols-3">
      {PASOS.map((p, i) => (
        <li class="revelar rounded-[24px] bg-white/[.05] p-6 ring-1 ring-white/10">
          <span class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-full bg-[#FF8A1A] text-[15px] font-bold text-[#0E0B09]">{i + 1}</span>
            <Icon name={p.icono} class="size-5 text-white/50" />
          </span>
          <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em]">{p.titulo}</h3>
          <p class="mt-1.5 text-[15.5px] leading-relaxed text-white/65">{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Los celulares de cada fila entran uno detrás del otro, siempre atados al scroll. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .escalon-1 { animation-range: entry 8% entry 78%; }
      .escalon-2 { animation-range: entry 16% entry 86%; }
      .escalon-3 { animation-range: entry 24% entry 94%; }
    }
  }
</style>
