---
import Icon from '../ui/Icon.astro'
import { CREAR_TIENDA, PLANES, PLAN_CALCULADORA, TEXTO_WA_EVOLUCION, enlaceWhatsapp, pesos } from '../../data/oferta'

/**
 * Los cinco planes (espejo de `plan_tienda`, ver data/oferta.ts y docs/PLANES_TIENDA.md). El
 * selector Mensual/Anual cambia el precio sin recargar; sin JS se ve el mensual.
 */
const comisiones = [20, 25, 30, 35]
const precioAnual = (precio: number, descuento: number) => Math.round(precio * (1 - descuento / 100))
const hayAnual = PLANES.some((p) => p.descuentoAnual > 0)
---

<section id="precios" class="py-24 sm:py-32">
  <div class="contenedor">
    <div class="revelar mx-auto max-w-3xl text-center">
      <p class="antetitulo">Planes</p>
      <h2 class="titulo-lg mt-4">Empezá gratis. Cambiá de plan cuando crezcas.</h2>
      <p class="bajada mx-auto mt-5 max-w-2xl">Pedidos y productos ilimitados en todos los planes, y cero comisión por venta: lo que cobrás va directo a tu cuenta.</p>
    </div>

    {hayAnual && (
      <div class="revelar mt-10 flex justify-center" style="--retraso:60ms">
        <div class="ciclo inline-flex rounded-full bg-sand p-1 ring-1 ring-line" role="radiogroup" aria-label="Ciclo de pago">
          <button type="button" role="radio" aria-checked="true" data-ciclo="mensual">Mensual</button>
          <button type="button" role="radio" aria-checked="false" data-ciclo="anual">Anual · 20% menos</button>
        </div>
      </div>
    )}

    <div class="planes mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" data-ciclo="mensual">
      {PLANES.map((p, i) => {
        const aMedida = p.precio === null
        const gratis = p.precio === 0
        return (
          <article
            class:list={['revelar tarjeta relative flex flex-col p-6', p.destacado && 'ring-2 ring-brand']}
            style={`--retraso:${i * 60}ms`}
          >
            {p.destacado && <span class="absolute -top-3 left-6 rounded-full bg-brand px-3 py-1 text-[12px] font-semibold text-white">Recomendado</span>}
            <h3 class="text-[19px] font-semibold tracking-tight">{p.nombre}</h3>
            <p class="mt-1.5 text-[14.5px] leading-snug text-ink-2 xl:min-h-[4.6rem]">{p.descripcion}</p>
            <div class="mt-5 min-h-[4.25rem]">
              {aMedida ? (
                <p class="text-[30px] font-bold leading-none tracking-[-0.04em]">A medida</p>
              ) : gratis ? (
                <p class="text-[30px] font-bold leading-none tracking-[-0.04em]">Gratis</p>
              ) : (
                <>
                  <p class="flex items-end gap-1.5">
                    <span class="precio-mensual text-[30px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(p.precio!)}</span>
                    <span class="precio-anual text-[30px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(precioAnual(p.precio!, p.descuentoAnual))}</span>
                    <span class="pb-0.5 text-[14px] text-ink-3">/ mes</span>
                  </p>
                  <p class="precio-anual mt-2 text-[13px] text-ink-3">Pagando el año por adelantado</p>
                </>
              )}
            </div>
            {aMedida ? (
              <a href={enlaceWhatsapp(TEXTO_WA_EVOLUCION)} target="_blank" rel="noopener" class="boton boton-secundario mt-5 w-full">Hablar con Piru</a>
            ) : (
              <a href={CREAR_TIENDA} class:list={['boton mt-5 w-full', p.destacado ? 'boton-primario' : 'boton-secundario']}>
                {gratis ? 'Crear tienda gratis' : 'Empezar gratis'}
              </a>
            )}
            <ul class="mt-6 space-y-2.5">
              {p.beneficios.map((b) => (
                <li class="flex gap-2.5 text-[14.5px] leading-snug text-ink"><Icon name="check" class="mt-0.5 size-[17px] shrink-0 text-brand" stroke={2.6} />{b}</li>
              ))}
            </ul>
          </article>
        )
      })}
    </div>

    <p class="revelar mt-6 text-center text-[14px] text-ink-3">Creás tu tienda gratis y elegís un plan pago desde tu panel cuando lo necesites. Los avisos automáticos por WhatsApp se recargan aparte.</p>

    <!-- Calculadora -->
    <div id="calculadora" class="revelar mt-5 overflow-hidden rounded-[28px] bg-ink text-white">
      <div class="grid lg:grid-cols-2">
        <div class="p-7 sm:p-10">
          <p class="antetitulo text-brand">Hacé la cuenta</p>
          <h3 class="mt-3 text-[28px] font-bold leading-tight tracking-[-0.03em] sm:text-[34px]">¿Cuánto les dejás a las apps?</h3>

          <div class="mt-9 space-y-8">
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for="calc-ventas" class="text-[15px] text-white/70">Lo que vendés por apps en un mes</label>
                <output id="calc-ventas-valor" class="text-[20px] font-semibold tabular-nums">$3.000.000</output>
              </div>
              <input id="calc-ventas" type="range" min="500000" max="20000000" step="100000" value="3000000" class="rango mt-3" />
            </div>

            <fieldset>
              <legend class="text-[15px] text-white/70">Comisión que te cobran</legend>
              <div class="mt-3 grid grid-cols-4 gap-2">
                {comisiones.map((c) => (
                  <label class="comision">
                    <input type="radio" name="calc-comision" value={c} checked={c === 30} class="sr-only" />
                    <span>{c}%</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for="calc-pase" class="text-[15px] text-white/70">De esos pedidos, cuántos pasan a tu página</label>
                <output id="calc-pase-valor" class="text-[20px] font-semibold tabular-nums">30%</output>
              </div>
              <input id="calc-pase" type="range" min="10" max="100" step="5" value="30" class="rango mt-3" />
            </div>
          </div>
        </div>

        <div class="flex flex-col justify-center gap-6 bg-white/[.04] p-7 sm:p-10" aria-live="polite">
          <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5">
            <span class="text-[15px] text-white/70">Hoy les pagás en comisiones</span>
            <span id="calc-comision-total" class="text-[22px] font-semibold tabular-nums text-[#FF8A7A]">$900.000</span>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5">
            <span id="calc-ahorro-texto" class="text-[15px] text-white/70">Te ahorrás si pasa el 30% a tu página</span>
            <span id="calc-ahorro" class="text-[22px] font-semibold tabular-nums">$270.000</span>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5">
            <span class="text-[15px] text-white/70">Piru, plan {PLAN_CALCULADORA.nombre}</span>
            <span class="text-[22px] font-semibold tabular-nums">−{pesos(PLAN_CALCULADORA.precio!)}</span>
          </div>
          <div>
            <p id="calc-resultado-texto" class="text-[15px] text-white/70">Te quedan por mes</p>
            <p id="calc-resultado" class="mt-1 text-[48px] font-bold leading-none tracking-[-0.04em] tabular-nums text-emerald-300 sm:text-[56px]">+$230.000</p>
          </div>
          <p class="text-[12.5px] leading-relaxed text-white/40">Cálculo de ejemplo con tus números. No incluye lo que cobra tu medio de pago (por ejemplo, Mercado Pago) ni los adicionales.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ciclo button {
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-2);
    transition: background-color .2s, color .2s;
  }
  .ciclo button[aria-checked='true'] { background: var(--color-ink); color: #fff; }
  .ciclo button:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .planes[data-ciclo='mensual'] .precio-anual { display: none; }
  .planes[data-ciclo='anual'] .precio-mensual { display: none; }

  .rango {
    width: 100%;
    height: 28px;
    appearance: none;
    background: transparent;
    cursor: pointer;
    --lleno: 13%;
  }
  .rango::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-brand) var(--lleno), rgb(255 255 255 / .16) var(--lleno));
  }
  .rango::-moz-range-track { height: 6px; border-radius: 999px; background: rgb(255 255 255 / .16); }
  .rango::-moz-range-progress { height: 6px; border-radius: 999px; background: var(--color-brand); }
  .rango::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    margin-top: -9px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 4px rgb(255 122 0 / .35), 0 2px 6px rgb(0 0 0 / .4);
  }
  .rango::-moz-range-thumb { width: 24px; height: 24px; border: 0; border-radius: 999px; background: #fff; box-shadow: 0 0 0 4px rgb(255 122 0 / .35); }
  .rango:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 4px; }

  .comision span {
    display: grid;
    place-items: center;
    height: 46px;
    border-radius: 14px;
    background: rgb(255 255 255 / .06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s, box-shadow .2s, color .2s;
  }
  .comision input:checked + span { background: var(--color-brand); box-shadow: none; }
  .comision input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
</style>

<script>
  import { PLAN_CALCULADORA } from '../../data/oferta'

  const PRECIO_PLAN = PLAN_CALCULADORA.precio ?? 0

  // Selector Mensual/Anual de las tarjetas de planes.
  const planes = document.querySelector<HTMLElement>('.planes')
  document.querySelectorAll<HTMLButtonElement>('.ciclo button').forEach((boton, _, todos) => {
    boton.addEventListener('click', () => {
      todos.forEach((b) => b.setAttribute('aria-checked', String(b === boton)))
      planes?.setAttribute('data-ciclo', boton.dataset.ciclo ?? 'mensual')
    })
  })

  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 })
  const pesos = (n: number) => `$${fmt.format(Math.round(n))}`
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null

  const ventas = $<HTMLInputElement>('calc-ventas')
  const pase = $<HTMLInputElement>('calc-pase')
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="calc-comision"]')

  function lleno(input: HTMLInputElement) {
    const min = Number(input.min), max = Number(input.max), v = Number(input.value)
    input.style.setProperty('--lleno', `${((v - min) / (max - min)) * 100}%`)
  }

  function calcular() {
    if (!ventas || !pase) return
    const v = Number(ventas.value)
    const p = Number(pase.value) / 100
    const c = Number([...radios].find((r) => r.checked)?.value ?? 30) / 100
    const comision = v * c
    const ahorro = comision * p
    const neto = ahorro - PRECIO_PLAN

    $('calc-ventas-valor')!.textContent = pesos(v)
    $('calc-pase-valor')!.textContent = `${Math.round(p * 100)}%`
    $('calc-comision-total')!.textContent = pesos(comision)
    $('calc-ahorro-texto')!.textContent = `Te ahorrás si pasa el ${Math.round(p * 100)}% a tu página`
    $('calc-ahorro')!.textContent = pesos(ahorro)
    const resultado = $('calc-resultado')!
    resultado.textContent = `${neto >= 0 ? '+' : '−'}${pesos(Math.abs(neto))}`
    resultado.classList.toggle('text-emerald-300', neto >= 0)
    resultado.classList.toggle('text-white/60', neto < 0)
    $('calc-resultado-texto')!.textContent = neto >= 0 ? 'Te quedan por mes' : 'Todavía no se paga: faltan por mes'
    lleno(ventas)
    lleno(pase)
  }

  ventas?.addEventListener('input', calcular)
  pase?.addEventListener('input', calcular)
  radios.forEach((r) => r.addEventListener('change', calcular))
  calcular()
</script>
