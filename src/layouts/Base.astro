---
import '@fontsource/open-runde/400.css'
import '@fontsource/open-runde/500.css'
import '@fontsource/open-runde/600.css'
import '@fontsource/open-runde/700.css'
import '../styles/global.css'
import runde700 from '@fontsource/open-runde/files/open-runde-latin-700-normal.woff2?url'
import Nav from '../components/Nav.astro'
import Pie from '../components/Pie.astro'
import { PLANES } from '../data/oferta'

interface Props {
  titulo?: string
  descripcion?: string
  /** Ruta canónica; los datos estructurados del producto van sólo en la portada. */
  canonical?: string
}

const {
  titulo = 'Piru · La página propia de tu local gastronómico',
  descripcion = 'La plataforma para vender online de los locales gastronómicos: una página propia con su diseño, y debajo la carta, los pedidos, los cobros, el salón y sus clientes. Empezás gratis, sin comisión por venta.',
  canonical = Astro.url.pathname,
} = Astro.props

const sitio = Astro.site?.toString().replace(/\/$/, '') ?? 'https://piru.app'
const url = `${sitio}${canonical}`
const imagen = `${sitio}/logopiru.jpeg`
const portada = canonical === '/'
---

<!doctype html>
<html lang="es-AR" data-tema={portada ? 'noche' : 'papel'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content={portada ? '#0E0B09' : '#FFFCF7'} />

    <link rel="icon" type="image/jpeg" href="/piru/logo.jpg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Piru" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={runde700} as="font" type="font/woff2" crossorigin />
    <!-- La landing va en Open Runde (@fontsource, arriba); Inter queda para las réplicas de la app. -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap" rel="stylesheet" />
    <!-- Las de las páginas que se ven en las réplicas: Che Milanesa (Alfa Slab One) y las plantillas
         (web/src/lib/plantillas.ts). Las de Alfajor están en public/fuentes (styles/paginas.css). -->
    <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Fraunces:ital,opsz,wght@0,9..144,600..800;1,9..144,500..700&family=Manrope:wght@400..800&family=Nunito+Sans:opsz,wght@6..12,400..800&family=Unbounded:wght@600..800&display=swap" rel="stylesheet" />

    <script is:inline>document.documentElement.classList.add('js')</script>

    {portada && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: 'Piru',
          url,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web, Windows',
          description: descripcion,
          offers: PLANES.filter((p) => p.precio !== null).map((p) => ({ '@type': 'Offer', name: `Plan ${p.nombre}`, price: String(p.precio), priceCurrency: 'ARS' })),
        })}
      />
    )}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    <Nav />
    <main id="contenido">
      <slot />
    </main>
    <Pie />

    <script>
      // Aparición suave de bloques al entrar en pantalla.
      const revelables = document.querySelectorAll<HTMLElement>('.revelar')
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add('visible')
              io.unobserve(e.target)
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 })
        revelables.forEach((el) => io.observe(el))
      } else {
        revelables.forEach((el) => el.classList.add('visible'))
      }

      // El tema de la sección que cruza la mitad de la pantalla pasa a <html> (fondo y menú).
      const raiz = document.documentElement
      const temas = document.querySelectorAll<HTMLElement>('main [data-tema]')
      const color = document.querySelector('meta[name="theme-color"]')
      if (temas.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue
            const tema = (e.target as HTMLElement).dataset.tema!
            raiz.dataset.tema = tema
            color?.setAttribute('content', getComputedStyle(e.target).getPropertyValue('--fondo').trim())
          }
        }, { rootMargin: '-50% 0px -50% 0px' })
        temas.forEach((el) => io.observe(el))
      }

      // Progreso de scroll para las secciones que se mueven con la página:
      //  - `data-fijo`: secciones altas con un hijo sticky; --p va de 0 a 1 mientras queda fijo.
      //  - `data-progreso`: --p va de 0 (entra por abajo) a 1 (sale por arriba).
      const fijos = [...document.querySelectorAll<HTMLElement>('[data-fijo]')]
      const progresos = [...document.querySelectorAll<HTMLElement>('[data-progreso]')]
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches
      let pendiente = false
      const medir = () => {
        pendiente = false
        const vh = innerHeight
        for (const el of fijos) {
          const r = el.getBoundingClientRect()
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)))
          el.style.setProperty('--p', p.toFixed(4))
          el.dispatchEvent(new CustomEvent('progreso', { detail: p }))
        }
        if (reducido) return
        for (const el of progresos) {
          const r = el.getBoundingClientRect()
          if (r.bottom < -vh || r.top > vh * 2) continue
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)))
          el.style.setProperty('--p', p.toFixed(4))
        }
      }
      const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir) } }
      addEventListener('scroll', pedir, { passive: true })
      addEventListener('resize', pedir)
      requestAnimationFrame(medir)

      // Navegadores sin tan(atan2()) en CSS: la escala de las réplicas se calcula acá.
      if (!CSS.supports('transform', 'scale(tan(atan2(1px, 2px)))')) {
        const ro = new ResizeObserver((entradas) => {
          for (const e of entradas) {
            const el = e.target as HTMLElement
            const w = Number(getComputedStyle(el).getPropertyValue('--escala-w')) || 1
            el.style.setProperty('--escala-k', String(el.clientWidth / w))
          }
        })
        document.querySelectorAll<HTMLElement>('.escala').forEach((el) => ro.observe(el))
      }
    </script>
  </body>
</html>
