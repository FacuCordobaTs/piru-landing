---
import Icon from '../../ui/Icon.astro'
import Barra from './Barra.astro'
import { cargarFotos } from '../../../data/fotos'
import { BORRADOR_POS, MENU } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

const FOTOS = await cargarFotos()

/**
 * Réplica del punto de venta de escritorio (Dashboard.tsx + PuntoDeVenta.tsx con el catálogo en
 * columna): catálogo a la izquierda y comanda a la derecha.
 * Cambio deliberado: cada fila de la comanda muestra la cantidad ("2×"), igual que el ticket.
 */
const categorias = MENU.slice(0, 3)
const enComanda = new Set(BORRADOR_POS.items.map((i) => i.nombre))
const segmento = 'flex h-9 w-full items-center justify-center gap-1.5 rounded-lg text-xs font-bold'
---

<div class="flex h-full w-full bg-[#FFFBF0] text-foreground">
  <Barra activo="inicio" compacta />

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
      <div class="flex-1" />
      <p class="text-2xl font-bold tracking-tight">Anotar pedido</p>
      <div class="flex flex-1 items-center justify-end gap-2">
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium"><Icon name="calendar-days" class="size-4" />Caja</span>
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium"><Icon name="map" class="size-4" />Mapa</span>
      </div>
    </header>

    <div class="flex min-h-0 flex-1 gap-4 p-4 pt-1">
      <div class="flex min-w-0 flex-1 flex-col overflow-hidden rounded-2xl">
        <div class="shrink-0 border-b border-border/70 p-3">
          <div class="relative flex h-10 items-center rounded-full border border-border bg-muted/40 pl-10 text-sm text-muted-foreground">
            <Icon name="search" class="absolute left-3 size-4 text-muted-foreground/60" />Buscar producto o tag...
          </div>
        </div>
        <div class="space-y-5 p-3">
          {categorias.map((cat) => (
            <section>
              <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">{cat.categoria}</p>
              <div class="grid grid-cols-4 gap-2">
                {cat.productos.slice(0, 4).map((p) => (
                  <div class:list={[
                    'flex flex-col overflow-hidden rounded-xl border text-left',
                    p.foto ? 'min-h-32' : 'min-h-24',
                    enComanda.has(p.nombre) ? 'border-[#FF7A00] bg-[#FF7A00]/5 ring-1 ring-[#FF7A00]' : 'border-border bg-card',
                  ]}>
                    {p.foto && <div class="aspect-[4/3] w-full shrink-0 overflow-hidden bg-muted"><img src={FOTOS[p.foto].chica} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" /></div>}
                    <div class="flex flex-1 flex-col justify-between gap-1.5 p-2">
                      <span class="line-clamp-2 text-xs font-semibold leading-snug">{p.nombre}</span>
                      <span class="text-xs font-bold tabular-nums text-[#FF7A00]">{pesos(p.precio)}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <div class="relative flex w-[440px] shrink-0 flex-col overflow-hidden rounded-2xl">
        <div class="px-5 pt-5">
          <div class="flex items-start justify-between">
            <p class="text-4xl font-black leading-none tracking-tight">Nuevo pedido</p>
            <span class="flex items-center gap-1 text-xs font-semibold text-muted-foreground">Limpiar <Icon name="ellipsis-vertical" class="ml-2 size-4" /></span>
          </div>
          <div class="my-5 h-px bg-border/60" />
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-muted-foreground">Comanda · {BORRADOR_POS.items.reduce((s, i) => s + i.cantidad, 0)} ítems</p>
          {BORRADOR_POS.items.map((it, i) => (
            <div class:list={['flex items-center justify-between gap-3 py-3', i > 0 && 'border-t border-border/40']}>
              <div class="min-w-0 flex-1">
                <p class="text-base font-semibold leading-snug"><span class="mr-1.5 tabular-nums text-muted-foreground">{it.cantidad}×</span>{it.nombre}</p>
                <p class="mt-0.5 text-xs text-muted-foreground">{pesos(it.precio)} c/u</p>
              </div>
              <div class="flex shrink-0 items-center gap-3">
                <span class="text-base font-semibold tabular-nums">{pesos(it.precio * it.cantidad)}</span>
                <span class="flex size-8 items-center justify-center rounded-lg text-muted-foreground"><Icon name="trash-2" class="size-4" /></span>
              </div>
            </div>
          ))}
        </div>

        <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 bg-[#FFFBF0] px-5 pb-5 pt-4">
          <div class="grid grid-cols-2 gap-1 rounded-2xl bg-muted/60 p-1">
            <span class:list={[segmento, 'text-muted-foreground']}><Icon name="truck" class="size-3.5" />Delivery</span>
            <span class:list={[segmento, 'bg-background text-black shadow-sm']}><Icon name="shopping-bag" class="size-3.5" />Takeaway</span>
          </div>
          <div class="grid grid-cols-4 gap-1 rounded-2xl bg-muted/60 p-1">
            {['Efectivo', 'Tarjeta', 'Transferencia', 'Mercado Pago'].map((m, i) => (
              <span class:list={[segmento, i === 0 ? 'bg-background text-black shadow-sm' : 'text-muted-foreground']}>{m}</span>
            ))}
          </div>
          <div class="grid grid-cols-2 gap-3">
            <span class="flex h-9 items-center gap-2 border-b border-border/60 text-sm"><Icon name="user" class="size-3.5 text-muted-foreground" />Diego</span>
            <span class="flex h-9 items-center gap-2 border-b border-border/60 text-sm text-muted-foreground"><Icon name="phone" class="size-3.5" />Celular</span>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Total</span>
            <span class="text-3xl font-black tracking-tight text-[#FF7A00]">{pesos(BORRADOR_POS.total)}</span>
          </div>
          <span class="flex h-14 w-full items-center justify-center rounded-2xl bg-[#FF7A00] text-lg font-bold text-white">Anotar pedido</span>
        </div>
      </div>
    </div>
  </div>
</div>
