---
import { Image } from 'astro:assets'
import Icon from '../ui/Icon.astro'
import { CREAR_TIENDA, TEMAS } from '../../data/oferta'
import { capturaTema } from '../../data/capturas'

/**
 * La portada, de noche: la oferta en una frase y, detrás, un muro inclinado con los temas reales de
 * Páginas (capturas de su página), en cinco columnas que suben y bajan. Todo se mueve con CSS
 * (transform): las columnas con keyframes y la salida al bajar con una línea de tiempo de scroll
 * (`--hero`), así va pegado al dedo y no carga el hilo principal. El título espera a que termine la
 * intro (`html.intro-fin`, ver Intro.astro).
 */
const COLUMNAS = [0, 1, 2, 3, 4].map((c) => ({
  temas: TEMAS.filter((_, i) => i % 5 === c),
  duracion: 70 + c * 9,
  sube: c % 2 === 0,
}))
---

<section data-oscuro class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden bg-[#0E0B09] text-[#FFF8EF]">
  <div class="h-muro pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="h-plano flex justify-center gap-4 sm:gap-6">
      {COLUMNAS.map((col, c) => (
        <div class:list={['h-columna w-[130px] shrink-0 sm:w-[200px]', (c === 0 || c === 4) && 'max-sm:hidden']} style={`--c:${c}`}>
          <div class:list={['h-cinta flex flex-col gap-4 sm:gap-6', col.sube ? 'h-cinta--sube' : 'h-cinta--baja']} style={`--dur:${col.duracion}s`}>
            {[0, 1].map((vuelta) => col.temas.map((t) => (
              <figure class="m-0">
                <Image src={capturaTema(t.id)} alt="" width={300} loading={vuelta === 0 && c > 0 && c < 4 ? 'eager' : 'lazy'} class="block w-full rounded-[16px] ring-1 ring-white/10 sm:rounded-[22px]" />
                <figcaption class="mt-2 text-center text-[11px] font-semibold text-white/50 sm:text-[12px]">{t.nombre}</figcaption>
              </figure>
            )))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="h-velo pointer-events-none absolute inset-0 -z-10" aria-hidden="true" />

  <div class="h-texto contenedor relative py-32 text-center">
    <p class="h-entra mx-auto inline-flex items-center gap-2 rounded-full bg-white/[.08] px-3.5 py-1.5 text-[13px] font-semibold text-white/80 ring-1 ring-white/10" style="--d:.05s">
      <span class="punto-vivo" />Tiendas online para gastronomía
    </p>
    <h1 class="mx-auto mt-6 max-w-[16ch] text-[clamp(2.9rem,8vw,6.6rem)] font-bold leading-[.95] tracking-[-.045em]">
      <span class="h-entra block" style="--d:.15s">La tienda online de tu local.</span>
      <span class="h-entra block text-[#FF8A1A]" style="--d:.35s">Con tu diseño.</span>
    </h1>
    <p class="h-entra mx-auto mt-7 max-w-[34rem] text-[clamp(1.05rem,1.6vw,1.3rem)] leading-relaxed text-white/75" style="--d:.55s">
      Elegí uno de los {TEMAS.length} temas, ponele tu marca y empezá a vender hoy. Sin programadores y sin comisión por venta.
    </p>
    <div class="h-entra mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--d:.7s">
      <a href={CREAR_TIENDA} class="boton boton-primario w-full max-w-xs sm:w-auto">
        <Icon name="sparkles" class="size-[18px]" stroke={2.2} />Crear tienda gratis
      </a>
      <a href="#temas" class="boton w-full max-w-xs bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/15 sm:w-auto">
        Ver los {TEMAS.length} temas<Icon name="arrow-down" class="size-4" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero { view-timeline: --hero block; }
  .h-muro { perspective: 1400px; }
  .h-plano {
    position: absolute;
    inset: -25% -30%;
    transform: rotateX(22deg) rotateZ(-9deg) scale(1.05);
    transform-origin: 50% 30%;
  }
  .h-columna { animation: h-columna 1.2s var(--ease-suave) calc(.1s + var(--c) * .1s) both; }
  .h-cinta { will-change: transform; animation: h-baja var(--dur) linear infinite; }
  .h-cinta--sube { animation-name: h-sube; }
  @keyframes h-sube { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes h-baja { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  @keyframes h-columna { from { opacity: 0; transform: translateY(80px); } to { opacity: .55; transform: none; } }

  .h-velo {
    background:
      radial-gradient(ellipse 55% 50% at 50% 52%, rgb(14 11 9 / .95), rgb(14 11 9 / .75) 55%, rgb(14 11 9 / .2) 100%),
      linear-gradient(to bottom, rgb(14 11 9 / .6), transparent 20%, transparent 75%, #0E0B09);
  }

  .h-entra { animation: h-entra .9s cubic-bezier(.16, 1, .3, 1) var(--d) both; }
  @keyframes h-entra { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  :global(html.js:not(.intro-fin)) .h-entra,
  :global(html.js:not(.intro-fin)) .h-columna { animation-play-state: paused; }

  /* Al bajar, el texto se va y el muro se aplana, pegado al scroll. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .h-texto { animation: h-texto-sale linear both; animation-timeline: --hero; animation-range: exit 0% exit 60%; }
      .h-muro { animation: h-muro-sale linear both; animation-timeline: --hero; animation-range: exit 0% exit 100%; }
    }
  }
  @keyframes h-texto-sale { to { opacity: 0; transform: translateY(-80px) scale(.96); } }
  @keyframes h-muro-sale { to { transform: translateY(18%) scale(1.08); opacity: .4; } }

  @media (prefers-reduced-motion: reduce) {
    .h-cinta { animation: none; }
  }
</style>
