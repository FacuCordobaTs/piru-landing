---
import Icon from '../../ui/Icon.astro'
import Barra from './Barra.astro'
import { CLIENTA } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

/** Réplica de Clientes (admin/src/pages/Clientes.tsx): directorio y ficha amplia del cliente. */
interface Props {
  compacta?: boolean
  anchoLista?: number
}

const { compacta = true, anchoLista = 330 } = Astro.props
const lista = [
  { nombre: CLIENTA.nombre, pedidos: 7, puntos: 864, ultimo: 'hoy', total: CLIENTA.total, elegido: true },
  { nombre: 'Lucas Fernández', pedidos: 12, puntos: 1320, ultimo: '25 sept', total: 148900 },
  { nombre: 'Camila Ruiz', pedidos: 3, puntos: 0, ultimo: 'hoy', total: 52100 },
  { nombre: 'Tomás Díaz', pedidos: 9, puntos: 410, ultimo: '20 sept', total: 97300 },
  { nombre: 'Juli Pereyra', pedidos: 2, puntos: 0, ultimo: '14 sept', total: 50000 },
  { nombre: 'Agustín Romero', pedidos: 5, puntos: 250, ultimo: '30 jul', total: 61200 },
  { nombre: 'Valentina Sosa', pedidos: 1, puntos: 0, ultimo: '2 ago', total: 9500 },
]
const iniciales = (n: string) => n.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase()
const etiqueta = 'text-[11px] font-semibold uppercase tracking-wider text-muted-foreground/70'
const metrica = 'mt-1 whitespace-nowrap text-[26px] font-bold tabular-nums tracking-tight'
---

<div class="flex h-full w-full bg-[#FFFBF0] text-foreground">
  <Barra activo="clientes" compacta={compacta} />

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="relative flex shrink-0 items-center justify-center px-6 pb-3 pt-5">
      <span class="absolute left-6 flex items-center text-xs text-muted-foreground"><Icon name="arrow-left" class="mr-1.5 size-3.5" />Volver</span>
      <nav class="flex items-center gap-2">
        <span class="inline-flex h-9 items-center gap-2 rounded-full bg-foreground px-4 text-sm font-medium text-background shadow-sm"><Icon name="users" class="size-4" />Clientes</span>
        <span class="inline-flex h-9 items-center gap-2 rounded-full bg-muted/70 px-4 text-sm font-medium text-muted-foreground"><Icon name="trending-up" class="size-4" /><Icon name="ticket" class="size-4" />Adquisición</span>
        <span class="inline-flex h-9 items-center gap-2 rounded-full bg-muted/70 px-4 text-sm font-medium text-muted-foreground"><Icon name="sparkles" class="size-4" /><Icon name="zap" class="size-4" />Retención</span>
      </nav>
    </div>

    <div class="flex min-h-0 flex-1 gap-4 px-4 pb-4">
      <div class="flex shrink-0 flex-col" style={`width:${anchoLista}px`}>
        <div class="relative mb-2 flex h-10 items-center rounded-xl border border-border bg-white pl-9 text-[13px] text-muted-foreground">
          <Icon name="search" class="absolute left-3 size-4 text-muted-foreground/70" />Buscar clientes, teléfonos…
        </div>
        <div class="space-y-1.5">
          {lista.map((c) => (
            <div class:list={['flex w-full items-center gap-3 rounded-xl p-3', c.elegido ? 'border-l-[3px] border-l-[#FF7A00] bg-muted/40' : 'bg-white']}>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-bold">{iniciales(c.nombre)}</span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold">{c.nombre}</p>
                <p class="mt-1 flex items-center gap-2 text-[11px] text-muted-foreground">
                  <span>{c.pedidos} {c.pedidos === 1 ? 'pedido' : 'pedidos'}</span>
                  {c.puntos > 0 && <><span>·</span><span class="font-semibold text-amber-600">{c.puntos.toLocaleString('es-AR')} pts</span></>}
                </p>
                <p class="mt-1 truncate text-[11px] text-muted-foreground">Último {c.ultimo} · {pesos(c.total)}</p>
              </div>
              <Icon name="chevron-right" class:list={['size-4', c.elegido ? 'text-[#FF7A00]' : 'text-muted-foreground/40']} />
            </div>
          ))}
        </div>
      </div>

      <div class="min-w-0 flex-1 overflow-hidden rounded-2xl bg-white/60">
        <div class="flex items-start justify-between gap-4 p-5 px-7">
          <div class="flex min-w-0 items-center gap-4">
            <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-muted/80 text-base font-semibold">{CLIENTA.iniciales}</span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2.5">
                <p class="truncate text-3xl font-bold tracking-tight">{CLIENTA.nombre}</p>
                <span class="inline-flex items-center gap-1 rounded-full border border-amber-500/20 bg-amber-500/10 px-2.5 py-0.5 text-xs font-medium text-amber-600"><Icon name="crown" class="size-3.5" />VIP</span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-border/60 bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground"><span class="size-1.5 rounded-full bg-muted-foreground/50" />Activo</span>
              </div>
              <p class="mt-1 text-xs text-muted-foreground/80">Cliente desde {CLIENTA.desde}</p>
            </div>
          </div>
          <span class="inline-flex h-[34px] shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-border/60 bg-white px-4 text-xs font-medium"><Icon name="receipt-text" class="size-3.5 text-muted-foreground" />Ver pedidos<span class="rounded-full bg-muted px-1.5 text-[10px] font-semibold">{CLIENTA.pedidos}</span></span>
        </div>

        <div class="space-y-7 px-7 pb-10">
          <div class="grid grid-cols-5 gap-x-6 border-y border-border/30 py-5">
            <div class="flex flex-col"><span class={etiqueta}>Pedidos</span><span class={metrica}>{CLIENTA.pedidos}</span></div>
            <div class="flex flex-col"><span class={etiqueta}>Total gastado</span><span class={metrica}>{pesos(CLIENTA.total)}</span></div>
            <div class="flex flex-col"><span class={etiqueta}>Ticket prom.</span><span class={metrica}>{pesos(CLIENTA.ticket)}</span></div>
            <div class="flex flex-col"><span class={etiqueta}>Cadencia</span><span class={metrica}>~{CLIENTA.cadencia} días</span></div>
            <div class="flex flex-col"><span class="flex items-center gap-1 text-[11px] font-medium uppercase tracking-wider text-amber-600"><Icon name="sparkles" class="size-3" />Puntos</span><span class="mt-1 text-[26px] font-black tabular-nums tracking-tight text-amber-600">{CLIENTA.puntos}</span></div>
          </div>

          <div class="grid grid-cols-12 gap-10">
            <div class="col-span-7 space-y-7">
              <div class="space-y-3">
                <span class={etiqueta}>Lo que más pide</span>
                <div class="flex flex-wrap gap-2">
                  {CLIENTA.top.map((t) => (
                    <span class="inline-flex items-center gap-2 rounded-full border border-border/50 bg-background/60 px-3.5 py-1.5 text-xs shadow-2xs"><span class="font-semibold tabular-nums text-foreground/70">{t.cantidad}×</span><span class="font-medium">{t.nombre}</span></span>
                  ))}
                </div>
              </div>
              <div class="grid grid-cols-2 gap-6">
                <div class="space-y-2">
                  <span class={etiqueta}>Campañas</span>
                  <div class="divide-y divide-border/20 border-y border-border/20">
                    {CLIENTA.campanas.map((c) => (
                      <div class="flex items-center justify-between py-2.5 text-xs">
                        <div class="min-w-0 pr-2"><p class="truncate font-medium">{c.nombre}</p><p class="text-[11px] text-muted-foreground">{c.pedidos} pedidos</p></div>
                        <span class="font-semibold tabular-nums">{pesos(c.total)}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="space-y-2">
                  <span class={etiqueta}>Cupones usados</span>
                  <div class="divide-y divide-border/20 border-y border-border/20">
                    {CLIENTA.cupones.map((c) => (
                      <div class="flex items-center justify-between py-2.5 text-xs">
                        <div class="min-w-0 pr-2"><span class="font-mono font-medium">{c.codigo}</span><p class="text-[11px] text-muted-foreground">{c.usos} uso</p></div>
                        <span class="font-semibold tabular-nums text-emerald-600">-{pesos(c.descontado)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            <div class="col-span-5 space-y-7">
              <div class="space-y-2">
                <span class={etiqueta}>Contacto</span>
                <div class="divide-y divide-border/25 border-y border-border/25">
                  <div class="flex items-center justify-between py-2.5 text-xs"><span class="text-muted-foreground">Teléfono</span><span class="font-medium">{CLIENTA.telefono}</span></div>
                  <div class="flex items-center justify-between py-2.5 text-xs"><span class="text-muted-foreground">Dirección</span><span class="font-medium">{CLIENTA.direccion}</span></div>
                  <div class="flex items-center justify-between py-2.5 text-xs"><span class="text-muted-foreground">Último pedido</span><span class="font-medium">{CLIENTA.ultimoPedido}</span></div>
                </div>
              </div>
              <div class="space-y-2">
                <span class={etiqueta}>Adquisición y actividad</span>
                <div class="divide-y divide-border/25 border-y border-border/25">
                  <div class="flex items-center justify-between py-2.5 text-xs"><span class="text-muted-foreground">Primera fuente</span><span class="font-medium">{CLIENTA.fuente}</span></div>
                  <div class="flex items-center justify-between py-2.5 text-xs"><span class="text-muted-foreground">Primera compra</span><span class="font-medium">{CLIENTA.primeraCompra}</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
