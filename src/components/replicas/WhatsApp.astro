---
import Icon from '../ui/Icon.astro'
import LogoLocal from './tienda/LogoLocal.astro'
import { cargarFotos } from '../../data/fotos'
import { LOCAL, MENSAJE_RECOMPRA, PEDIDO } from '../../data/demo'
import { pesos } from '../../data/oferta'

const FOTOS = await cargarFotos()

/**
 * Chat de WhatsApp del cliente con el local. Los textos son los de las plantillas reales:
 *  - `recompra`: 1º toque de un cliente "en riesgo" (backend/src/lib/recetas-recompra.ts), con la
 *    foto de su plato favorito como encabezado. Propuesta: el botón de la plantilla dice
 *    "Pedir ahora" en vez de "Visitar sitio web".
 *  - `avisos`: pedido confirmado y en camino (admin/public/mensaje_confirmado.png y _despachado.png).
 */
interface Props {
  modo?: 'recompra' | 'avisos'
}

const { modo = 'recompra' } = Astro.props
---

<div class="relative flex h-full w-full flex-col bg-[#EFEAE2] text-[#111b21]">
  <div class="z-10 flex h-[108px] shrink-0 items-end gap-2.5 border-b border-black/[.06] bg-[#F6F5F3]/95 px-3 pb-2.5 backdrop-blur">
    <span class="flex items-center text-[#007AFF]">
      <Icon name="chevron-left" class="size-7" stroke={2.4} />
      <span class="-ml-1 text-[17px]">12</span>
    </span>
    <span class="tienda contents"><LogoLocal size={38} soloIcono /></span>
    <div class="min-w-0 flex-1">
      <p class="flex items-center gap-1 text-[16.5px] font-semibold leading-tight">
        {LOCAL.nombre}
        <svg viewBox="0 0 24 24" class="size-[15px] text-[#1FAF55]" aria-hidden="true"><path fill="currentColor" d="m23 12-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.6 22.5l3.4-1.47 3.4 1.46 1.89-3.19 3.61-.82-.34-3.69L23 12Zm-12.91 4.72-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48-7.33 7.35Z" /></svg>
      </p>
      <p class="text-[12.5px] leading-tight text-[#667781]">Cuenta de empresa</p>
    </div>
    <span class="flex items-center gap-5 pb-1.5 pr-2 text-[#007AFF]">
      <Icon name="video" class="size-[22px]" />
      <Icon name="phone" class="size-[19px]" />
    </span>
  </div>

  <div class="flex-1 space-y-2 overflow-hidden px-3 pt-3">
    <div class="flex justify-center">
      <span class="rounded-lg bg-white/90 px-3 py-1 text-[12.5px] font-medium text-[#54656f] shadow-sm">Hoy</span>
    </div>

    {modo === 'recompra' ? (
      <div class="burbuja max-w-[318px]">
        <img src={FOTOS.smash.grande} alt="" loading="lazy" decoding="async" class="h-[172px] w-full rounded-[7px] object-cover" />
        <div class="px-1.5 pb-1 pt-2 text-[15.5px] leading-[1.38]">
          {MENSAJE_RECOMPRA.map((linea, i) => <p class:list={[i > 0 && 'mt-[1.1em]']}>{linea}</p>)}
          <p class="mt-1 text-right text-[11px] text-[#667781]">21:00</p>
        </div>
        <div class="-mx-1 mt-1 flex items-center justify-center gap-1.5 border-t border-black/[.08] pb-1 pt-2.5 text-[15.5px] font-medium text-[#00A884]">
          <Icon name="external-link" class="size-[17px]" stroke={2.2} />Pedir ahora
        </div>
      </div>
    ) : (
      <>
        <div class="burbuja max-w-[330px]">
          <div class="px-1.5 pb-1 pt-1 text-[15px] leading-[1.38]">
            <p class="font-bold">¡Pedido Confirmado!</p>
            <p>Hola {PEDIDO.primerNombre}, ¡buenas noticias!</p>
            <p class="mt-[1.1em]">Recibimos tu pago correctamente y tu pedido en {LOCAL.nombre} ya está en la cocina preparándose. 🍳</p>
            <p class="mt-[1.1em]">Total abonado: {pesos(PEDIDO.total)}</p>
            <p class="mt-1 text-right text-[11px] text-[#667781]">21:05</p>
          </div>
          <div class="-mx-1 mt-1 flex items-center justify-center gap-1.5 border-t border-black/[.08] pb-1 pt-2.5 text-[15px] font-medium text-[#00A884]">
            <Icon name="external-link" class="size-[17px]" stroke={2.2} />Ver Pedido
          </div>
        </div>
        <div class="burbuja max-w-[330px]">
          <div class="px-1.5 pb-1 pt-1 text-[15px] leading-[1.38]">
            <p class="font-bold">¡Tu comida está lista!</p>
            <p>Hola {PEDIDO.primerNombre}, te avisamos que tu pedido de {LOCAL.nombre} ya está en camino a tu domicilio 🛵</p>
            <p class="mt-[1.1em]">¡Que lo disfrutes! 😁</p>
            <p class="mt-1 flex items-end justify-between text-[11px] text-[#667781]"><span class="text-[13px]">¡Buen provecho!</span>21:31</p>
          </div>
        </div>
      </>
    )}
  </div>

  <div class="flex h-[92px] shrink-0 items-start gap-3 border-t border-black/[.06] bg-[#F6F5F3] px-3 pt-2.5 text-[#007AFF]">
    <Icon name="plus" class="mt-1 size-7" stroke={1.8} />
    <span class="h-9 flex-1 rounded-full border border-black/[.1] bg-white" />
    <Icon name="camera" class="mt-1.5 size-6" stroke={1.8} />
    <Icon name="mic" class="mt-1.5 size-6" stroke={1.8} />
  </div>
</div>
