---
import Escala from '../marcos/Escala.astro'
import PaginaAlfajor from '../replicas/paginas/PaginaAlfajor.astro'
import PaginaChe from '../replicas/paginas/PaginaChe.astro'
import Plantilla from '../replicas/paginas/Plantilla.astro'

/**
 * Intro a pantalla completa antes de la portada (como la de context-con.com): una frase, otra,
 * caen tres páginas con diseños distintos, la última frase y la capa sube y deja la portada.
 * Todo es CSS con retrasos; el script sólo la saltea (clic, Enter, Espacio o Esc) y la saca al
 * terminar. Sale una vez por sesión; sin JS o con movimiento reducido no aparece.
 */
const primera = 'Cuidaste cada detalle de tu marca'
const lineas = [
  { texto: 'Pero para vender online, todas las tiendas eran iguales', acento: 'iguales', inicio: 2.1 },
  { texto: 'Ahora tu tienda puede tener tu diseño', subrayado: 'diseño', inicio: 5.8 },
]
const cartas = [
  { nombre: 'Alfajor con Papas', x: -150, y: -10, r: -8, xm: -56, ym: -24 },
  { nombre: 'Che Milanesa', x: 150, y: 12, r: 7, xm: 56, ym: 6 },
  { nombre: 'Plantilla Moderna', x: 0, y: 34, r: -2, xm: 0, ym: 36 },
]
const limpia = (p: string) => p.replace(/[^\p{L}']/gu, '')
---

<script is:inline>
  try {
    if (sessionStorage.getItem('piru-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('sin-intro')
  } catch (e) {}
</script>

<div class="intro fixed inset-0 z-[70] cursor-pointer select-none overflow-hidden">
  <div aria-hidden="true" class="i-superficie absolute inset-x-0 -top-32 bottom-0 rounded-b-[56px] bg-paper shadow-[0_30px_80px_rgb(40_24_8/.16)]">
    <div class="i-contenido absolute inset-x-0 bottom-0 top-32 grid place-items-center px-6 text-center [perspective:900px]">
      <p class="i-frase i-hola col-start-1 row-start-1 max-w-[14ch] text-[2.6rem] font-bold leading-[.98] tracking-[-.04em] sm:text-6xl lg:text-7xl">
        {primera.split(' ').map((p, i) => <><span class="i-palabra" style={`--d:${0.15 + i * 0.07}s`}>{p}</span>{' '}</>)}
      </p>

      {lineas.map((l, n) => (
        <p class="i-frase col-start-1 row-start-1 max-w-[16ch] text-[2.2rem] font-bold leading-[1] tracking-[-.04em] sm:text-5xl lg:text-6xl" style={`--fin:${n === 0 ? 3.9 : 7.4}s`}>
          {l.texto.split(' ').map((p, i) => (
            <><span class:list={['i-palabra relative', limpia(p) === l.acento && 'text-brand']} style={`--d:${l.inicio + i * 0.045}s`}>{p}{limpia(p) === l.subrayado && <span class="i-subrayado absolute inset-x-0 -bottom-[.04em] h-[.1em] rounded-full bg-brand" />}</span>{' '}</>
          ))}
        </p>
      ))}

      <div class="i-pila relative col-start-1 row-start-1 h-[70vh] w-full max-w-xl">
        {cartas.map((c, i) => (
          <figure class="i-carta absolute left-1/2 top-1/2 m-0 w-[min(56vw,240px,38vh)] bg-white p-2 pb-8 shadow-[0_24px_60px_rgb(0_0_0/.2)]" style={`--x:${c.x}px;--y:${c.y}px;--xm:${c.xm}px;--ym:${c.ym}px;--r:${c.r}deg;--d:${4 + i * 0.3}s`}>
            <Escala ancho={390} alto={600} etiqueta="" class="i-pagina">
              {i === 0 && <PaginaAlfajor video={false} carrito={false} />}
              {i === 1 && <PaginaChe />}
              {i === 2 && <Plantilla plantilla="moderna" />}
            </Escala>
            <figcaption class="absolute inset-x-0 bottom-0 flex h-8 items-center justify-center text-[12px] font-semibold text-ink-2">{c.nombre}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
  <button type="button" class="i-saltar absolute bottom-5 right-5 rounded-full px-3 py-1.5 text-[13px] font-medium text-ink-3 hover:text-ink">Saltar</button>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('.intro')
  if (intro && getComputedStyle(intro).display !== 'none') {
    const raiz = document.documentElement
    raiz.style.overflow = 'hidden'
    try { sessionStorage.setItem('piru-intro', '1') } catch {}

    const terminar = () => {
      raiz.style.overflow = ''
      intro.remove()
      removeEventListener('keydown', tecla)
    }
    const saltar = () => intro.classList.add('saltar')
    const tecla = (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Escape') { e.preventDefault(); saltar() }
    }
    intro.addEventListener('pointerdown', saltar)
    addEventListener('keydown', tecla)
    intro.querySelector('.i-superficie')!.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'i-sube' && e.target === e.currentTarget) terminar()
    })
    setTimeout(terminar, 11000)
  }
</script>

<style>
  .intro { display: none; }
  :global(html.js:not(.sin-intro)) .intro { display: block; }

  /* La página real tiene fondo propio y tipografía de la app. */
  .i-pagina { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; font-feature-settings: "cv11", "ss01"; }

  .i-palabra {
    display: inline-block;
    animation: i-palabra .6s cubic-bezier(.16, 1, .3, 1) var(--d) both;
  }
  .i-hola { animation: i-fuera .3s cubic-bezier(.32, 0, .67, 0) 1.9s forwards; }
  .i-frase:not(.i-hola) { animation: i-fuera .28s cubic-bezier(.32, 0, .67, 0) var(--fin) forwards; }
  .i-subrayado {
    transform: scaleX(0);
    transform-origin: left;
    animation: i-subraya .3s cubic-bezier(.65, 0, .35, 1) 6.4s forwards;
  }

  .i-pila {
    animation:
      i-pila .6s cubic-bezier(.65, 0, .35, 1) 5.6s forwards,
      i-pila-sale .45s cubic-bezier(.32, 0, .67, 0) 7.4s forwards;
  }
  .i-carta {
    --tx: var(--x);
    --ty: var(--y);
    animation: i-carta .45s cubic-bezier(.34, 1.8, .64, 1) var(--d) both;
  }
  @media (max-width: 639px) {
    .i-carta { --tx: var(--xm); --ty: var(--ym); }
  }

  .i-superficie { animation: i-sube .85s cubic-bezier(.76, 0, .24, 1) 7.6s forwards; }

  /* Saltear: se va el contenido y sube la capa ya. */
  .saltar .i-contenido, .saltar .i-saltar { opacity: 0; transition: opacity .2s; }
  .saltar .i-superficie { animation: i-sube .7s cubic-bezier(.76, 0, .24, 1) .1s forwards; }

  @keyframes i-palabra {
    from { opacity: 0; transform: translateY(46px) rotateX(-45deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes i-fuera {
    to { opacity: 0; transform: translateY(-30px) scale(.94); visibility: hidden; }
  }
  @keyframes i-subraya { to { transform: scaleX(1); } }
  @keyframes i-carta {
    from { opacity: 0; transform: translate(-50%, -50%) translate(var(--tx), calc(var(--ty) + 50px)) rotate(calc(var(--r) + 16deg)) scale(1.55); }
    to { opacity: 1; transform: translate(-50%, -50%) translate(var(--tx), var(--ty)) rotate(var(--r)); }
  }
  @keyframes i-pila {
    to { transform: translateY(40vh) scale(.42) rotate(-6deg); }
  }
  @keyframes i-pila-sale {
    from { transform: translateY(40vh) scale(.42) rotate(-6deg); }
    to { transform: translateY(90vh) scale(.42) rotate(-6deg); opacity: 0; }
  }
  @keyframes i-sube { to { transform: translateY(-120%); } }
</style>
