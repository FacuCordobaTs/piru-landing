---
/**
 * La página para locales ahora es la home. /locales sigue viva porque los marketers comparten
 * /locales?ref=CODIGO (marketers/src/pages/Cartera.tsx): redirige a / conservando la consulta y el
 * ancla, así el código de referido llega igual (lo guarda el script de layouts/Base.astro). Las
 * redirecciones de astro.config.mjs no sirven acá: generan un meta refresh que pierde la consulta.
 */
const sitio = Astro.site?.toString().replace(/\/$/, '') ?? 'https://piru.app'
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Piru · Tu tienda online sin comisiones</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${sitio}/`} />
    <script is:inline>location.replace('/' + location.search + location.hash)</script>
    <noscript><meta http-equiv="refresh" content="0; url=/" /></noscript>
  </head>
  <body>
    <a href="/">Ir a Piru</a>
  </body>
</html>
