---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import Ventana from '../marcos/Ventana.astro'
import Telefono from '../marcos/Telefono.astro'
import PanelCampanas from '../replicas/panel/PanelCampanas.astro'
import CampanasMovil from '../replicas/panel/CampanasMovil.astro'
import { CAMPANAS } from '../../data/demo'
import { pesos } from '../../data/oferta'

const reel = CAMPANAS.find((c) => c.slug === 'reel-papas')!
const bolsa = CAMPANAS.find((c) => c.slug === 'bolsas')!
const canales = ['Historias de Instagram', 'Reels y TikTok', 'Meta Ads', 'QR en el salón', 'Bolsas de delivery', 'Estados de WhatsApp', 'Influencers']
---

<section id="campanas" class="bg-sand py-24 sm:py-32">
  <div class="contenedor">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-end">
      <div class="revelar">
        <p class="antetitulo">Tus publicaciones</p>
        <h2 class="titulo-lg mt-4">Sabé qué publicación te trae ventas</h2>
        <p class="bajada mt-5 max-w-xl">Cada historia, reel, QR o influencer lleva su propio link. A fin de mes ves cuál trajo pedidos cobrados, no sólo likes. Y un link puede abrir tu tienda, un producto en promo o un carrito ya armado.</p>
      </div>
      <div class="revelar rounded-[24px] bg-white p-6 ring-1 ring-line" style="--retraso:100ms">
        <p class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[.08em] text-brand-deep"><Icon name="info" class="size-4" />Lo que te muestra</p>
        <p class="mt-3 text-[17px] leading-snug text-ink">
          El reel tuvo casi <b class="font-semibold">9 veces más visitas</b> que el QR de las bolsas de delivery. Pero el QR vendió <b class="font-semibold">más del triple</b>: {pesos(bolsa.ventas)} contra {pesos(reel.ventas)}.
        </p>
      </div>
    </div>

    <ul class="revelar mt-8 flex flex-wrap gap-2">
      {canales.map((c) => <li class="rounded-full bg-white px-3.5 py-1.5 text-[14px] font-medium text-ink-2 ring-1 ring-line">{c}</li>)}
    </ul>

    <div class="revelar mx-auto mt-12 w-[min(74%,300px)] drop-shadow-[0_30px_50px_rgba(40,20,5,0.28)] md:hidden">
      <Escala ancho={412} alto={866} etiqueta="Campañas en el celular: cada link con sus visitas, pedidos y ventas cobradas de septiembre">
        <Telefono><CampanasMovil /></Telefono>
      </Escala>
    </div>
    <div class="revelar mt-12 hidden md:block">
      <div class="-mx-8 overflow-x-auto px-8 pb-4 sin-barra lg:mx-0 lg:overflow-visible lg:px-0 lg:pb-0">
        <div class="min-w-[760px] overflow-hidden rounded-[18px] shadow-[0_2px_4px_rgb(40_24_8/.06),0_40px_80px_-30px_rgb(40_24_8/.35)] lg:min-w-0">
          <Escala ancho={1280} alto={720} etiqueta="Campañas: ranking de links con visitas, pedidos y ventas cobradas de septiembre">
            <Ventana ancho={1280} alto={720}>
              <PanelCampanas />
            </Ventana>
          </Escala>
        </div>
      </div>
      <p class="mt-2 text-center text-[13px] text-ink-3 lg:hidden">Deslizá para ver la pantalla completa →</p>
    </div>

    <p class="revelar mt-8 flex items-center justify-center gap-2 text-center text-[15px] text-ink-2">
      <Icon name="badge-check" class="size-5 text-emerald-600" />Los links de campaña y los cupones vienen incluidos, sin costo extra. Si hacés publicidad, también conectás tu Pixel de Meta.
    </p>
  </div>
</section>
