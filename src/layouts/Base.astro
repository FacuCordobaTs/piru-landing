---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Pie from '../components/Pie.astro'
import { PRECIO_BASE } from '../data/oferta'

interface Props {
  titulo?: string
  descripcion?: string
  /** Ruta canónica; los datos estructurados del producto van sólo en las dos portadas. */
  canonical?: string
  /** A quién le habla la página: cambia el menú (la home es para marketers). */
  pagina?: 'marketers' | 'locales'
}

const {
  titulo = 'Piru · Tienda online, clientes y recompra para gastronomía',
  descripcion = 'La tienda online, la base de clientes y la recompra de los locales gastronómicos, y la app de los marketers que los hacen crecer. Precio fijo, sin comisión por venta.',
  canonical = Astro.url.pathname,
  pagina = 'marketers',
} = Astro.props

const sitio = Astro.site?.toString().replace(/\/$/, '') ?? 'https://piru.app'
const url = `${sitio}${canonical}`
const imagen = `${sitio}/logopiru.jpeg`
const portada = canonical === '/' || canonical === '/locales'
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#FFFCF7" />

    <link rel="icon" type="image/jpeg" href="/piru/logo.jpg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Piru" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap" rel="stylesheet" />

    <script is:inline>document.documentElement.classList.add('js')</script>

    {portada && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: 'Piru',
          url,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web, Windows',
          description: descripcion,
          offers: { '@type': 'Offer', price: String(PRECIO_BASE), priceCurrency: 'ARS' },
        })}
      />
    )}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    <Nav pagina={pagina} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />

    <script>
      // Aparición suave de bloques al entrar en pantalla.
      const revelables = document.querySelectorAll<HTMLElement>('.revelar')
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add('visible')
              io.unobserve(e.target)
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 })
        revelables.forEach((el) => io.observe(el))
      } else {
        revelables.forEach((el) => el.classList.add('visible'))
      }

      // Navegadores sin tan(atan2()) en CSS: la escala de las réplicas se calcula acá.
      if (!CSS.supports('transform', 'scale(tan(atan2(1px, 2px)))')) {
        const ro = new ResizeObserver((entradas) => {
          for (const e of entradas) {
            const el = e.target as HTMLElement
            const w = Number(getComputedStyle(el).getPropertyValue('--escala-w')) || 1
            el.style.setProperty('--escala-k', String(el.clientWidth / w))
          }
        })
        document.querySelectorAll<HTMLElement>('.escala').forEach((el) => ro.observe(el))
      }

      // Código de marketer: un link como piru.app/locales?ref=AGUS deja el código en este
      // navegador y lo suma al mensaje de los links a nuestro WhatsApp, para que la consulta
      // del local nos llegue a nombre de su marketer (docs/MVP_MARKETERS.md §7).
      const CLAVE_REF = 'piru-ref'
      const valido = (c: string) => /^[A-Z0-9_-]{2,32}$/.test(c)
      let codigo = (new URLSearchParams(location.search).get('ref') ?? '').trim().toUpperCase()
      try {
        if (valido(codigo)) localStorage.setItem(CLAVE_REF, codigo)
        else codigo = (localStorage.getItem(CLAVE_REF) ?? '').toUpperCase()
      } catch {
        // Sin almacenamiento (modo privado, cookies bloqueadas): vale sólo para esta visita.
      }
      if (valido(codigo)) {
        const firma = `Vengo de parte de ${codigo}.`
        document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"]').forEach((a) => {
          const destino = new URL(a.href)
          const texto = destino.searchParams.get('text') ?? ''
          if (texto.includes(firma)) return
          a.href = `${destino.origin}${destino.pathname}?text=${encodeURIComponent(texto ? `${texto}\n\n${firma}` : firma)}`
        })
        document.querySelectorAll<HTMLElement>('[data-ref]').forEach((el) => {
          el.querySelectorAll('[data-ref-codigo]').forEach((c) => { c.textContent = codigo })
          el.hidden = false
        })
      }
    </script>
  </body>
</html>
