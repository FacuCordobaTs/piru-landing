---
import Icon from '../../ui/Icon.astro'
import Barra from './Barra.astro'
import { COMANDA_MESA, MESAS } from '../../../data/demo'
import { pesos } from '../../../data/oferta'

/**
 * Réplica del salón en Inicio (Dashboard.tsx con POS + Mesas activos): la grilla de mesas
 * (`MesasGrid`) y, a la derecha, la comanda de la mesa abierta en el punto de venta.
 */
const ocupadas = MESAS.filter((m) => m.cliente).length
const items = [...COMANDA_MESA.confirmados, ...COMANDA_MESA.porConfirmar]
const total = items.reduce((s, i) => s + i.precio, 0)
---

<div class="flex h-full w-full bg-[#FFFBF0] text-foreground">
  <Barra activo="inicio" compacta />

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
      <div class="flex-1" />
      <div class="flex items-center gap-1.5 px-2 py-1">
        <p class="text-2xl font-bold tracking-tight">Hoy</p>
        <Icon name="chevrons-up-down" class="size-5 text-muted-foreground" />
      </div>
      <div class="flex flex-1 items-center justify-end gap-2">
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium"><Icon name="calendar-days" class="size-4" />Caja</span>
        <span class="inline-flex h-10 items-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-medium"><Icon name="map" class="size-4" />Mapa</span>
      </div>
    </header>

    <div class="relative flex min-h-0 flex-1 gap-4 p-4 pt-1">
      <div class="absolute inset-x-4 top-1 z-10 flex h-11 items-center justify-center rounded-xl bg-[#FF7A00] text-base font-bold text-white">+ Nuevo pedido</div>

      <div class="mt-14 flex w-[420px] shrink-0 flex-col">
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-1 rounded-xl bg-muted/60 p-1">
            <span class="flex h-8 items-center gap-2 rounded-lg px-3 text-sm font-bold text-muted-foreground">Pedidos <span class="rounded-full bg-[#FF7A00] px-2 text-xs font-semibold leading-5 text-white">6</span></span>
            <span class="flex h-8 items-center gap-1.5 rounded-lg bg-background px-3 text-sm font-bold shadow-sm"><Icon name="armchair" class="size-3.5" />Mesas <span class="rounded-full bg-[#FF7A00] px-2 text-xs font-semibold leading-5 text-white">{ocupadas}</span></span>
          </div>
          <span class="flex size-8 items-center justify-center rounded-md border border-border bg-background"><Icon name="ellipsis-vertical" class="size-4" /></span>
        </div>
        <div class="grid grid-cols-5 gap-2 p-3 pt-1">
          {MESAS.map((m) => (
            <div class="relative aspect-square">
              <div class:list={[
                'relative flex h-full w-full items-center justify-center rounded-lg border text-base font-black tabular-nums shadow-sm',
                m.cliente ? 'border-[#FF7A00]/35 bg-[#FF7A00]/15 text-[#C45F00]' : 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700',
                m.numero === 4 && 'ring-2 ring-[#FF7A00] ring-offset-2 ring-offset-[#FFFBF0]',
              ]}>
                {m.numero}
                {m.cliente && <span class="absolute inset-x-1 bottom-1 truncate text-center text-[10px] font-semibold leading-tight">{m.cliente}</span>}
              </div>
              <span class="absolute right-0.5 top-0.5 grid size-6 place-items-center rounded-md bg-background/85 text-muted-foreground shadow-sm"><Icon name="ellipsis-vertical" class="size-3.5" /></span>
            </div>
          ))}
        </div>
        <div class="flex items-center gap-4 px-4 pt-3 text-xs text-muted-foreground">
          <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm border border-emerald-500/40 bg-emerald-500/20" />Libre</span>
          <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm border border-[#FF7A00]/40 bg-[#FF7A00]/25" />Ocupada</span>
        </div>
      </div>

      <div class="relative mt-14 flex min-w-0 flex-1 flex-col overflow-hidden rounded-2xl">
        <div class="mx-auto w-full max-w-[600px] px-6 pt-5">
          <p class="text-4xl font-black leading-none tracking-tight">{COMANDA_MESA.mesa}</p>
          <p class="mt-3 text-xl font-bold">Juan</p>
          <div class="my-5 h-px bg-border/60" />
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-muted-foreground">Comanda · {items.reduce((s, i) => s + i.cantidad, 0)} ítems</p>
          {items.map((it, i) => (
            <div class:list={['flex items-center justify-between gap-3 py-3', i > 0 && 'border-t border-border/40']}>
              <div class="min-w-0 flex-1">
                <p class="text-base font-semibold leading-snug"><span class="mr-1.5 tabular-nums text-muted-foreground">{it.cantidad}×</span>{it.nombre}</p>
                {COMANDA_MESA.porConfirmar.includes(it) && <p class="mt-0.5 text-xs font-semibold text-[#FF7A00]">Lo agregó el mozo · nuevo</p>}
              </div>
              <span class="text-base font-semibold tabular-nums">{pesos(it.precio)}</span>
            </div>
          ))}
        </div>

        <div class="absolute inset-x-0 bottom-0 bg-[#FFFBF0]">
          <div class="mx-auto flex w-full max-w-[600px] flex-col gap-3 px-6 pb-5 pt-3">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Total</span>
              <span class="text-3xl font-black tracking-tight text-[#FF7A00]">{pesos(total)}</span>
            </div>
            <div class="flex items-center justify-end gap-1.5 text-xs font-semibold text-emerald-700"><Icon name="circle-check" class="size-3.5" />Guardado</div>
            <div class="flex items-center gap-2">
              <span class="flex h-14 flex-1 items-center justify-center rounded-2xl bg-[#FF7A00] text-lg font-bold text-white opacity-50">Guardar cambios</span>
              <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-[#FF7A00] text-white"><Icon name="armchair" class="size-5" /></span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <span class="flex h-11 items-center justify-center gap-1.5 rounded-xl border border-border bg-background text-xs font-bold"><Icon name="printer" class="size-4" />Imprimir productos nuevos</span>
              <span class="flex h-11 items-center justify-center gap-1.5 rounded-xl border border-border bg-background text-xs font-bold"><Icon name="printer" class="size-4" />Reimprimir comanda entera</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
