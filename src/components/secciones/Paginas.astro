---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import Telefono from '../marcos/Telefono.astro'
import PaginaAlfajor from '../replicas/paginas/PaginaAlfajor.astro'
import PaginaChe from '../replicas/paginas/PaginaChe.astro'
import { PAGINAS, TEXTO_WA_DISENO, enlaceWhatsapp } from '../../data/oferta'

/**
 * Páginas publicadas con Piru, cada una en una tarjeta del color de su marca con la réplica de su
 * página en un celular. La tercera tarjeta es la invitación: "la tuya". Los textos están en
 * data/oferta.ts (PAGINAS).
 */
const [alfajor, che] = PAGINAS
---

<section id="paginas" class="py-24 sm:py-32">
  <div class="contenedor">
    <div class="revelar mx-auto max-w-3xl text-center">
      <p class="antetitulo">Hechas con Piru</p>
      <h2 class="titulo-lg mt-4">Ninguna se parece a otra</h2>
      <p class="bajada mx-auto mt-5 max-w-2xl">Cada local con su letra, sus colores y su manera de contar lo que cocina. Por debajo, todas usan la misma carta, el mismo carrito y el mismo panel.</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <article class="revelar relative flex flex-col overflow-hidden rounded-[32px] lg:col-span-7 lg:flex-row" style={`background:${alfajor.fondo};color:${alfajor.tinta}`}>
        <div class="flex flex-col justify-between gap-6 p-7 sm:p-9 lg:w-[48%]">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-[12.5px] font-semibold ring-1 ring-white/15"><Icon name="sparkles" class="size-3.5 text-[#eb623a]" />Diseño a medida</span>
            <h3 class="mt-5 text-[30px] font-bold leading-[1.05] tracking-[-0.03em]">{alfajor.nombre}</h3>
            <p class="mt-3 text-[15.5px] leading-relaxed opacity-85">{alfajor.texto}</p>
          </div>
          <div>
            <p class="text-[13.5px] opacity-70">La diseñamos con ellos, a partir de su marca.</p>
            <a href={alfajor.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-[#eb623a] px-4 py-2.5 text-[14.5px] font-semibold text-[#083821] transition-transform hover:-translate-y-0.5">
              {alfajor.dominio}<Icon name="arrow-up-right" class="size-4" />
            </a>
          </div>
        </div>
        <div class="relative flex flex-1 justify-center px-8 pt-4 lg:items-end lg:pt-12">
          <div class="w-[min(76%,290px)] translate-y-10 rotate-2 drop-shadow-[0_30px_50px_rgba(0,0,0,0.45)] lg:w-[88%]">
            <Escala ancho={412} alto={866} etiqueta={`La página de ${alfajor.nombre} en un celular: el titular, el video de la portada y la carta`}>
              <Telefono url={alfajor.dominio}><PaginaAlfajor /></Telefono>
            </Escala>
          </div>
        </div>
      </article>

      <div class="flex flex-col gap-5 lg:col-span-5">
        <article class="revelar relative flex flex-1 flex-col overflow-hidden rounded-[32px] text-white sm:min-h-[380px] sm:flex-row" style={`background:${che.fondo};--retraso:90ms`}>
          <div class="flex flex-col justify-between gap-6 p-7 sm:w-[55%] sm:p-8">
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-[12.5px] font-semibold ring-1 ring-white/15"><Icon name="sparkles" class="size-3.5 text-[#ffb800]" />Diseño a medida</span>
              <h3 class="mt-5 text-[26px] font-bold leading-[1.05] tracking-[-0.03em] text-[#ffb800]">{che.nombre}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-white/80">{che.texto}</p>
            </div>
            <a href={che.url} target="_blank" rel="noopener" class="inline-flex w-fit items-center gap-1.5 rounded-full bg-[#ffb800] px-4 py-2.5 text-[14px] font-semibold text-black transition-transform hover:-translate-y-0.5">
              {che.dominio}<Icon name="arrow-up-right" class="size-4" />
            </a>
          </div>
          <div class="relative h-[320px] shrink-0 overflow-hidden sm:h-auto sm:flex-1 sm:shrink sm:overflow-visible">
            <div class="absolute left-1/2 top-2 w-[220px] -translate-x-1/2 -rotate-3 drop-shadow-[0_30px_50px_rgba(0,0,0,0.6)] sm:left-auto sm:-right-2 sm:top-8 sm:w-[230px] sm:translate-x-0">
              <Escala ancho={412} alto={866} etiqueta={`La página de ${che.nombre} en un celular: el titular y el club de puntos`}>
                <Telefono url={che.dominio} tono="oscuro" tonoNavegador="oscuro"><PaginaChe /></Telefono>
              </Escala>
            </div>
          </div>
        </article>

        <a href={enlaceWhatsapp(TEXTO_WA_DISENO)} target="_blank" rel="noopener" class="revelar group flex items-center gap-5 rounded-[32px] border-2 border-dashed border-brand/40 bg-brand-soft/60 p-7 transition-colors hover:border-brand hover:bg-brand-soft" style="--retraso:180ms">
          <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-brand text-white transition-transform group-hover:rotate-6"><Icon name="plus" class="size-6" stroke={2.4} /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[20px] font-semibold tracking-tight text-ink">La de tu local</span>
            <span class="mt-1 block text-[15px] leading-relaxed text-ink-2">Contanos cómo es tu local y la diseñamos con vos, o arrancala con una plantilla.</span>
          </span>
          <Icon name="arrow-up-right" class="size-5 shrink-0 text-brand-deep transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </div>
</section>
