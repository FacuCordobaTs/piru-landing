---
import Icon from '../ui/Icon.astro'
import type { NombreIcono } from '../ui/lucide'
import { COMISION_MARKETER, PRECIO_BASE, RETENCION, pesos } from '../../data/oferta'

const LOCALES_INICIAL = 8
const conRetencion = PRECIO_BASE + RETENCION.precio
const porLocal = (conRetencion * COMISION_MARKETER) / 100

const puntos: { icono: NombreIcono; texto: string }[] = [
  { icono: 'hand-coins', texto: 'Lo ves en tu app, factura por factura y local por local.' },
  { icono: 'badge-check', texto: 'El precio del local no cambia: tu comisión la pone Piru.' },
  { icono: 'trending-up', texto: 'Si el local suma Retención, tu comisión crece con él.' },
]
---

<section id="comision" class="py-24 sm:py-32">
  <div class="contenedor">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-end">
      <div class="revelar">
        <p class="antetitulo">Tu comisión</p>
        <h2 class="titulo-lg mt-4">Cobrás por cada local. Todos los meses.</h2>
        <p class="bajada mt-5 max-w-xl">Por cada local que sumás, Piru te paga el {COMISION_MARKETER}% de lo que ese local paga por mes, mientras siga trabajando con vos. Sin tope de locales.</p>
      </div>
      <ul class="revelar space-y-3.5" style="--retraso:100ms">
        {puntos.map((p) => (
          <li class="flex gap-3 text-[16px] text-ink-2"><span class="grid size-8 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand-deep"><Icon name={p.icono} class="size-4" /></span><span class="pt-1">{p.texto}</span></li>
        ))}
      </ul>
    </div>

    <div id="calculadora-comision" class="revelar mt-12 overflow-hidden rounded-[28px] bg-ink text-white">
      <div class="grid lg:grid-cols-2">
        <div class="p-7 sm:p-10">
          <p class="antetitulo text-brand">Hacé la cuenta</p>
          <h3 class="mt-3 text-[28px] font-bold leading-tight tracking-[-0.03em] sm:text-[34px]">¿Cuánto cobrás por tus locales?</h3>

          <div class="mt-9 space-y-8">
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for="com-locales" class="text-[15px] text-white/70">Locales que sumás</label>
                <output id="com-locales-valor" class="text-[20px] font-semibold tabular-nums">{LOCALES_INICIAL}</output>
              </div>
              <input id="com-locales" type="range" min="1" max="30" step="1" value={LOCALES_INICIAL} class="rango mt-3" />
            </div>

            <fieldset>
              <legend class="text-[15px] text-white/70">Qué pagan tus locales</legend>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <label class="plan">
                  <input type="radio" name="com-plan" value="base" class="sr-only" />
                  <span><b>Base</b><small>{pesos(PRECIO_BASE)} / mes</small></span>
                </label>
                <label class="plan">
                  <input type="radio" name="com-plan" value="retencion" checked class="sr-only" />
                  <span><b>Base + {RETENCION.nombre}</b><small>{pesos(conRetencion)} / mes</small></span>
                </label>
              </div>
            </fieldset>
          </div>
        </div>

        <div class="flex flex-col justify-center gap-6 bg-white/[.04] p-7 sm:p-10" aria-live="polite">
          <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5">
            <span class="text-[15px] text-white/70">Cada local paga por mes</span>
            <span id="com-paga" class="text-[22px] font-semibold tabular-nums">{pesos(conRetencion)}</span>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5">
            <span class="text-[15px] text-white/70">Tu {COMISION_MARKETER}% por local</span>
            <span id="com-por-local" class="text-[22px] font-semibold tabular-nums">{pesos(porLocal)}</span>
          </div>
          <div>
            <p class="text-[15px] text-white/70">Cobrás por mes</p>
            <p id="com-mes" class="mt-1 text-[48px] font-bold leading-none tracking-[-0.04em] tabular-nums text-emerald-300 sm:text-[56px]">+{pesos(porLocal * LOCALES_INICIAL)}</p>
            <p class="mt-3 text-[15px] text-white/70">En un año: <span id="com-anio" class="font-semibold tabular-nums text-white">{pesos(porLocal * LOCALES_INICIAL * 12)}</span></p>
          </div>
          <p class="text-[12.5px] leading-relaxed text-white/40">Cálculo de ejemplo con los precios de hoy. La comisión es sobre lo que paga cada local por su suscripción (base y adicionales, sin recargas de mensajes), desde que paga y mientras te dé acceso.</p>
        </div>
      </div>
    </div>

    <p class="revelar mt-6 text-center text-[15px] text-ink-2">Y lo que más vale no entra en la cuenta: <b class="font-semibold text-ink">un cliente que ve cuánto vendió, no se va.</b></p>
  </div>
</section>

<style>
  .rango {
    width: 100%;
    height: 28px;
    appearance: none;
    background: transparent;
    cursor: pointer;
    --lleno: 24%;
  }
  .rango::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-brand) var(--lleno), rgb(255 255 255 / .16) var(--lleno));
  }
  .rango::-moz-range-track { height: 6px; border-radius: 999px; background: rgb(255 255 255 / .16); }
  .rango::-moz-range-progress { height: 6px; border-radius: 999px; background: var(--color-brand); }
  .rango::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    margin-top: -9px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 4px rgb(255 122 0 / .35), 0 2px 6px rgb(0 0 0 / .4);
  }
  .rango::-moz-range-thumb { width: 24px; height: 24px; border: 0; border-radius: 999px; background: #fff; box-shadow: 0 0 0 4px rgb(255 122 0 / .35); }
  .rango:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 4px; }

  .plan span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgb(255 255 255 / .06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1);
    cursor: pointer;
    transition: background-color .2s, box-shadow .2s;
  }
  .plan b { font-size: 15px; font-weight: 600; }
  .plan small { font-size: 13px; color: rgb(255 255 255 / .6); }
  .plan input:checked + span { background: var(--color-brand); box-shadow: none; }
  .plan input:checked + span small { color: rgb(255 255 255 / .85); }
  .plan input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
</style>

<script>
  import { COMISION_MARKETER, PRECIO_BASE, RETENCION } from '../../data/oferta'

  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 })
  const pesos = (n: number) => `$${fmt.format(Math.round(n))}`
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null

  const locales = $<HTMLInputElement>('com-locales')
  const planes = document.querySelectorAll<HTMLInputElement>('input[name="com-plan"]')

  function calcular() {
    if (!locales) return
    const n = Number(locales.value)
    const conRetencion = [...planes].find((p) => p.checked)?.value !== 'base'
    const paga = PRECIO_BASE + (conRetencion ? RETENCION.precio : 0)
    const porLocal = (paga * COMISION_MARKETER) / 100
    $('com-locales-valor')!.textContent = String(n)
    $('com-paga')!.textContent = pesos(paga)
    $('com-por-local')!.textContent = pesos(porLocal)
    $('com-mes')!.textContent = `+${pesos(porLocal * n)}`
    $('com-anio')!.textContent = pesos(porLocal * n * 12)
    const min = Number(locales.min), max = Number(locales.max)
    locales.style.setProperty('--lleno', `${((n - min) / (max - min)) * 100}%`)
  }

  locales?.addEventListener('input', calcular)
  planes.forEach((p) => p.addEventListener('change', calcular))
  calcular()
</script>
