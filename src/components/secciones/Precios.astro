---
import Icon from '../ui/Icon.astro'
import { CREAR_TIENDA, PLANES, TABLA_PLANES, TEXTO_WA_EVOLUCION, enlaceWhatsapp, pesos } from '../../data/oferta'

/**
 * Los cinco planes (espejo de `plan_tienda`, ver data/oferta.ts y docs/PLANES_TIENDA.md): arriba
 * una tarjeta por plan con el precio y lo principal en una línea; abajo la tabla con qué trae cada
 * uno (`TABLA_PLANES`). El selector Mensual/Anual cambia el precio sin recargar; sin JS se ve el mensual.
 */
const precioAnual = (precio: number, descuento: number) => Math.round(precio * (1 - descuento / 100))
const hayAnual = PLANES.some((p) => p.descuentoAnual > 0)
---

<section id="precios" data-tema="papel" class="py-24 sm:py-32">
  <div class="contenedor">
    <div class="mx-auto max-w-3xl text-center">
      <p class="revelar antetitulo">Precios</p>
      <h2 class="revelar titulo-lg mt-4" style="--retraso:60ms">Empezá gratis. Crecé cuando quieras.</h2>
      <p class="revelar t2 mx-auto mt-5 max-w-xl text-[18px] leading-relaxed" style="--retraso:120ms">Pedidos ilimitados y cero comisión por venta en todos los planes.</p>
    </div>

    {hayAnual && (
      <div class="revelar mt-10 flex justify-center" style="--retraso:160ms">
        <div class="ciclo inline-flex rounded-full bg-sand p-1 ring-1 ring-line" role="radiogroup" aria-label="Ciclo de pago">
          <button type="button" role="radio" aria-checked="true" data-ciclo="mensual">Mensual</button>
          <button type="button" role="radio" aria-checked="false" data-ciclo="anual">Anual · 20% menos</button>
        </div>
      </div>
    )}

    <div class="planes mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-ciclo="mensual">
      {PLANES.map((p, i) => {
        const aMedida = p.precio === null
        const gratis = p.precio === 0
        return (
          <article
            class:list={['revelar relative flex flex-col rounded-[24px] p-6', p.destacado ? 'bg-ink text-white shadow-[0_30px_60px_-30px_rgb(25_21_18/.6)]' : 'bg-white ring-1 ring-line']}
            style={`--retraso:${i * 60}ms`}
          >
            {p.destacado && <span class="absolute -top-3 left-6 rounded-full bg-brand px-3 py-1 text-[12px] font-semibold text-white">Recomendado</span>}
            <h3 class="text-[18px] font-semibold tracking-tight">{p.nombre}</h3>
            <div class="mt-4 min-h-[3.4rem]">
              {aMedida ? (
                <p class="text-[30px] font-bold leading-none tracking-[-0.04em]">A medida</p>
              ) : gratis ? (
                <p class="text-[30px] font-bold leading-none tracking-[-0.04em]">Gratis</p>
              ) : (
                <>
                  <p class="flex items-end gap-1">
                    <span class="precio-mensual text-[30px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(p.precio!)}</span>
                    <span class="precio-anual text-[30px] font-bold leading-none tracking-[-0.04em] tabular-nums">{pesos(precioAnual(p.precio!, p.descuentoAnual))}</span>
                    <span class:list={['pb-0.5 text-[13px]', p.destacado ? 'text-white/60' : 'text-ink-3']}>/ mes</span>
                  </p>
                  <p class:list={['precio-anual mt-1.5 text-[12.5px]', p.destacado ? 'text-white/60' : 'text-ink-3']}>Pagando el año</p>
                </>
              )}
            </div>
            <p class:list={['mt-3 flex-1 text-[14.5px] leading-snug', p.destacado ? 'text-white/75' : 'text-ink-2']}>{p.descripcion}</p>
            {aMedida ? (
              <a href={enlaceWhatsapp(TEXTO_WA_EVOLUCION)} target="_blank" rel="noopener" class="boton boton-chico mt-6 w-full bg-sand text-ink hover:bg-line">Hablar con Piru</a>
            ) : (
              <a href={CREAR_TIENDA} class:list={['boton boton-chico mt-6 w-full', p.destacado ? 'boton-primario' : 'bg-sand text-ink hover:bg-line']}>
                {gratis ? 'Crear tienda gratis' : 'Empezar gratis'}
              </a>
            )}
          </article>
        )
      })}
    </div>

    <!-- Qué trae cada plan -->
    <div class="revelar mt-20">
      <h3 class="titulo-md text-center">Qué trae cada plan</h3>
      <div class="sin-barra -mx-5 mt-8 overflow-x-auto px-5 sm:mx-0 sm:px-0">
        <table class="tabla w-full min-w-[760px] border-separate border-spacing-0 text-[14.5px]">
          <thead>
            <tr>
              <th class="sticky left-0 z-10 w-[30%] bg-paper" scope="col"><span class="sr-only">Función</span></th>
              {PLANES.map((p) => (
                <th scope="col" class:list={['px-3 pb-4 text-center text-[15px] font-semibold', p.destacado && 'text-brand-deep']}>{p.nombre}</th>
              ))}
            </tr>
          </thead>
          {TABLA_PLANES.map((g) => (
            <tbody>
              <tr>
                <th colspan={PLANES.length + 1} scope="colgroup" class="sticky left-0 bg-paper pb-2 pt-8 text-left text-[12.5px] font-semibold uppercase tracking-[.09em] text-ink-3">{g.grupo}</th>
              </tr>
              {g.filas.map((f) => (
                <tr class="fila">
                  <th scope="row" class="sticky left-0 z-10 bg-paper py-3.5 pr-4 text-left font-medium text-ink">{f.nombre}</th>
                  {f.planes.map((v, i) => (
                    <td class:list={['px-3 py-3.5 text-center', PLANES[i].destacado && 'bg-brand-soft/60']}>
                      {v === true ? (
                        <Icon name="check" class="mx-auto size-[18px] text-brand" stroke={2.6} />
                      ) : v === false ? (
                        <span class="text-ink-3/50" aria-label="No incluye">—</span>
                      ) : (
                        <span class="text-[13.5px] font-medium text-ink-2">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="mt-6 text-center text-[13.5px] text-ink-3">Creás tu tienda gratis y pasás a un plan pago desde tu panel cuando lo necesites. Los avisos automáticos por WhatsApp se recargan aparte, según lo que mandes.</p>
    </div>
  </div>
</section>

<style>
  .ciclo button {
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-2);
    transition: background-color .2s, color .2s;
  }
  .ciclo button[aria-checked='true'] { background: var(--color-ink); color: #fff; }
  .planes[data-ciclo='mensual'] .precio-anual { display: none; }
  .planes[data-ciclo='anual'] .precio-mensual { display: none; }

  .tabla .fila > * { border-top: 1px solid var(--color-line); }
  .tabla .fila:hover > * { background-color: var(--color-sand); }
</style>

<script>
  const planes = document.querySelector<HTMLElement>('.planes')
  document.querySelectorAll<HTMLButtonElement>('.ciclo button').forEach((boton, _, todos) => {
    boton.addEventListener('click', () => {
      todos.forEach((b) => b.setAttribute('aria-checked', String(b === boton)))
      planes?.setAttribute('data-ciclo', boton.dataset.ciclo ?? 'mensual')
    })
  })
</script>
