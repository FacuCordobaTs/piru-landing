---
// Piru — landing. Imagenes en public/piru/ (ver carpeta piru-public).
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Piru — Tu tienda online propia, simple y sin comisiones</title>
<link rel="icon" type="image/jpeg" href="/piru/logo.jpg">
<link rel="apple-touch-icon" href="/piru/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#17130f;
  --ink-soft:#3d2f23;
  --paper:#fbf4ea;
  --paper-2:#f4e9d9;
  --card:#ffffff;
  --orange:#ff8a00;
  --orange-deep:#e67500;
  --indigo:#2c2a63;
  --muted:#8a7866;
  --line:#e7dac7;
  --black:#0a0a0a;
  --black-2:#161616;
  --maxw:1180px;
  --ease:cubic-bezier(.22,.61,.36,1);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
h1,h2,h3,h4{font-family:'Fraunces',Georgia,serif;font-weight:600;line-height:1.06;letter-spacing:-.015em;margin:0}
p{margin:0}
a{color:inherit;text-decoration:none}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-deep)}
.muted{color:var(--muted)}

/* scroll progress */
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--orange),#ff6a00);z-index:99;transition:width .08s linear}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.5em;font-weight:600;font-size:15px;border-radius:999px;padding:14px 24px;cursor:pointer;border:0;transition:transform .18s var(--ease),box-shadow .25s,background .25s,color .25s;font-family:inherit;position:relative;overflow:hidden}
.btn-primary{background:var(--orange);color:#fff;box-shadow:0 12px 34px -12px rgba(255,138,0,.75)}
.btn-primary:hover{background:var(--orange-deep);transform:translateY(-3px)}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--ink);transform:translateY(-3px)}
.btn .sh{position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-120%)}
.btn:hover .sh{transform:translateX(120%);transition:transform .7s var(--ease)}
.wa svg{width:18px;height:18px}
.wa-ghost svg{width:17px;height:17px;color:#25d366}

/* nav */
nav{position:fixed;inset:0 0 auto 0;z-index:50;backdrop-filter:blur(10px);background:rgba(251,244,234,.75);border-bottom:1px solid transparent;transition:border-color .3s,background .3s;animation:dropIn .6s var(--ease) both}
nav.scrolled{border-color:var(--line);background:rgba(251,244,234,.9)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-weight:700;font-size:22px;letter-spacing:-.02em}
.brand img{width:34px;height:34px;border-radius:9px;display:block;transition:transform .4s var(--ease)}
.brand:hover img{transform:rotate(-8deg) scale(1.06)}
.nav-links{display:flex;gap:30px;align-items:center}
.nav-links a{font-size:15px;font-weight:500;color:var(--ink-soft);position:relative}
.nav-links a:after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--orange);transition:width .3s var(--ease)}
.nav-links a:hover{color:var(--orange-deep)}
.nav-links a:hover:after{width:100%}
.nav-cta{display:flex;align-items:center;gap:10px}
@media(max-width:840px){.nav-links{display:none}}

/* mobile bottom nav */
.mnav{display:none}
@keyframes barUp{from{transform:translateY(140%);opacity:0}to{transform:none;opacity:1}}
@media(max-width:840px){
  nav{display:none}
  .mnav{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    position:fixed;left:14px;right:14px;bottom:14px;z-index:60;
    padding:7px 7px 7px 16px;
    background:rgba(251,244,234,.7);
    backdrop-filter:blur(20px) saturate(1.6);
    -webkit-backdrop-filter:blur(20px) saturate(1.6);
    border:1px solid rgba(255,255,255,.55);
    border-radius:999px;
    box-shadow:0 16px 44px -14px rgba(40,20,0,.4),inset 0 1px 0 rgba(255,255,255,.65);
    animation:barUp .6s .2s var(--ease) both;
  }
  .mnav-brand{display:flex;align-items:center;gap:9px;font-family:'Fraunces',serif;font-weight:700;font-size:19px;letter-spacing:-.02em;color:var(--ink)}
  .mnav-brand img{width:30px;height:30px;border-radius:8px;display:block}
  .mnav-actions{display:flex;align-items:center;gap:8px}
  .mnav-wa{width:42px;height:42px;flex:0 0 auto;border-radius:999px;display:grid;place-items:center;background:#fff;border:1px solid var(--line);color:#25d366}
  .mnav-wa svg{width:20px;height:20px}
  .mnav-wa:active{transform:scale(.94)}
  .mnav-btn{padding:11px 20px;font-size:14px}
}

/* hero */
.hero{position:relative;padding:130px 0 76px;overflow:hidden}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero-text{position:relative}
.hero-text:before{content:"";position:absolute;top:-160px;left:-220px;width:720px;height:720px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.26),rgba(255,138,0,0) 62%);z-index:-1;pointer-events:none;animation:breathe 9s ease-in-out infinite}
.hero h1{font-size:clamp(40px,6.2vw,74px);font-weight:600}
.hero h1 em{font-style:italic;color:var(--orange-deep);font-weight:500}
.hero h1 .l2{display:block;color:var(--ink-soft);font-weight:500;margin-top:4px}
.hero-sub{font-size:clamp(16.5px,1.9vw,19px);color:var(--ink-soft);max-width:32em;margin:24px 0 32px;line-height:1.6}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.hero-note{font-size:14.5px;color:var(--muted);margin-top:18px}
.hero-note b{color:var(--orange-deep);font-weight:600}
.hero-text>*{opacity:0;animation:upIn .8s var(--ease) forwards}
.hero-text h1{animation-delay:.08s}
.hero-text .hero-sub{animation-delay:.22s}
.hero-text .hero-cta{animation-delay:.36s}
.hero-text .hero-note{animation-delay:.48s}
.hero-stage{opacity:0;animation:popIn 1s .2s var(--ease) forwards}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:36px}.hero{padding:110px 0 44px}}
@media(max-width:840px){.hero{padding:70px 0 44px}footer{padding-bottom:104px}}

/* phone mockup */
.phone{position:relative;width:290px;border-radius:40px;background:#0d0a16;padding:10px;box-shadow:0 44px 84px -34px rgba(40,20,0,.5),0 0 0 1px rgba(0,0,0,.05)}
.phone img{display:block;width:100%;border-radius:31px}
.phone-stage{position:relative;display:flex;justify-content:center}
.parallax{will-change:transform}
@media(max-width:560px){.phone{width:250px}}

/* sections */
.sec{padding:92px 0}
.sec-head{max-width:38ch}
.sec-head.center{margin:0 auto;text-align:center}
.sec-head.wide{max-width:58ch}
.sec-head h2{font-size:clamp(30px,4.4vw,50px);margin:14px 0 0}
.sec-head .lead{font-size:17.5px;color:var(--ink-soft);margin-top:14px;line-height:1.6}
.sec-head.center .lead{margin-left:auto;margin-right:auto;max-width:48ch}

/* toggle */
.toggle{display:inline-flex;background:var(--paper-2);border:1px solid var(--line);border-radius:999px;padding:4px;gap:2px;margin-top:24px}
.toggle button{border:0;background:transparent;font-family:inherit;font-weight:600;font-size:14px;color:var(--muted);padding:9px 20px;border-radius:999px;cursor:pointer;transition:.25s var(--ease);display:flex;align-items:center;gap:7px}
.toggle button.active{background:var(--ink);color:#fff}
.toggle button.active.lightmode{background:var(--orange);color:#fff}

/* flow (showcase vertical) */
.flow{display:flex;flex-direction:column;gap:86px;margin-top:64px}
.flow-row{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:center}
.flow-row.rev .flow-phone{order:2}
.flow-phone{display:flex;justify-content:center}
.flow-phone .phone{width:264px;transition:transform .5s var(--ease)}
.flow-phone .phone:hover{transform:translateY(-6px) rotate(-1.2deg)}
.flow-text{max-width:32ch}
.step-no{font-family:'Fraunces',serif;font-size:42px;font-weight:600;color:var(--orange);line-height:1}
.flow-text h3{font-size:clamp(24px,3vw,34px);margin:6px 0 10px}
.flow-text p{font-size:16.5px;color:var(--ink-soft);line-height:1.55}
@media(max-width:880px){.flow-row{grid-template-columns:1fr;gap:24px}.flow-row.rev .flow-phone{order:0}.flow-text{margin:0 auto;text-align:center}}

/* split (amigos / alias) */
.split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.split.rev .split-text{order:2}
.split-text h2{font-size:clamp(28px,3.8vw,44px);margin-top:12px}
.split-text .lead{font-size:17.5px;color:var(--ink-soft);margin-top:14px;max-width:34ch;line-height:1.55}
.split-stage{display:flex;justify-content:center}
.split.amigos{background:linear-gradient(155deg,#34316f,#1d1b45);color:#fff;border-radius:32px;padding:56px;overflow:hidden;position:relative}
.split.amigos:before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.14),transparent 65%);top:-180px;left:-120px}
.split.amigos .eyebrow{color:#ffb454}
.split.amigos .split-text,.split.amigos .split-stage{position:relative;z-index:1}
.split.amigos .lead{color:#cfcde9}
.split.amigos .phone{box-shadow:0 50px 90px -36px rgba(0,0,0,.6)}
@media(max-width:880px){.split{grid-template-columns:1fr;gap:32px}.split.rev .split-text{order:0}.split.amigos{padding:36px 24px}}

/* OPERATIONAL CAPABILITIES (Todo lo incluido) */
.oper-grid{margin-top:46px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.oper-card{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:30px 26px;display:flex;flex-direction:column;gap:14px;transition:transform .25s var(--ease),border-color .25s,box-shadow .25s}
.oper-card:hover{transform:translateY(-4px);border-color:var(--orange);box-shadow:0 22px 44px -22px rgba(40,20,0,.3)}
.oper-card .ic-wrap{width:46px;height:46px;border-radius:13px;background:rgba(255,138,0,.12);color:var(--orange-deep);display:grid;place-items:center}
.oper-card .ic-wrap svg{width:24px;height:24px}
.oper-card h3{font-family:'Fraunces',serif;font-size:20.5px;font-weight:600;color:var(--ink)}
.oper-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.oper-card li{display:flex;align-items:flex-start;gap:9px;font-size:14px;color:var(--ink-soft);line-height:1.45}
.oper-card li .dot{flex:0 0 auto;width:6px;height:6px;border-radius:50%;background:var(--orange);margin-top:7px}
@media(max-width:980px){.oper-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.oper-grid{grid-template-columns:1fr}}

/* PRICING (Suscripción única centrada) */
.pricing-sec{position:relative}
.plan-single{
  max-width:580px;
  margin:46px auto 0;
  position:relative;
  background:var(--card);
  border:2px solid var(--orange);
  border-radius:30px;
  padding:46px 36px;
  text-align:center;
  box-shadow:0 34px 74px -34px rgba(255,138,0,.5);
  transition:transform .3s var(--ease),box-shadow .3s;
}
.plan-single:hover{
  transform:translateY(-4px);
  box-shadow:0 40px 84px -34px rgba(255,138,0,.65);
}
.plan-single .plan-badge{
  position:absolute;
  top:-14px;
  left:50%;
  transform:translateX(-50%);
  background:var(--orange);
  color:#fff;
  font-size:13px;
  font-weight:700;
  padding:6px 18px;
  border-radius:999px;
  white-space:nowrap;
  box-shadow:0 10px 24px -8px rgba(255,138,0,.8);
}
.plan-single .plan-name{font-size:15px;font-weight:600;color:var(--ink-soft);letter-spacing:.02em}
.plan-single .plan-price{
  font-family:'Fraunces',serif;
  font-weight:600;
  font-size:clamp(48px,6vw,66px);
  line-height:1;
  margin:14px 0 10px;
  color:var(--ink);
}
.plan-single .plan-price small{font-family:'Inter',sans-serif;font-size:17px;font-weight:500;color:var(--muted)}
.plan-single .plan-desc{
  font-size:15.5px;
  color:var(--ink-soft);
  max-width:44ch;
  margin:0 auto 28px;
  line-height:1.55;
}
.plan-single .btn{
  width:100%;
  max-width:360px;
  margin:0 auto;
  justify-content:center;
  font-size:16px;
  padding:15px 28px;
}
.plan-single .plan-subnote{
  font-size:13.5px;
  color:var(--muted);
  margin-top:18px;
  line-height:1.45;
}
.price-clarification{margin-top:30px;text-align:center}
.price-clarification .strong{font-family:'Fraunces',serif;font-size:clamp(18px,2.2vw,22px);font-weight:500;color:var(--ink)}
.price-clarification .strong b{color:var(--orange-deep);font-weight:600}
.price-clarification .fine{font-size:13.5px;color:var(--muted);margin-top:6px}

/* DEDICATED SECTIONS FOR PAID ADD-ONS */
.addon-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:30px;
  padding:48px 44px;
  margin-top:38px;
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:44px;
  align-items:center;
  position:relative;
  overflow:hidden;
}
.addon-card h3{font-size:clamp(26px,3.2vw,36px);margin:10px 0 12px}
.addon-price{
  display:inline-flex;
  align-items:baseline;
  gap:6px;
  font-family:'Fraunces',serif;
  font-size:30px;
  font-weight:600;
  color:var(--orange-deep);
  margin-bottom:12px;
}
.addon-price small{font-family:'Inter',sans-serif;font-size:15px;font-weight:500;color:var(--muted)}
.addon-desc{font-size:16px;color:var(--ink-soft);line-height:1.6;margin-bottom:22px}
.addon-bullets{display:flex;flex-direction:column;gap:12px;margin-bottom:26px}
.addon-bullet{display:flex;gap:12px;align-items:flex-start;font-size:14.5px;color:var(--ink-soft);line-height:1.45}
.addon-bullet .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:rgba(255,138,0,.14);color:var(--orange-deep);display:grid;place-items:center;font-size:12px;margin-top:1px}
.addon-visual{display:flex;justify-content:center;align-items:center}

/* whatsapp bubble */
.wabubble{width:100%;max-width:340px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px 18px;box-shadow:0 20px 44px -22px rgba(40,20,0,.45)}
.wabubble-top{display:flex;align-items:center;gap:11px;margin-bottom:12px}
.wabubble .av{width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid var(--line)}
.wabubble .wa-name{display:flex;align-items:center;gap:6px;font-size:14px;font-weight:700;color:var(--ink)}
.wabubble .wa-name .v{width:16px;height:16px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:10px;font-weight:700}
.wabubble .wa-msg{font-size:14px;color:var(--ink);background:#eaf6e6;border:1px solid #d6efcf;border-radius:4px 14px 14px 14px;padding:10px 14px;line-height:1.45}
.wabubble .wa-time{display:block;font-size:11px;color:var(--muted);text-align:right;margin-top:4px}

/* modulo crecimiento (dark addon card) */
.addon-card.dark{
  background:var(--black);
  color:#ece7e1;
  border-color:rgba(255,255,255,.1);
}
.addon-card.dark:before{
  content:"";
  position:absolute;
  width:560px;
  height:560px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(255,138,0,.16),transparent 65%);
  top:-180px;
  right:-100px;
  z-index:0;
}
.addon-card.dark > *{position:relative;z-index:1}
.addon-card.dark .fox-wm{position:absolute;pointer-events:none;opacity:.06;width:280px;bottom:-50px;right:-50px;left:auto;z-index:0}
.addon-card.dark h3{color:#fff}
.addon-card.dark .addon-price{color:#ffb454}
.addon-card.dark .addon-desc{color:#cfc5b8}
.addon-card.dark .addon-bullet{color:#dfd7cc}
.addon-card.dark .addon-bullet .ck{background:rgba(255,138,0,.22);color:var(--orange)}
.addon-card.dark .btn-ghost{color:#fff;border-color:rgba(255,255,255,.28)}
.addon-card.dark .btn-ghost:hover{border-color:var(--orange);color:#fff}

/* visual panel inside crecimiento */
.engine-mock{width:100%;max-width:360px;background:var(--black-2);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:24px;box-shadow:0 24px 50px -20px rgba(0,0,0,.7)}
.engine-mock-head{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:18px;color:#fff}
.engine-mock-head .spark{width:28px;height:28px;border-radius:8px;background:var(--orange);color:#fff;display:grid;place-items:center;font-size:15px}
.engine-mock-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}
.engine-stat{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:12px}
.engine-stat small{display:block;font-size:11px;color:#9e9282;text-transform:uppercase;letter-spacing:.04em}
.engine-stat b{font-size:18px;color:#ffb454;font-family:'Fraunces',serif;display:block;margin-top:2px}
.engine-mock-note{font-size:12.5px;color:#b2a696;line-height:1.45;border-top:1px solid rgba(255,255,255,.08);padding-top:12px}
.engine-mock-note b{color:#ffb454}

@media(max-width:880px){
  .addon-card{grid-template-columns:1fr;padding:34px 24px;gap:30px}
}

/* share flyer button */
.share-row{text-align:center;margin-top:28px}
#shareFlyer[disabled]{opacity:.7;cursor:progress}

/* flyer descargable (fuera de pantalla) */
.flyer-wrap{position:fixed;left:-99999px;top:0;pointer-events:none;z-index:-1}
.flyer{width:1300px;background:linear-gradient(160deg,#fbf4ea,#f4e9d9);padding:64px;font-family:'Inter',system-ui,sans-serif;color:var(--ink)}
.flyer-head{display:flex;align-items:center;gap:16px}
.flyer-head img{width:64px;height:64px;border-radius:16px;display:block}
.flyer-head .fname{font-family:'Fraunces',serif;font-weight:700;font-size:42px;letter-spacing:-.02em}
.flyer h2{font-family:'Fraunces',serif;font-size:52px;font-weight:600;letter-spacing:-.015em;margin:24px 0 8px;color:#000}
.flyer .flyer-sub{font-size:21px;color:var(--ink-soft);margin-bottom:38px;max-width:44ch}
.flyer-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px}
.flyer-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:30px 24px;display:flex;flex-direction:column}
.flyer-card.feat{border:2px solid var(--orange);box-shadow:0 10px 30px -10px rgba(255,138,0,.3)}
.flyer-card-tag{font-size:12px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--orange-deep);margin-bottom:6px}
.flyer-card h3{font-size:24px;margin-bottom:8px}
.flyer-card .fprice{font-family:'Fraunces',serif;font-size:36px;font-weight:600;color:var(--ink);margin-bottom:12px}
.flyer-card .fprice small{font-size:16px;color:var(--muted);font-family:'Inter'}
.flyer-card p{font-size:14.5px;color:var(--ink-soft);line-height:1.5}
.flyer-foot{margin-top:44px;display:flex;justify-content:space-between;align-items:center;gap:24px;border-top:1px solid var(--line);padding-top:26px;font-size:20px;color:var(--ink-soft)}
.flyer-foot b{color:var(--orange-deep);font-weight:600}

/* agency / onboarding support */
.agency{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;background:var(--paper-2);border:1px solid var(--line);border-radius:32px;padding:56px}
.agency h2{font-size:clamp(28px,3.8vw,44px);margin-top:12px}
.agency .lead{font-size:17.5px;color:var(--ink-soft);margin-top:14px;line-height:1.55}
.agency-steps{display:flex;flex-direction:column;gap:14px;margin-top:24px}
.agency-steps div{display:flex;gap:14px;align-items:center;font-weight:500;color:var(--ink-soft);font-size:15.5px}
.agency-steps .n{flex:0 0 auto;width:28px;height:28px;border-radius:50%;background:var(--orange);color:#fff;display:grid;place-items:center;font-size:13px;font-weight:700}
.agency-card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:32px;box-shadow:0 26px 54px -28px rgba(40,20,0,.3)}
.agency-card .wa-num{font-family:'Fraunces',serif;font-size:26px;font-weight:600;margin:6px 0 18px;color:var(--ink)}
@media(max-width:880px){.agency{grid-template-columns:1fr;padding:34px 22px}}

/* footer */
footer{background:#ff7200;color:#fff;padding:54px 24px 44px}
.foot-in{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center}
.foot-brand{display:flex;align-items:center;gap:11px;color:#fff;font-family:'Fraunces',serif;font-weight:700;font-size:21px}
.foot-brand img{width:34px;height:34px}
.foot-links{display:flex;gap:24px;font-size:14px;flex-wrap:wrap}
.foot-links a{color:rgba(255,255,255,.92)}
.foot-links a:hover{color:#0a0a0a}
.foot-fine{margin-top:24px;font-size:13px;color:rgba(255,255,255,.82);border-top:1px solid rgba(255,255,255,.28);padding-top:18px}

/* reveal animations */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .75s var(--ease),transform .75s var(--ease);transition-delay:var(--d,0s)}
.reveal[data-anim="left"]{transform:translateX(-40px)}
.reveal[data-anim="right"]{transform:translateX(40px)}
.reveal[data-anim="scale"]{transform:scale(.94)}
.reveal.in{opacity:1;transform:none}
@keyframes upIn{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes popIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}
@keyframes dropIn{from{transform:translateY(-100%)}to{transform:none}}
@keyframes breathe{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
@media(prefers-reduced-motion:reduce){*{animation:none!important}.reveal{opacity:1;transform:none;transition:none}.btn:hover,.flow-phone .phone:hover{transform:none}}
</style>
</head>
