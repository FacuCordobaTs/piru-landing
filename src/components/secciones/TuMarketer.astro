---
import Icon from '../ui/Icon.astro'
import Escala from '../marcos/Escala.astro'
import Ventana from '../marcos/Ventana.astro'
import Telefono from '../marcos/Telefono.astro'
import Campanas from '../replicas/marketers/Campanas.astro'
import CampanasMovil from '../replicas/marketers/CampanasMovil.astro'
import type { NombreIcono } from '../ui/lucide'
import { LOCAL } from '../../data/demo'
import { MARKETER } from '../../data/marketers'

/**
 * Si el local le paga a alguien por su marketing, esa persona lo maneja desde su propia app
 * (marketing.piru.app): el dueño le da acceso con su código y se lo saca cuando quiere. Lo que puede
 * y no puede es la lista de backend/src/lib/marketer-permisos.ts, contada como en la guía de la app
 * (marketers/src/components/guia/Contenido.tsx, `PuedeNoPuede`).
 */
const pasos: { icono: NombreIcono; titulo: string; texto: string }[] = [
  { icono: 'key-round', titulo: 'Le pedís su código', texto: 'Tu marketer, tu community manager o tu agencia te lo pasa.' },
  { icono: 'settings', titulo: 'Lo cargás en tu panel', texto: 'En Ajustes → Tu marketer. Listo: ya tiene acceso.' },
  { icono: 'megaphone', titulo: 'Trabaja desde su app', texto: 'Campañas, clientes, puntos y mensajes, desde marketing.piru.app.' },
]
const puede = ['Campañas, links y cupones', 'Tu base de clientes', 'El club de puntos', 'La recompra y los días flojos']
const noPuede = ['Precios ni menú', 'Pedidos ni cobros', 'La configuración del local', 'Borrar clientes o pedidos']
---

<section id="tu-marketer" data-nav-oscuro class="relative overflow-hidden bg-night py-24 text-white/70 sm:py-32">
  <div class="brillo pointer-events-none absolute inset-0" aria-hidden="true" />

  <div class="contenedor relative">
    <div class="revelar max-w-3xl">
      <p class="antetitulo text-brand">Si trabajás con un marketer</p>
      <h2 class="titulo-lg mt-4 text-white">¿Le pagás a alguien por tu marketing? Que lo haga desde su propia app.</h2>
      <p class="bajada mt-5 max-w-2xl text-white/65">Tu marketer entra a su app de Piru y maneja el marketing de tu local: tus campañas, tus clientes, tus puntos y tus mensajes. Vos le das acceso con su código y se lo sacás cuando quieras.</p>
    </div>

    <ol class="mt-12 grid gap-3 lg:grid-cols-3 lg:gap-5">
      {pasos.map((p, i) => (
        <li class="revelar relative flex gap-4 rounded-[24px] bg-white/[.05] p-5 ring-1 ring-white/10 sm:p-6" style={`--retraso:${i * 80}ms`}>
          <span class="relative grid size-11 shrink-0 place-items-center rounded-2xl bg-white/[.08] text-brand">
            <Icon name={p.icono} class="size-5" />
            <span class="absolute -right-1.5 -top-1.5 grid size-5 place-items-center rounded-full bg-brand text-[11px] font-bold text-white">{i + 1}</span>
          </span>
          <div>
            <p class="text-[17px] font-semibold text-white">{p.titulo}</p>
            <p class="mt-1 text-[14.5px] leading-relaxed">{p.texto}</p>
          </div>
          {i < pasos.length - 1 && (
            <span class="absolute -right-[18px] top-1/2 z-10 hidden size-7 -translate-y-1/2 place-items-center rounded-full bg-brand text-white shadow-[0_0_0_4px_var(--color-night)] lg:grid" aria-hidden="true"><Icon name="arrow-right" class="size-4" stroke={2.4} /></span>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
      <div class="revelar">
        <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-1">
          <div class="rounded-[22px] bg-emerald-400/[.08] p-4 ring-1 ring-emerald-300/20 sm:p-6">
            <p class="flex items-center gap-2 text-[15px] font-semibold text-white sm:text-[16px]"><Icon name="check" class="size-[18px] text-emerald-300" stroke={2.6} />Puede</p>
            <ul class="mt-3 space-y-2">
              {puede.map((t) => <li class="flex gap-2 text-[14px] leading-snug sm:gap-2.5 sm:text-[15px]"><span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-emerald-300" />{t}</li>)}
            </ul>
          </div>
          <div class="rounded-[22px] bg-rose-400/[.07] p-4 ring-1 ring-rose-300/20 sm:p-6">
            <p class="flex items-center gap-2 text-[15px] font-semibold text-white sm:text-[16px]"><Icon name="lock" class="size-[17px] text-rose-300" />No puede tocar</p>
            <ul class="mt-3 space-y-2">
              {noPuede.map((t) => <li class="flex gap-2 text-[14px] leading-snug sm:gap-2.5 sm:text-[15px]"><span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-rose-300" />{t}</li>)}
            </ul>
          </div>
        </div>
        <p class="mt-4 flex gap-2.5 text-[14px] leading-relaxed text-white/55"><Icon name="message-circle" class="mt-0.5 size-4 shrink-0 text-wa" />Los mensajes siempre salen de tu WhatsApp: los manda tu marketer si lo tiene vinculado, o los mandás vos.</p>
      </div>

      <figure class="revelar" style="--retraso:120ms">
        <div class="mx-auto w-[min(74%,300px)] drop-shadow-[0_30px_60px_rgb(0_0_0/.6)] md:hidden">
          <Escala ancho={412} alto={866} etiqueta={`La app de ${MARKETER.nombre}, tu marketer: las campañas de ${LOCAL.nombre} ordenadas por ventas cobradas`}>
            <Telefono><CampanasMovil /></Telefono>
          </Escala>
        </div>
        <div class="hidden overflow-hidden rounded-[18px] shadow-[0_40px_90px_-30px_rgb(0_0_0/.8)] md:block">
          <Escala ancho={1280} alto={760} etiqueta={`La app de ${MARKETER.nombre}, tu marketer, en marketing.piru.app: el ranking de links de ${LOCAL.nombre} por ventas cobradas y la hoja para crear el link de una historia`}>
            <Ventana ancho={1280} alto={760} url="marketing.piru.app">
              <Campanas />
            </Ventana>
          </Escala>
        </div>
        <figcaption class="mt-4 text-center text-[13.5px] text-white/50">Así ve tu local tu marketer, en su app: {MARKETER.nombre} con {LOCAL.nombre}.</figcaption>
      </figure>
    </div>

    <div class="revelar mt-10 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2.5 text-[15.5px] text-white/80"><Icon name="badge-check" class="size-5 text-emerald-300" />Tu precio no cambia, y vos seguís viendo todo desde tu app.</p>
      <a href="/marketers" class="inline-flex items-center gap-2 text-[15px] font-semibold text-brand hover:underline hover:underline-offset-4">¿Sos marketer? Mirá cómo funciona para vos<Icon name="arrow-right" class="size-4" /></a>
    </div>
  </div>
</section>

<style>
  .brillo {
    background:
      radial-gradient(50rem 26rem at 85% 0%, rgb(255 122 0 / .14), transparent 70%),
      radial-gradient(40rem 30rem at 0% 90%, rgb(255 122 0 / .07), transparent 70%);
  }
</style>
