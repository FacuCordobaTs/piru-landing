---
import Base from '../layouts/Base.astro'
import Hero from '../components/secciones/Hero.astro'
import Locales from '../components/secciones/Locales.astro'
import Circuito from '../components/secciones/Circuito.astro'
import ComoFunciona from '../components/secciones/ComoFunciona.astro'
import Marketing from '../components/secciones/Marketing.astro'
import TuMarketer from '../components/secciones/TuMarketer.astro'
import Tienda from '../components/secciones/Tienda.astro'
import Panel from '../components/secciones/Panel.astro'
import Precios from '../components/secciones/Precios.astro'
import Empezar from '../components/secciones/Empezar.astro'
import Preguntas from '../components/secciones/Preguntas.astro'
import CtaFinal from '../components/secciones/CtaFinal.astro'

/**
 * La home le habla al dueño del local: su tienda propia, donde le piden directo y sin comisión, y el
 * marketing para conseguir clientes nuevos y que vuelvan. Primero las dos ideas juntas (portada y
 * circuito), después cada una en detalle y, al final, lo de siempre: precios, cómo empezar y
 * preguntas. Los marketers tienen su página en /marketers; los links que comparten, /locales?ref=…,
 * llegan acá con el código (pages/locales.astro y layouts/Base.astro).
 */
---

<Base
  pagina="locales"
  canonical="/"
  titulo="Piru · Tu tienda online sin comisiones, y el marketing para que tus clientes vuelvan"
  descripcion="La tienda online y el marketing de tu local gastronómico. Tus clientes piden directo desde el celular, el pedido te llega a tu WhatsApp y cobrás el 100%. Y Piru te ayuda a conseguir clientes nuevos y a que vuelvan a pedir. Precio fijo, sin comisión por venta."
>
  <Hero />
  <Locales />
  <Circuito />
  <ComoFunciona />
  <Marketing />
  <TuMarketer />
  <Tienda />
  <Panel />
  <Precios />
  <Empezar />
  <Preguntas />
  <CtaFinal />
</Base>
